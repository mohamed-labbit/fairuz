{
  "name": "fairuz-language",
  "displayName": "Fairuz Language Support",
  "description": "Syntax highlighting and RTL editor for the Fairuz Arabic-syntax language",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:fairuz",
    "onCustomEditor:fairuz.rtlEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fairuz",
        "aliases": ["Fairuz", "fairuz"],
        "extensions": [".fa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fairuz",
        "scopeName": "source.fairuz",
        "path": "./syntaxes/fairuz.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "fairuz.rtlEditor",
        "displayName": "Fairuz RTL Editor",
        "selector": [{ "filenamePattern": "*.fa" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "fairuz.openRtlEditor",
        "title": "Fairuz: Open in RTL Editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ./scripts/copy-monaco.js",
    "package": "npm run vscode:prepublish && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "monaco-editor": "^0.52.0"
  }
}