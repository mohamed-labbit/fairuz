{
  "name": "fairuz-language",
  "displayName": "Fairuz Language Support",
  "description": "Syntax highlighting and RTL editor for the Fairuz Arabic-syntax language",
  "version": "0.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamed-labbit/fairuz.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "language-configuration.json",
    "media/editor.js",
    "media/editor.css",
    "src/**",
    "syntaxes/**"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:fairuz",
    "onCustomEditor:fairuz.rtlEditor"
  ],
  "contributes": {
    "configuration": {
      "title": "Fairuz",
      "properties": {
        "fairuz.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Fairuz executable used for AST semantic highlighting. Empty searches the workspace development build, then PATH."
        }
      }
    },
    "languages": [
      {
        "id": "fairuz",
        "aliases": [
          "Fairuz",
          "fairuz"
        ],
        "extensions": [
          ".fa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fairuz",
        "scopeName": "source.fairuz",
        "path": "./syntaxes/fairuz.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "fairuz.rtlEditor",
        "displayName": "Fairuz RTL Editor",
        "selector": [
          {
            "filenamePattern": "*.fa"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "fairuz.openRtlEditor",
        "title": "Fairuz: Open in RTL Editor"
      },
      {
        "command": "fairuz.undo",
        "title": "Fairuz: Undo",
        "enablement": "activeCustomEditorId == 'fairuz.rtlEditor'"
      },
      {
        "command": "fairuz.redo",
        "title": "Fairuz: Redo",
        "enablement": "activeCustomEditorId == 'fairuz.rtlEditor'"
      }
    ],
    "keybindings": [
      {
        "command": "fairuz.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'fairuz.rtlEditor'"
      },
      {
        "command": "fairuz.redo",
        "key": "ctrl+y",
        "mac": "shift+cmd+z",
        "when": "activeCustomEditorId == 'fairuz.rtlEditor'"
      },
      {
        "command": "fairuz.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == 'fairuz.rtlEditor'"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "fairuz.undo",
          "when": "webviewId == 'fairuz.rtlEditor'",
          "group": "1_modification@1"
        },
        {
          "command": "fairuz.redo",
          "when": "webviewId == 'fairuz.rtlEditor'",
          "group": "1_modification@2"
        }
      ]
    }
  },
  "scripts": {
    "build:webview": "node ./scripts/build_editor.js",
    "vscode:prepublish": "npm run build:webview",
    "package": "npm run vscode:prepublish && vsce package"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@vscode/vsce": "^3.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
