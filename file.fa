# ملف.fa — تصميم نوع "ملف" (File) على طراز std::fstream
#
# هذا تصميم فقط، لا كود تنفيذي حقيقي: افتح() في الـVM حاليًا لا تُعيد
# مقبضًا (handle) صالحًا للاستخدام من فيروز — لا توجد قيمة Fa_Value
# يمكنها حمل FILE*، ولا اقرا/اكتب_ملف/اغلق كدوال أصلية بعد.
# لذلك هذا الملف يوثّق الواجهة والسلوك المرجوّين، مبنيّين على الصياغة
# الحالية للنوع (نوع/بداية/هذا) تمامًا كما يفهمها المحلّل والمترجم اليوم،
# مع تعليقات توضّح أين يلزم دعم أصلي (native) غير موجود بعد.

نوع ملف:
    # الحقول (تُجمع تلقائيًا من أول تعيين على هذا.<حقل> داخل بداية)
    # .المسار      : سلسلة  — مسار الملف على القرص
    # .الوضع       : سلسلة  — "قراءة" | "كتابة" | "اضافة"
    # .مفتوح       : منطقي  — هل المقبض حاليًا صالح للاستخدام
    # .المقبض      : (مرجعي) — سيحمل مقبض FILE* حين يوجد نوع قيمة أصلي لذلك

    دالة بداية(المسار، الوضع):
        هذا.المسار := المسار
        هذا.الوضع := الوضع
        هذا.مفتوح := خطا
        هذا.المقبض := عدم

    دالة فتح():
        اذا هذا.مفتوح:
            ارجع صحيح
        هذا.المقبض := افتح(هذا.المسار، هذا.الوضع)
        اذا هذا.المقبض = عدم:
            هذا.مفتوح := خطا
            ارجع خطا
        هذا.مفتوح := صحيح
        ارجع صحيح

    # قراءة محتوى الملف كاملاً كسلسلة نصية.
    دالة اقرا_الكل():
        اذا ليس هذا.مفتوح:
            ارجع عدم

        ارجع اقرا(هذا.المقبض)

    # قراءة سطر واحد فقط، أو عدم عند الوصول لنهاية الملف.
    دالة اقرا_سطر():
        اذا ليس هذا.مفتوح:
            ارجع عدم

        # NOTE: يحتاج إلى اقرا_سطر(المقبض)
        ارجع اقرا_سطر(هذا.المقبض)

    # كتابة نص في الملف (تستبدل المحتوى إذا كان الوضع "كتابة").
    دالة اكتب_نص(نص):
        اذا ليس هذا.مفتوح:
            ارجع خطا

        # NOTE: يحتاج إلى اكتب_ملف(المقبض، نص) تُعيد صحيح/خطا
        ارجع اكتب_ملف(هذا.المقبض، نص)

    # إضافة نص في آخر الملف بلا حاجة لإعادة فتحه بوضع "اضافة".
    دالة اضف_نص(نص):
        اذا ليس هذا.مفتوح:
            ارجع خطا

        # NOTE: يحتاج إلى اضف_ملف(المقبض، نص)
        ارجع اضف_ملف(هذا.المقبض، نص)

    # اغلاق الملف وتحرير المقبض.
    دالة اغلق():
        اذا ليس هذا.مفتوح:
            ارجع صحيح

        # NOTE: يحتاج إلى اغلق(المقبض) — استدعاء fclose على المقبض
        اغلق(هذا.المقبض)
        .مفتوح := خطا
        .المقبض := عدم
        ارجع صحيح

    # هل الملف مفتوح حاليًا؟
    دالة يعمل():
        ارجع هذا.مفتوح


# ============================================================
# مثال استخدام مرجوّ (لن يعمل فعليًا إلا بعد إضافة الدوال الأصلية
# المذكورة أعلاه: افتح المُصلَح، اقرا، اقرا_سطر، اكتب_ملف، اضف_ملف، اغلق)
# ============================================================

سجل := ملف("stuff.txt", "اضف")

اذا سجل.فتح():
    ن := سجل.اضف_نص("بدأ التشغيل\n")
    اذا ن:
        اكتب("تم الكتابة في السجل")
    غيره:
        اكتب("فشلنا")
    سجل.اغلق()
غيره:
    اكتب("فشل فتح الملف")
