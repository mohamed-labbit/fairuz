# SQLite نفسه طبقة C؛ إدارة الاتصال والمعاملات والاستعلامات في فيروز.

نوع قاعدة_SQLite:
    دالة بداية(المسار، الخيارات):
        هذا.المسار := المسار
        هذا.المقبض := __SQL_افتح(المسار، الخيارات)
        اذا هذا.المقبض = عدم:
            عطل("تعذر فتح قاعدة SQLite: " + المسار)
        هذا.داخل_معاملة := خطا

    دالة نفذ(العبارة، المعاملات):
        ارجع __SQL_نفذ(هذا.المقبض، العبارة، المعاملات)

    دالة استعلم(العبارة، المعاملات):
        ارجع __SQL_استعلم(هذا.المقبض، العبارة، المعاملات)

    دالة واحد(العبارة، المعاملات):
        الصفوف := هذا.استعلم(العبارة، المعاملات)
        اذا طول(الصفوف) = 0:
            ارجع عدم
        ارجع الصفوف[0]

    دالة ابدأ():
        اذا هذا.داخل_معاملة:
            عطل("معاملة SQLite متداخلة غير مدعومة")
        هذا.نفذ("BEGIN"، قائمة())
        هذا.داخل_معاملة := صحيح

    دالة ثبت():
        اذا ليس هذا.داخل_معاملة:
            ارجع خطا
        هذا.نفذ("COMMIT"، قائمة())
        هذا.داخل_معاملة := خطا
        ارجع صحيح

    دالة تراجع():
        اذا ليس هذا.داخل_معاملة:
            ارجع خطا
        هذا.نفذ("ROLLBACK"، قائمة())
        هذا.داخل_معاملة := خطا
        ارجع صحيح

    دالة اغلق():
        اذا هذا.داخل_معاملة:
            هذا.تراجع()
        ارجع __SQL_اغلق(هذا.المقبض)

دالة مع_قاعدة(المسار، الخيارات، الدالة):
    القاعدة := قاعدة_SQLite(المسار، الخيارات)
    القيمة := الدالة(القاعدة)
    القاعدة.اغلق()
    ارجع القيمة
