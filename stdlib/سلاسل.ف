# تركيب السلاسل في فيروز فوق بدائيات الذاكرة الأصلية.

دالة يبدا_ب(النص، السابقة):
    طول_السابقة := طول(السابقة)
    اذا طول_السابقة > طول(النص):
        ارجع خطا
    ارجع جزء(النص، 0، طول_السابقة) = السابقة

دالة ينتهي_ب(النص، اللاحقة):
    طول_اللاحقة := طول(اللاحقة)
    طول_النص := طول(النص)
    اذا طول_اللاحقة > طول_النص:
        ارجع خطا
    ارجع جزء(النص، طول_النص - طول_اللاحقة، طول_النص) = اللاحقة

دالة كرر_نص(النص، العدد):
    اذا العدد < 0:
        عطل("عدد تكرار النص لا يمكن أن يكون سالباً")
    الناتج := ""
    فهرس := 0
    طالما فهرس < العدد:
        الناتج += النص
        فهرس += 1
    ارجع الناتج

دالة استبدل_الكل(النص، القديم، الجديد):
    اذا طول(القديم) = 0:
        ارجع النص

    الناتج := ""
    فهرس := 0
    طول_النص := طول(النص)
    طول_القديم := طول(القديم)
    طالما فهرس < طول_النص:
        اذا فهرس + طول_القديم <= طول_النص و جزء(النص، فهرس، فهرس + طول_القديم) = القديم:
            الناتج += الجديد
            فهرس += طول_القديم
        غيره:
            الناتج += جزء(النص، فهرس، فهرس + 1)
            فهرس += 1
    ارجع الناتج

دالة اسطر(النص):
    ارجع اقسم(النص، "\n")

دالة كلمات(النص):
    الاجزاء := اقسم(قص(النص)، " ")
    الناتج := قائمة()
    لكل جزء_نص في الاجزاء:
        اذا طول(جزء_نص) > 0:
            اضف(الناتج، جزء_نص)
    ارجع الناتج

دالة عدد_مرات_النص(النص، المطلوب):
    اذا طول(المطلوب) = 0:
        ارجع 0
    الناتج := 0
    فهرس := 0
    حد := طول(النص) - طول(المطلوب)
    طالما فهرس <= حد:
        اذا جزء(النص، فهرس، فهرس + طول(المطلوب)) = المطلوب:
            الناتج += 1
            فهرس += طول(المطلوب)
        غيره:
            فهرس += 1
    ارجع الناتج

دالة اعكس_نص(النص):
    الناتج := ""
    فهرس := طول(النص) - 1
    طالما فهرس >= 0:
        الناتج += جزء(النص، فهرس، فهرس + 1)
        فهرس -= 1
    ارجع الناتج

دالة ازل_سابقة(النص، السابقة):
    اذا يبدا_ب(النص، السابقة):
        ارجع جزء(النص، طول(السابقة)، طول(النص))
    ارجع النص

دالة ازل_لاحقة(النص، اللاحقة):
    اذا ينتهي_ب(النص، اللاحقة):
        ارجع جزء(النص، 0، طول(النص) - طول(اللاحقة))
    ارجع النص

دالة حشو_يمين(النص، العرض، الحرف):
    اذا طول(الحرف) != 1:
        عطل("حرف الحشو يجب أن يكون حرفاً واحداً")
    الناقص := العرض - طول(النص)
    اذا الناقص <= 0:
        ارجع النص
    ارجع النص + كرر_نص(الحرف، الناقص)

دالة حشو_يسار(النص، العرض، الحرف):
    اذا طول(الحرف) != 1:
        عطل("حرف الحشو يجب أن يكون حرفاً واحداً")
    الناقص := العرض - طول(النص)
    اذا الناقص <= 0:
        ارجع النص
    ارجع كرر_نص(الحرف، الناقص) + النص

دالة وسط_نص(النص، العرض، الحرف):
    اذا طول(الحرف) != 1:
        عطل("حرف الحشو يجب أن يكون حرفاً واحداً")
    الناقص := العرض - طول(النص)
    اذا الناقص <= 0:
        ارجع النص
    يسار := ادنى(الناقص / 2)
    يمين := الناقص - يسار
    ارجع كرر_نص(الحرف، يسار) + النص + كرر_نص(الحرف، يمين)

دالة هل_مسافة(الحرف):
    ارجع الحرف = " " او الحرف = "\t" او الحرف = "\n" او الحرف = "\r"

دالة هل_ارقام(النص):
    اذا طول(النص) = 0:
        ارجع خطا
    الارقام := "0123456789٠١٢٣٤٥٦٧٨٩"
    فهرس := 0
    طالما فهرس < طول(النص):
        اذا ليس يحتوي(الارقام، جزء(النص، فهرس، فهرس + 1)):
            ارجع خطا
        فهرس += 1
    ارجع صحيح

دالة موضع_نص(النص، المطلوب، البداية):
    اذا طول(المطلوب) = 0:
        ارجع اصغر(اكبر(0، البداية)، طول(النص))
    فهرس := اكبر(0، البداية)
    حد := طول(النص) - طول(المطلوب)
    طالما فهرس <= حد:
        اذا جزء(النص، فهرس، فهرس + طول(المطلوب)) = المطلوب:
            ارجع فهرس
        فهرس += 1
    ارجع -1

دالة اخر_موضع_نص(النص، المطلوب):
    اذا طول(المطلوب) = 0:
        ارجع طول(النص)
    فهرس := طول(النص) - طول(المطلوب)
    طالما فهرس >= 0:
        اذا جزء(النص، فهرس، فهرس + طول(المطلوب)) = المطلوب:
            ارجع فهرس
        فهرس -= 1
    ارجع -1

دالة افصل_مرة(النص، الفاصل):
    الموضع := موضع_نص(النص، الفاصل، 0)
    اذا الموضع = -1:
        ارجع [النص، ""، ""]
    ارجع [
        جزء(النص، 0، الموضع)،
        الفاصل،
        جزء(النص، الموضع + طول(الفاصل)، طول(النص))
    ]

دالة افصل_اخيرا(النص، الفاصل):
    الموضع := اخر_موضع_نص(النص، الفاصل)
    اذا الموضع = -1:
        ارجع [""، ""، النص]
    ارجع [
        جزء(النص، 0، الموضع)،
        الفاصل،
        جزء(النص، الموضع + طول(الفاصل)، طول(النص))
    ]

دالة اختصر_مسافات(النص):
    ارجع اجمع(كلمات(النص)، " ")
