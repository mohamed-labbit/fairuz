# واجهة الملفات عالية المستوى. وحدها البدائيات ذات بادئة __ تلمس FILE*.

من result استورد نجاح
من result استورد فشل
من result استورد بعض
من result استورد لاشيء
# __ملف_افتح، __ملف_اقرا، __ملف_اقرا_الكل، __ملف_اقرا_سطر
# __ملف_اكتب، __ملف_اضف، __ملف_ادفع، __ملف_اغلق
# __ملف_موضع، __ملف_انتقل، __ملف_اقتطع، __ملف_معلومات

نوع ملف:
    دالة بداية(المسار، الوضع):
        هذا.المسار := المسار
        هذا.الوضع := الوضع
        هذا.مفتوح := خطا
        هذا.المقبض := عدم

    دالة فتح():
        اذا هذا.مفتوح:
            ارجع صحيح
        هذا.المقبض := __ملف_افتح(هذا.المسار، هذا.الوضع)
        اذا هذا.المقبض = عدم:
            ارجع خطا
        هذا.مفتوح := صحيح
        ارجع صحيح

    دالة اقرا_الكل():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_اقرا_الكل(هذا.المقبض)

    دالة اقرا(العدد):
        اذا ليس هذا.مفتوح:
            ارجع عدم
        اذا العدد < 0:
            عطل("عدد بايتات القراءة لا يمكن أن يكون سالباً")
        ارجع __ملف_اقرا(هذا.المقبض، العدد)

    دالة اقرا_سطر():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_اقرا_سطر(هذا.المقبض)

    دالة اكتب_نص(النص):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اكتب(هذا.المقبض، النص)

    دالة اكتب_سطر(النص):
        ارجع هذا.اكتب_نص(سلسلة(النص) + "\n")

    دالة اضف_نص(النص):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اضف(هذا.المقبض، النص)

    دالة ادفع():
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_ادفع(هذا.المقبض)

    دالة موضع():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_موضع(هذا.المقبض)

    دالة انتقل(الموضع، المرجع):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_انتقل(هذا.المقبض، الموضع، المرجع)

    دالة اقتطع(الحجم):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اقتطع(هذا.المقبض، الحجم)

    دالة معلومات():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_معلومات(هذا.المقبض)

    دالة اغلق():
        اذا ليس هذا.مفتوح:
            ارجع صحيح
        نجح := __ملف_اغلق(هذا.المقبض)
        اذا نجح:
            هذا.مفتوح := خطا
            هذا.المقبض := عدم
        ارجع نجح

    دالة يعمل():
        ارجع هذا.مفتوح

دالة اقرا_نص_ملف(المسار):
    المورد := ملف(المسار، "قراءة")
    اذا ليس المورد.فتح():
        ارجع عدم
    النص := المورد.اقرا_الكل()
    المورد.اغلق()
    ارجع النص

دالة اكتب_نص_ملف(المسار، النص):
    المورد := ملف(المسار، "كتابة")
    اذا ليس المورد.فتح():
        ارجع خطا
    نجح := المورد.اكتب_نص(النص)
    اذا نجح:
        نجح := المورد.ادفع()
    المورد.اغلق()
    ارجع نجح

دالة اضف_نص_ملف(المسار، النص):
    المورد := ملف(المسار، "اضافة")
    اذا ليس المورد.فتح():
        ارجع خطا
    نجح := المورد.اضف_نص(النص)
    اذا نجح:
        نجح := المورد.ادفع()
    المورد.اغلق()
    ارجع نجح

دالة انسخ_ملف(المصدر، الوجهة):
    المحتوى := اقرا_نص_ملف(المصدر)
    اذا المحتوى = عدم:
        ارجع خطا
    ارجع اكتب_نص_ملف(الوجهة، المحتوى)

دالة اقرا_اسطر_ملف(المسار):
    المورد := ملف(المسار، "قراءة")
    اذا ليس المورد.فتح():
        ارجع عدم
    الناتج := قائمة()
    طالما صحيح:
        السطر := المورد.اقرا_سطر()
        اذا السطر = عدم:
            المورد.اغلق()
            ارجع الناتج
        اضف(الناتج، السطر)

دالة مع_ملف(المسار، الوضع، الدالة):
    المورد := ملف(المسار، الوضع)
    اذا ليس المورد.فتح():
        ارجع فشل("تعذر فتح الملف: " + المسار)
    القيمة := الدالة(المورد)
    اذا ليس المورد.اغلق():
        ارجع فشل("تعذر إغلاق الملف: " + المسار)
    ارجع نجاح(القيمة)

دالة اكتب_ذريا(المسار، النص):
    # الإنشاء والـfsync والاستبدال الذري عملية نظام واحدة في الطبقة الأصلية.
    ارجع __ملف_اكتب_ذريا(المسار، النص)

نوع مكرر_اسطر:
    دالة بداية(الملف):
        هذا.الملف := الملف

    دالة التالي():
        السطر := هذا.الملف.اقرا_سطر()
        اذا السطر = عدم:
            ارجع لاشيء()
        ارجع بعض(السطر)
