# تراكيب عالية المستوى مبنية فوق القائمة والقاموس.

من collections استورد اخرج_اخير
من collections استورد اسقط
من collections استورد رتب_ب
من collections استورد خذ
من collections استورد ابحث
من collections استورد احذف_عند
من dicts استورد قاموس_خذ
من dicts استورد قاموس_عناصر
من result استورد بعض
من result استورد لاشيء

نوع مكدس:
    دالة بداية():
        هذا.العناصر := قائمة()

    دالة ادفع(القيمة):
        اضف(هذا.العناصر، القيمة)
        ارجع هذا

    دالة اسحب():
        ارجع اخرج_اخير(هذا.العناصر)

    دالة قمة():
        اذا طول(هذا.العناصر) = 0:
            ارجع عدم
        ارجع هذا.العناصر[طول(هذا.العناصر) - 1]

    دالة فارغ():
        ارجع طول(هذا.العناصر) = 0

    دالة الحجم():
        ارجع طول(هذا.العناصر)

نوع طابور:
    دالة بداية():
        هذا.العناصر := قائمة()
        هذا.البداية := 0

    دالة اضف_اخر(القيمة):
        اضف(هذا.العناصر، القيمة)
        ارجع هذا

    دالة اخرج_اول():
        اذا هذا.البداية >= طول(هذا.العناصر):
            ارجع عدم
        القيمة := هذا.العناصر[هذا.البداية]
        هذا.البداية += 1
        اذا هذا.البداية > 32 و هذا.البداية * 2 > طول(هذا.العناصر):
            هذا.العناصر := اسقط(هذا.العناصر، هذا.البداية)
            هذا.البداية := 0
        ارجع القيمة

    دالة اول():
        اذا هذا.البداية >= طول(هذا.العناصر):
            ارجع عدم
        ارجع هذا.العناصر[هذا.البداية]

    دالة فارغ():
        ارجع هذا.البداية >= طول(هذا.العناصر)

    دالة الحجم():
        ارجع طول(هذا.العناصر) - هذا.البداية

نوع مجموعة:
    دالة بداية():
        هذا.البيانات := قاموس()

    دالة اضف_عنصر(القيمة):
        هذا.البيانات[القيمة] := صحيح
        ارجع هذا

    دالة احذف_عنصر(القيمة):
        ارجع __قاموس_احذف(هذا.البيانات، القيمة)

    دالة يحتوي_عنصر(القيمة):
        ارجع __قاموس_يحتوي(هذا.البيانات، القيمة)

    دالة عناصر():
        ارجع __قاموس_مفاتيح(هذا.البيانات)

    دالة الحجم():
        ارجع طول(هذا.البيانات)

نوع عداد:
    دالة بداية(القيم):
        هذا.الاعداد := قاموس()
        لكل قيمة في القيم:
            هذا.زد(قيمة، 1)

    دالة زد(القيمة، المقدار):
        الحالي := قاموس_خذ(هذا.الاعداد، القيمة، 0)
        هذا.الاعداد[القيمة] := الحالي + المقدار
        ارجع هذا.الاعداد[القيمة]

    دالة عدد(القيمة):
        ارجع قاموس_خذ(هذا.الاعداد، القيمة، 0)

    دالة الاكثر(العدد):
        العناصر := قاموس_عناصر(هذا.الاعداد)
        المرتبة := رتب_ب(العناصر، __زوج_الثاني، صحيح)
        ارجع خذ(المرتبة، العدد)

    دالة عناصر():
        ارجع قاموس_عناصر(هذا.الاعداد)

دالة __زوج_الثاني(الزوج):
    ارجع الزوج[1]

نوع قاموس_افتراضي:
    دالة بداية(المصنع):
        هذا.البيانات := قاموس()
        هذا.المصنع := المصنع

    دالة خذ(المفتاح):
        اذا ليس __قاموس_يحتوي(هذا.البيانات، المفتاح):
            هذا.البيانات[المفتاح] := هذا.المصنع()
        ارجع هذا.البيانات[المفتاح]

    دالة ضع(المفتاح، القيمة):
        هذا.البيانات[المفتاح] := القيمة
        ارجع القيمة

    دالة يحتوي(المفتاح):
        ارجع __قاموس_يحتوي(هذا.البيانات، المفتاح)

نوع طابور_اولوية:
    دالة بداية():
        هذا.الكومة := قائمة()

    دالة ادفع(الاولوية، القيمة):
        اضف(هذا.الكومة، [الاولوية، القيمة])
        فهرس := طول(هذا.الكومة) - 1
        طالما فهرس > 0:
            الاب := ادنى((فهرس - 1) / 2)
            اذا هذا.الكومة[الاب][0] <= هذا.الكومة[فهرس][0]:
                ارجع هذا
            مؤقت := هذا.الكومة[الاب]
            هذا.الكومة[الاب] := هذا.الكومة[فهرس]
            هذا.الكومة[فهرس] := مؤقت
            فهرس := الاب
        ارجع هذا

    دالة اسحب():
        اذا طول(هذا.الكومة) = 0:
            ارجع عدم
        الناتج := هذا.الكومة[0]
        الاخير := اخرج_اخير(هذا.الكومة)
        اذا طول(هذا.الكومة) = 0:
            ارجع الناتج
        هذا.الكومة[0] := الاخير
        فهرس := 0
        طالما صحيح:
            يسار := فهرس * 2 + 1
            يمين := يسار + 1
            اصغر_فهرس := فهرس
            اذا يسار < طول(هذا.الكومة) و هذا.الكومة[يسار][0] < هذا.الكومة[اصغر_فهرس][0]:
                اصغر_فهرس := يسار
            اذا يمين < طول(هذا.الكومة) و هذا.الكومة[يمين][0] < هذا.الكومة[اصغر_فهرس][0]:
                اصغر_فهرس := يمين
            اذا اصغر_فهرس = فهرس:
                ارجع الناتج
            مؤقت := هذا.الكومة[فهرس]
            هذا.الكومة[فهرس] := هذا.الكومة[اصغر_فهرس]
            هذا.الكومة[اصغر_فهرس] := مؤقت
            فهرس := اصغر_فهرس

    دالة قمة():
        اذا طول(هذا.الكومة) = 0:
            ارجع عدم
        ارجع هذا.الكومة[0]

    دالة الحجم():
        ارجع طول(هذا.الكومة)

نوع ذاكرة_LRU:
    دالة بداية(السعة):
        اذا السعة <= 0:
            عطل("سعة LRU يجب أن تكون موجبة")
        هذا.السعة := السعة
        هذا.القيم := قاموس()
        هذا.الترتيب := قائمة()

    دالة __المس(المفتاح):
        الموضع := ابحث(هذا.الترتيب، المفتاح)
        اذا الموضع != -1:
            احذف_عند(هذا.الترتيب، الموضع)
        اضف(هذا.الترتيب، المفتاح)

    دالة خذ(المفتاح):
        اذا ليس __قاموس_يحتوي(هذا.القيم، المفتاح):
            ارجع لاشيء()
        هذا.__المس(المفتاح)
        ارجع بعض(هذا.القيم[المفتاح])

    دالة ضع(المفتاح، القيمة):
        هذا.القيم[المفتاح] := القيمة
        هذا.__المس(المفتاح)
        اذا طول(هذا.الترتيب) > هذا.السعة:
            القديم := احذف_عند(هذا.الترتيب، 0)
            __قاموس_احذف(هذا.القيم، القديم)
        ارجع القيمة

    دالة احذف(المفتاح):
        الموضع := ابحث(هذا.الترتيب، المفتاح)
        اذا الموضع != -1:
            احذف_عند(هذا.الترتيب، الموضع)
        ارجع __قاموس_احذف(هذا.القيم، المفتاح)

    دالة امسح():
        هذا.القيم := قاموس()
        هذا.الترتيب := قائمة()
