# مصدر العشوائية هنا يجب أن يكون CSPRNG من النظام، لا random.fa.

دالة بايتات_امنة(العدد):
    اذا العدد < 0:
        عطل("عدد البايتات الآمنة لا يمكن أن يكون سالباً")
    ارجع __اسرار_بايتات(العدد)

دالة رمز_امن(العدد):
    ارجع base64_URL_رمز(بايتات_امنة(العدد))

دالة hex_امن(العدد):
    ارجع hex_رمز(بايتات_امنة(العدد))

دالة اختيار_امن(القيم):
    اذا طول(القيم) = 0:
        عطل("لا يمكن الاختيار من قائمة فارغة")
    ارجع القيم[__اسرار_عدد(طول(القيم))]

دالة مقارنة_ثابتة(الاول، الثاني):
    ارجع __اسرار_قارن(الاول، الثاني)
