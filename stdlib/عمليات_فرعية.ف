# إنشاء العملية والأنابيب بدائيات أصلية؛ دورة الحياة في فيروز.

من قواميس استورد قاموس_خذ
# __عملية_ابدأ__، __عملية_استطلع__، __عملية_انتظر__، __عملية_تواصل__
# __عملية_ارسل__، __عملية_اغلق_دخل__، __عملية_انه__، __عملية_اقتل__

نوع عملية:
    دالة بداية(الامر، الخيارات):
        هذا.الامر := الامر
        هذا.الخيارات := الخيارات
        هذا.المقبض := __عملية_ابدأ__(الامر، الخيارات)
        اذا هذا.المقبض = عدم:
            عطل("تعذر بدء العملية")

    دالة استطلع():
        ارجع __عملية_استطلع__(هذا.المقبض)

    دالة يعمل():
        ارجع هذا.استطلع() = عدم

    دالة انتظر(المهلة):
        ارجع __عملية_انتظر__(هذا.المقبض، المهلة)

    دالة تواصل(المدخل، المهلة):
        ارجع __عملية_تواصل__(هذا.المقبض، المدخل، المهلة)

    دالة ارسل(البيانات):
        ارجع __عملية_ارسل__(هذا.المقبض، البيانات)

    دالة اغلق_الدخل():
        ارجع __عملية_اغلق_دخل__(هذا.المقبض)

    دالة انه():
        ارجع __عملية_انه__(هذا.المقبض)

    دالة اقتل():
        ارجع __عملية_اقتل__(هذا.المقبض)

دالة شغل(الامر، الخيارات):
    العملية := عملية(الامر، الخيارات)
    المدخل := قاموس_خذ(الخيارات، "input"، عدم)
    المهلة := قاموس_خذ(الخيارات، "timeout"، عدم)
    ارجع العملية.تواصل(المدخل، المهلة)
