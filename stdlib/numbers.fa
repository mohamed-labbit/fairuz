# أعداد مركبة فوق العدد الأساسي. Decimal الحقيقي يحتاج حساباً عشرياً أصلياً.

من math استورد قاسم_مشترك

نوع كسر:
    دالة بداية(البسط، المقام):
        اذا المقام = 0:
            عطل("مقام الكسر لا يمكن أن يكون صفراً")
        القاسم := قاسم_مشترك(البسط، المقام)
        البسط := البسط / القاسم
        المقام := المقام / القاسم
        اذا المقام < 0:
            البسط := -البسط
            المقام := -المقام
        هذا.البسط := البسط
        هذا.المقام := المقام

    دالة حقيقي():
        ارجع هذا.البسط / هذا.المقام

    دالة اجمع(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام + الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)

    دالة اطرح(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام - الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)

    دالة اضرب(الاخر):
        ارجع كسر(هذا.البسط * الاخر.البسط، هذا.المقام * الاخر.المقام)

    دالة اقسم(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام، هذا.المقام * الاخر.البسط)

    دالة نص():
        اذا هذا.المقام = 1:
            ارجع سلسلة(هذا.البسط)
        ارجع سلسلة(هذا.البسط) + "/" + سلسلة(هذا.المقام)

نوع عشري:
    دالة بداية(القيمة، السياق):
        هذا.المقبض := __عشري_جديد(القيمة، السياق)
        هذا.السياق := السياق

    دالة اجمع(الاخر):
        ارجع عشري(__عشري_عملية("add"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اطرح(الاخر):
        ارجع عشري(__عشري_عملية("sub"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اضرب(الاخر):
        ارجع عشري(__عشري_عملية("mul"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اقسم(الاخر):
        ارجع عشري(__عشري_عملية("div"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة نص():
        ارجع __عشري_نص(هذا.المقبض)
