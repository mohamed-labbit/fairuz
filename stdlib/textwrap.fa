# تنسيق الفقرات في فيروز مع الحفاظ على الكلمات وUnicode.

من strings استورد كلمات
من strings استورد اسطر

دالة لف_نص(النص، العرض):
    اذا العرض <= 0:
        عطل("عرض لف النص يجب أن يكون موجباً")
    الناتج := قائمة()
    السطر := ""
    لكل كلمة في كلمات(النص):
        اذا طول(السطر) = 0:
            السطر := كلمة
        غيره:
            اذا طول(السطر) + 1 + طول(كلمة) <= العرض:
                السطر += " " + كلمة
            غيره:
                اضف(الناتج، السطر)
                السطر := كلمة
    اذا طول(السطر) > 0:
        اضف(الناتج، السطر)
    ارجع الناتج

دالة املأ_نص(النص، العرض):
    ارجع اجمع(لف_نص(النص، العرض)، "\n")

دالة ازح_نص(النص، السابقة):
    الناتج := قائمة()
    لكل سطر في اسطر(النص):
        اضف(الناتج، السابقة + سطر)
    ارجع اجمع(الناتج، "\n")

دالة __مسافة_بادئة(السطر):
    العدد := 0
    طالما العدد < طول(السطر) و جزء(السطر، العدد، العدد + 1) = " ":
        العدد += 1
    ارجع العدد

دالة ازل_ازاحة_مشتركة(النص):
    الخطوط := اسطر(النص)
    الاصغر := عدم
    لكل سطر في الخطوط:
        اذا طول(قص(سطر)) > 0:
            الحالي := __مسافة_بادئة(السطر)
            اذا الاصغر = عدم او الحالي < الاصغر:
                الاصغر := الحالي
    اذا الاصغر = عدم او الاصغر = 0:
        ارجع النص
    الناتج := قائمة()
    لكل سطر في الخطوط:
        اذا طول(سطر) >= الاصغر:
            اضف(الناتج، جزء(سطر، الاصغر، طول(سطر)))
        غيره:
            اضف(الناتج، "")
    ارجع اجمع(الناتج، "\n")
