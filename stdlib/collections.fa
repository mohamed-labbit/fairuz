# خوارزميات المجموعات المكتوبة بفيروز.

دالة __هوية_ترتيب(القيمة):
    ارجع القيمة
# العمليات التي تغيّر التخزين نفسه (طول/اضف/احذف/مقطع) تبقى أصلية.

دالة انسخ_قائمة(القيم):
    الناتج := قائمة()
    لكل قيمة في القيم:
        اضف(الناتج، قيمة)
    ارجع الناتج

دالة اعكس(القيم):
    الناتج := قائمة()
    فهرس := طول(القيم) - 1
    طالما فهرس >= 0:
        اضف(الناتج، القيم[فهرس])
        فهرس -= 1
    ارجع الناتج

دالة مدى(البداية، النهاية، الخطوة):
    اذا الخطوة = 0:
        عطل("خطوة المدى لا يمكن أن تكون صفراً")

    الناتج := قائمة()
    الحالي := البداية
    اذا الخطوة > 0:
        طالما الحالي < النهاية:
            اضف(الناتج، الحالي)
            الحالي += الخطوة
    غيره:
        طالما الحالي > النهاية:
            اضف(الناتج، الحالي)
            الحالي += الخطوة
    ارجع الناتج

دالة مدى_الى(النهاية):
    ارجع مدى(0، النهاية، 1)

دالة مجموع(القيم):
    الناتج := 0
    لكل قيمة في القيم:
        الناتج += قيمة
    ارجع الناتج

دالة كل(القيم):
    لكل قيمة في القيم:
        اذا ليس قيمة:
            ارجع خطا
    ارجع صحيح

دالة اي(القيم):
    لكل قيمة في القيم:
        اذا قيمة:
            ارجع صحيح
    ارجع خطا

دالة عدد(القيم، المطلوب):
    الناتج := 0
    لكل قيمة في القيم:
        اذا قيمة = المطلوب:
            الناتج += 1
    ارجع الناتج

دالة ابحث(القيم، المطلوب):
    فهرس := 0
    لكل قيمة في القيم:
        اذا قيمة = المطلوب:
            ارجع فهرس
        فهرس += 1
    ارجع -1

دالة خريطة(القيم، الدالة):
    الناتج := قائمة()
    لكل قيمة في القيم:
        اضف(الناتج، الدالة(قيمة))
    ارجع الناتج

دالة رشح(القيم، الشرط):
    الناتج := قائمة()
    لكل قيمة في القيم:
        اذا الشرط(قيمة):
            اضف(الناتج، قيمة)
    ارجع الناتج

دالة اختزل(القيم، الدالة، البداية):
    الناتج := البداية
    لكل قيمة في القيم:
        الناتج := الدالة(الناتج، قيمة)
    ارجع الناتج

دالة __ادمج_مرتب(الاول، الثاني، المفتاح، عكسي):
    الناتج := قائمة()
    ا := 0
    ب := 0
    طالما ا < طول(الاول) و ب < طول(الثاني):
        قيمة_ا := المفتاح(الاول[ا])
        قيمة_ب := المفتاح(الثاني[ب])
        خذ_الاول := قيمة_ا <= قيمة_ب
        اذا عكسي:
            خذ_الاول := قيمة_ا >= قيمة_ب
        اذا خذ_الاول:
            اضف(الناتج، الاول[ا])
            ا += 1
        غيره:
            اضف(الناتج، الثاني[ب])
            ب += 1
    طالما ا < طول(الاول):
        اضف(الناتج، الاول[ا])
        ا += 1
    طالما ب < طول(الثاني):
        اضف(الناتج، الثاني[ب])
        ب += 1
    ارجع الناتج

دالة رتب_ب(القيم، المفتاح، عكسي):
    # ترتيب دمج مستقر O(n log n)، مثل sorted في بايثون.
    اذا طول(القيم) <= 1:
        ارجع انسخ_قائمة(القيم)
    الوسط := ادنى(طول(القيم) / 2)
    يسار := قائمة()
    يمين := قائمة()
    فهرس := 0
    طالما فهرس < الوسط:
        اضف(يسار، القيم[فهرس])
        فهرس += 1
    طالما فهرس < طول(القيم):
        اضف(يمين، القيم[فهرس])
        فهرس += 1
    يسار := رتب_ب(يسار، المفتاح، عكسي)
    يمين := رتب_ب(يمين، المفتاح، عكسي)
    ارجع __ادمج_مرتب(يسار، يمين، المفتاح، عكسي)

دالة رتب(القيم):
    ارجع رتب_ب(القيم، __هوية_ترتيب، خطا)

دالة اخرج_اخير(القيم):
    اذا طول(القيم) = 0:
        ارجع عدم
    فهرس := طول(القيم) - 1
    القيمة := القيم[فهرس]
    احذف(القيم)
    ارجع القيمة

دالة احذف_عند(القيم، الفهرس):
    اذا الفهرس < 0 او الفهرس >= طول(القيم):
        ارجع عدم
    القيمة := القيم[الفهرس]
    الحالي := الفهرس
    طالما الحالي + 1 < طول(القيم):
        القيم[الحالي] := القيم[الحالي + 1]
        الحالي += 1
    احذف(القيم)
    ارجع القيمة

دالة خذ(القيم، العدد):
    الناتج := قائمة()
    حد := اصغر(طول(القيم)، اكبر(0، العدد))
    فهرس := 0
    طالما فهرس < حد:
        اضف(الناتج، القيم[فهرس])
        فهرس += 1
    ارجع الناتج

دالة اسقط(القيم، العدد):
    الناتج := قائمة()
    فهرس := اكبر(0، العدد)
    طالما فهرس < طول(القيم):
        اضف(الناتج، القيم[فهرس])
        فهرس += 1
    ارجع الناتج

دالة ادمج_قوائم(الاول، الثاني):
    الناتج := انسخ_قائمة(الاول)
    لكل قيمة في الثاني:
        اضف(الناتج، قيمة)
    ارجع الناتج

دالة سطح(القوائم):
    الناتج := قائمة()
    لكل مجموعة في القوائم:
        لكل قيمة في مجموعة:
            اضف(الناتج، قيمة)
    ارجع الناتج

دالة فريد(القيم):
    الناتج := قائمة()
    لكل قيمة في القيم:
        اذا ابحث(الناتج، قيمة) = -1:
            اضف(الناتج، قيمة)
    ارجع الناتج

دالة اتحاد(الاول، الثاني):
    ارجع فريد(ادمج_قوائم(الاول، الثاني))

دالة تقاطع(الاول، الثاني):
    الناتج := قائمة()
    لكل قيمة في فريد(الاول):
        اذا ابحث(الثاني، قيمة) != -1:
            اضف(الناتج، قيمة)
    ارجع الناتج

دالة فرق(الاول، الثاني):
    الناتج := قائمة()
    لكل قيمة في الاول:
        اذا ابحث(الثاني، قيمة) = -1:
            اضف(الناتج، قيمة)
    ارجع الناتج

دالة اربط(الاول، الثاني):
    الناتج := قائمة()
    الحد := اصغر(طول(الاول)، طول(الثاني))
    فهرس := 0
    طالما فهرس < الحد:
        اضف(الناتج، [الاول[فهرس]، الثاني[فهرس]])
        فهرس += 1
    ارجع الناتج

دالة رقم(القيم):
    الناتج := قائمة()
    فهرس := 0
    لكل قيمة في القيم:
        اضف(الناتج، [فهرس، قيمة])
        فهرس += 1
    ارجع الناتج

دالة قسم(القيم، الشرط):
    المقبول := قائمة()
    المرفوض := قائمة()
    لكل قيمة في القيم:
        اذا الشرط(قيمة):
            اضف(المقبول، قيمة)
        غيره:
            اضف(المرفوض، قيمة)
    ارجع [المقبول، المرفوض]

دالة اصغر_عنصر(القيم):
    اذا طول(القيم) = 0:
        ارجع عدم
    الناتج := القيم[0]
    لكل قيمة في القيم:
        اذا قيمة < الناتج:
            الناتج := قيمة
    ارجع الناتج

دالة اكبر_عنصر(القيم):
    اذا طول(القيم) = 0:
        ارجع عدم
    الناتج := القيم[0]
    لكل قيمة في القيم:
        اذا قيمة > الناتج:
            الناتج := قيمة
    ارجع الناتج

دالة ابحث_ثنائي(القيم، المطلوب):
    اليسار := 0
    اليمين := طول(القيم)
    طالما اليسار < اليمين:
        الوسط := ادنى((اليسار + اليمين) / 2)
        اذا القيم[الوسط] < المطلوب:
            اليسار := الوسط + 1
        غيره:
            اليمين := الوسط
    اذا اليسار < طول(القيم) و القيم[اليسار] = المطلوب:
        ارجع اليسار
    ارجع -1

دالة قطع(القيم، الحجم):
    اذا الحجم <= 0:
        عطل("حجم القطعة يجب أن يكون موجباً")
    الناتج := قائمة()
    فهرس := 0
    طالما فهرس < طول(القيم):
        القطعة := قائمة()
        نهاية := اصغر(فهرس + الحجم، طول(القيم))
        طالما فهرس < نهاية:
            اضف(القطعة، القيم[فهرس])
            فهرس += 1
        اضف(الناتج، القطعة)
    ارجع الناتج

دالة نوافذ(القيم، الحجم):
    اذا الحجم <= 0:
        عطل("حجم النافذة يجب أن يكون موجباً")
    الناتج := قائمة()
    بداية := 0
    طالما بداية + الحجم <= طول(القيم):
        النافذة := قائمة()
        فهرس := بداية
        طالما فهرس < بداية + الحجم:
            اضف(النافذة، القيم[فهرس])
            فهرس += 1
        اضف(الناتج، النافذة)
        بداية += 1
    ارجع الناتج

دالة دور(القيم، المقدار):
    اذا طول(القيم) = 0:
        ارجع قائمة()
    ازاحة := المقدار % طول(القيم)
    اذا ازاحة < 0:
        ازاحة += طول(القيم)
    نقطة := طول(القيم) - ازاحة
    ارجع ادمج_قوائم(اسقط(القيم، نقطة)، خذ(القيم، نقطة))

دالة اجمع_حسب(القيم، المفتاح):
    الناتج := قاموس()
    لكل قيمة في القيم:
        اسم := المفتاح(قيمة)
        اذا ليس __قاموس_يحتوي(الناتج، اسم):
            الناتج[اسم] := قائمة()
        اضف(الناتج[اسم]، قيمة)
    ارجع الناتج

دالة اطو_يمين(القيم، الدالة، البداية):
    الناتج := البداية
    فهرس := طول(القيم) - 1
    طالما فهرس >= 0:
        الناتج := الدالة(القيم[فهرس]، الناتج)
        فهرس -= 1
    ارجع الناتج
