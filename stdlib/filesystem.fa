# العمليات الحساسة للسباقات والروابط الرمزية بدائيات نظامية آمنة.

من path استورد مسار
من path استورد نص_مسار
من file استورد ملف
# __مسار_glob، __ملف_مؤقت، __مجلد_مؤقت، __نظام_انسخ، __نظام_احذف_شجرة

دالة glob(النمط):
    الناتج := قائمة()
    لكل قيمة في __مسار_glob(النمط، خطا):
        اضف(الناتج، مسار(قيمة))
    ارجع الناتج

دالة glob_متكرر(النمط):
    الناتج := قائمة()
    لكل قيمة في __مسار_glob(النمط، صحيح):
        اضف(الناتج، مسار(قيمة))
    ارجع الناتج

دالة انسخ_مسار(المصدر، الوجهة، اتبع_الروابط):
    ارجع __نظام_انسخ(نص_مسار(المصدر)، نص_مسار(الوجهة)، اتبع_الروابط)

دالة احذف_شجرة(المسار):
    # البدائية لا تتبع الروابط الرمزية أثناء النزول.
    ارجع __نظام_احذف_شجرة(نص_مسار(المسار))

نوع ملف_مؤقت:
    دالة بداية(السابقة، اللاحقة، المجلد):
        الخام := __ملف_مؤقت(السابقة، اللاحقة، المجلد)
        هذا.المسار := مسار(الخام["path"])
        هذا.الملف := ملف(الخام["path"]، "كتابة")
        هذا.يحذف := صحيح
        هذا.الملف.فتح()

    دالة احتفظ():
        هذا.يحذف := خطا
        ارجع هذا.المسار

    دالة اغلق():
        هذا.الملف.اغلق()
        اذا هذا.يحذف:
            هذا.المسار.احذف()

نوع مجلد_مؤقت:
    دالة بداية(السابقة، المجلد):
        هذا.المسار := مسار(__مجلد_مؤقت(السابقة، المجلد))
        هذا.يحذف := صحيح

    دالة احتفظ():
        هذا.يحذف := خطا
        ارجع هذا.المسار

    دالة اغلق():
        اذا هذا.يحذف:
            احذف_شجرة(هذا.المسار.نص())
