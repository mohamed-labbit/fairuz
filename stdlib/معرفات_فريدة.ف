# 16 بايتاً آمنة تأتي من secrets؛ ضبط بتات UUID والتنسيق بدائي بايتات.

نوع UUID:
    دالة بداية(النص):
        هذا.بايتات := __UUID_حلل__(النص)
        اذا هذا.بايتات = عدم:
            عطل("UUID غير صالح: " + النص)

    دالة نص():
        ارجع __UUID_نسق__(هذا.بايتات)

    دالة نسخة():
        ارجع __UUID_نسخة__(هذا.بايتات)

    دالة اصدار():
        ارجع __UUID_نوع__(هذا.بايتات)

دالة UUID4():
    ارجع UUID(__UUID4__())

دالة UUID5(النطاق، الاسم):
    ارجع UUID(__UUID5__(النطاق.نص()، الاسم))
