# UTF-8 والنسب المئوية بدائيات نصية؛ تركيب URL والاستعلام في فيروز.

من dicts استورد قاموس_مفاتيح
من dicts استورد قاموس_خذ
من strings استورد افصل_مرة
# __URL_اهرب، __URL_فك، __URL_حلل تعيد حقول المخطط/المضيف/المنفذ/المسار.

دالة URL_رمز_استعلام(القيم):
    الاجزاء := قائمة()
    لكل مفتاح في قاموس_مفاتيح(القيم):
        القيمة := القيم[مفتاح]
        اذا صنف(القيمة) = "قائمة":
            لكل عنصر في القيمة:
                اضف(الاجزاء، __URL_اهرب(سلسلة(مفتاح)) + "=" + __URL_اهرب(سلسلة(عنصر)))
        غيره:
            اضف(الاجزاء، __URL_اهرب(سلسلة(مفتاح)) + "=" + __URL_اهرب(سلسلة(القيمة)))
    ارجع اجمع(الاجزاء، "&")

دالة URL_حلل_استعلام(النص):
    الناتج := قاموس()
    اذا طول(النص) = 0:
        ارجع الناتج
    لكل زوج في اقسم(النص، "&"):
        الاجزاء := افصل_مرة(زوج، "=")
        المفتاح := __URL_فك(الاجزاء[0])
        القيمة := __URL_فك(الاجزاء[2])
        اذا __قاموس_يحتوي(الناتج، المفتاح):
            الحالي := الناتج[المفتاح]
            اذا صنف(الحالي) != "قائمة":
                الحالي := [الحالي]
            اضف(الحالي، القيمة)
            الناتج[المفتاح] := الحالي
        غيره:
            الناتج[المفتاح] := القيمة
    ارجع الناتج

نوع رابط:
    دالة بداية(النص):
        هذا.الحقول := __URL_حلل(النص)
        اذا هذا.الحقول = عدم:
            عطل("رابط غير صالح: " + النص)

    دالة مخطط():
        ارجع قاموس_خذ(هذا.الحقول، "scheme"، "")

    دالة مضيف():
        ارجع قاموس_خذ(هذا.الحقول، "host"، "")

    دالة منفذ():
        ارجع قاموس_خذ(هذا.الحقول، "port"، عدم)

    دالة مسار():
        ارجع قاموس_خذ(هذا.الحقول، "path"، "")

    دالة استعلام():
        ارجع URL_حلل_استعلام(قاموس_خذ(هذا.الحقول، "query"، ""))

    دالة نص():
        ارجع __URL_ركب(هذا.الحقول)
