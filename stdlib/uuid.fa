# 16 بايتاً آمنة تأتي من secrets؛ ضبط بتات UUID والتنسيق بدائي بايتات.

نوع UUID:
    دالة بداية(النص):
        هذا.بايتات := __UUID_حلل(النص)
        اذا هذا.بايتات = عدم:
            عطل("UUID غير صالح: " + النص)

    دالة نص():
        ارجع __UUID_نسق(هذا.بايتات)

    دالة نسخة():
        ارجع __UUID_نسخة(هذا.بايتات)

    دالة اصدار():
        ارجع __UUID_نوع(هذا.بايتات)

دالة UUID4():
    ارجع UUID(__UUID4())

دالة UUID5(النطاق، الاسم):
    ارجع UUID(__UUID5(النطاق.نص()، الاسم))
