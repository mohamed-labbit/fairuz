# حدود نظام التشغيل: البيئة، العملية، الملفات، والإشارات كلها بدائيات __نظام_*.

دالة وسائط_البرنامج():
    ارجع __نظام_وسائط()

دالة متغير_بيئة(الاسم، البديل):
    القيمة := __نظام_بيئة_خذ(الاسم)
    اذا القيمة = عدم:
        ارجع البديل
    ارجع القيمة

دالة ضع_متغير_بيئة(الاسم، القيمة):
    ارجع __نظام_بيئة_ضع(الاسم، سلسلة(القيمة))

دالة احذف_متغير_بيئة(الاسم):
    ارجع __نظام_بيئة_احذف(الاسم)

دالة البيئة():
    ارجع __نظام_البيئة()

دالة هوية_العملية():
    ارجع __نظام_PID()

دالة هوية_الاصل():
    ارجع __نظام_PPID()

دالة اسم_المضيف():
    ارجع __نظام_اسم_المضيف()

دالة غير_المجلد(المسار):
    ارجع __نظام_غير_المجلد(المسار)

دالة نفذ_امر(الامر):
    # نسخة صريحة عبر shell؛ لا تستعمل مع مدخل غير موثوق.
    ارجع __نظام_shell(الامر)
