# نتيجة وخيار بديلان صريحان عن خلط الفشل بالقيمة عدم.

نوع نتيجة:
    دالة بداية(ناجح، القيمة، الخطا):
        هذا.ناجح := ناجح
        هذا.القيمة := القيمة
        هذا.الخطا := الخطا

    دالة نجح():
        ارجع هذا.ناجح

    دالة له_قيمة():
        ارجع هذا.ناجح

    دالة فشل():
        ارجع ليس هذا.ناجح

    دالة او_بديل(البديل):
        اذا هذا.ناجح:
            ارجع هذا.القيمة
        ارجع البديل

    دالة افتح():
        اذا ليس هذا.ناجح:
            عطل(هذا.الخطا)
        ارجع هذا.القيمة

    دالة حول(الدالة):
        اذا هذا.ناجح:
            ارجع نجاح(الدالة(هذا.القيمة))
        ارجع هذا

    دالة ثم(الدالة):
        اذا هذا.ناجح:
            ارجع الدالة(هذا.القيمة)
        ارجع هذا

    دالة حول_الخطا(الدالة):
        اذا هذا.ناجح:
            ارجع هذا
        ارجع فشل(الدالة(هذا.الخطا))

    دالة استرد(الدالة):
        اذا هذا.ناجح:
            ارجع هذا
        ارجع الدالة(هذا.الخطا)

    دالة طابق(عند_نجاح، عند_فشل):
        اذا هذا.ناجح:
            ارجع عند_نجاح(هذا.القيمة)
        ارجع عند_فشل(هذا.الخطا)

دالة نجاح(القيمة):
    ارجع نتيجة(صحيح، القيمة، عدم)

دالة فشل(الخطا):
    ارجع نتيجة(خطا، عدم، الخطا)

نوع خيار:
    دالة بداية(موجود، القيمة):
        هذا.موجود := موجود
        هذا.القيمة := القيمة

    دالة له_قيمة():
        ارجع هذا.موجود

    دالة او_بديل(البديل):
        اذا هذا.موجود:
            ارجع هذا.القيمة
        ارجع البديل

    دالة افتح():
        اذا ليس هذا.موجود:
            عطل("محاولة فتح خيار فارغ")
        ارجع هذا.القيمة

    دالة حول(الدالة):
        اذا هذا.موجود:
            ارجع بعض(الدالة(هذا.القيمة))
        ارجع هذا

    دالة ثم(الدالة):
        اذا هذا.موجود:
            ارجع الدالة(هذا.القيمة)
        ارجع هذا

    دالة رشح(الشرط):
        اذا هذا.موجود و الشرط(هذا.القيمة):
            ارجع هذا
        ارجع لاشيء()

    دالة او_احسب(الدالة):
        اذا هذا.موجود:
            ارجع هذا.القيمة
        ارجع الدالة()

دالة بعض(القيمة):
    ارجع خيار(صحيح، القيمة)

دالة لاشيء():
    ارجع خيار(خطا، عدم)
