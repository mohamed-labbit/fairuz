# إنشاء العملية والأنابيب بدائيات أصلية؛ دورة الحياة في فيروز.

من dicts استورد قاموس_خذ
# __عملية_ابدأ، __عملية_استطلع، __عملية_انتظر، __عملية_تواصل
# __عملية_ارسل، __عملية_اغلق_دخل، __عملية_انه، __عملية_اقتل

نوع عملية:
    دالة بداية(الامر، الخيارات):
        هذا.الامر := الامر
        هذا.الخيارات := الخيارات
        هذا.المقبض := __عملية_ابدأ(الامر، الخيارات)
        اذا هذا.المقبض = عدم:
            عطل("تعذر بدء العملية")

    دالة استطلع():
        ارجع __عملية_استطلع(هذا.المقبض)

    دالة يعمل():
        ارجع هذا.استطلع() = عدم

    دالة انتظر(المهلة):
        ارجع __عملية_انتظر(هذا.المقبض، المهلة)

    دالة تواصل(المدخل، المهلة):
        ارجع __عملية_تواصل(هذا.المقبض، المدخل، المهلة)

    دالة ارسل(البيانات):
        ارجع __عملية_ارسل(هذا.المقبض، البيانات)

    دالة اغلق_الدخل():
        ارجع __عملية_اغلق_دخل(هذا.المقبض)

    دالة انه():
        ارجع __عملية_انه(هذا.المقبض)

    دالة اقتل():
        ارجع __عملية_اقتل(هذا.المقبض)

دالة شغل(الامر، الخيارات):
    العملية := عملية(الامر، الخيارات)
    المدخل := قاموس_خذ(الخيارات، "input"، عدم)
    المهلة := قاموس_خذ(الخيارات، "timeout"، عدم)
    ارجع العملية.تواصل(المدخل، المهلة)
