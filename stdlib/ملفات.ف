# واجهة الملفات عالية المستوى. وحدها البدائيات ذات بادئة __ تلمس FILE*.

من نتيجة استورد نجاح، فشل، بعض، لاشيء
# __ملف_افتح__، __ملف_اقرا__، __ملف_اقرا_الكل__، __ملف_اقرا_سطر__
# __ملف_اكتب__، __ملف_اضف__، __ملف_ادفع__، __ملف_اغلق__
# __ملف_موضع__، __ملف_انتقل__، __ملف_اقتطع__، __ملف_معلومات__

نوع ملف:
    دالة بداية(المسار، الوضع):
        هذا.المسار := المسار
        هذا.الوضع := الوضع
        هذا.مفتوح := خطا
        هذا.المقبض := عدم

    دالة فتح():
        اذا هذا.مفتوح:
            ارجع صحيح
        هذا.المقبض := __ملف_افتح__(هذا.المسار، هذا.الوضع)
        اذا هذا.المقبض = عدم:
            ارجع خطا
        هذا.مفتوح := صحيح
        ارجع صحيح

    دالة اقرا_الكل():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_اقرا_الكل__(هذا.المقبض)

    دالة اقرا(العدد):
        اذا ليس هذا.مفتوح:
            ارجع عدم
        اذا العدد < 0:
            عطل("عدد بايتات القراءة لا يمكن أن يكون سالباً")
        ارجع __ملف_اقرا__(هذا.المقبض، العدد)

    دالة اقرا_سطر():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_اقرا_سطر__(هذا.المقبض)

    دالة اكتب_نص(النص):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اكتب__(هذا.المقبض، النص)

    دالة اكتب_سطر(النص):
        ارجع هذا.اكتب_نص(سلسلة(النص) + "\n")

    دالة اضف_نص(النص):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اضف__(هذا.المقبض، النص)

    دالة ادفع():
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_ادفع__(هذا.المقبض)

    دالة موضع():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_موضع__(هذا.المقبض)

    دالة انتقل(الموضع، المرجع):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_انتقل__(هذا.المقبض، الموضع، المرجع)

    دالة اقتطع(الحجم):
        اذا ليس هذا.مفتوح:
            ارجع خطا
        ارجع __ملف_اقتطع__(هذا.المقبض، الحجم)

    دالة معلومات():
        اذا ليس هذا.مفتوح:
            ارجع عدم
        ارجع __ملف_معلومات__(هذا.المقبض)

    دالة اغلق():
        اذا ليس هذا.مفتوح:
            ارجع صحيح
        نجح := __ملف_اغلق__(هذا.المقبض)
        اذا نجح:
            هذا.مفتوح := خطا
            هذا.المقبض := عدم
        ارجع نجح

    دالة يعمل():
        ارجع هذا.مفتوح

دالة اقرا_نص_ملف(المسار):
    المورد := ملف(المسار، "قراءة")
    اذا ليس المورد.فتح():
        ارجع عدم
    النص := المورد.اقرا_الكل()
    المورد.اغلق()
    ارجع النص

دالة اكتب_نص_ملف(المسار، النص):
    المورد := ملف(المسار، "كتابة")
    اذا ليس المورد.فتح():
        ارجع خطا
    نجح := المورد.اكتب_نص(النص)
    اذا نجح:
        نجح := المورد.ادفع()
    المورد.اغلق()
    ارجع نجح

دالة اضف_نص_ملف(المسار، النص):
    المورد := ملف(المسار، "اضافة")
    اذا ليس المورد.فتح():
        ارجع خطا
    نجح := المورد.اضف_نص(النص)
    اذا نجح:
        نجح := المورد.ادفع()
    المورد.اغلق()
    ارجع نجح

دالة انسخ_ملف(المصدر، الوجهة):
    المحتوى := اقرا_نص_ملف(المصدر)
    اذا المحتوى = عدم:
        ارجع خطا
    ارجع اكتب_نص_ملف(الوجهة، المحتوى)

دالة اقرا_اسطر_ملف(المسار):
    المورد := ملف(المسار، "قراءة")
    اذا ليس المورد.فتح():
        ارجع عدم
    الناتج := قائمة()
    طالما صحيح:
        السطر := المورد.اقرا_سطر()
        اذا السطر = عدم:
            المورد.اغلق()
            ارجع الناتج
        اضف(الناتج، السطر)

دالة مع_ملف(المسار، الوضع، الدالة):
    المورد := ملف(المسار، الوضع)
    اذا ليس المورد.فتح():
        ارجع فشل("تعذر فتح الملف: " + المسار)
    القيمة := الدالة(المورد)
    اذا ليس المورد.اغلق():
        ارجع فشل("تعذر إغلاق الملف: " + المسار)
    ارجع نجاح(القيمة)

دالة اكتب_ذريا(المسار، النص):
    # الإنشاء والـfsync والاستبدال الذري عملية نظام واحدة في الطبقة الأصلية.
    ارجع __ملف_اكتب_ذريا__(المسار، النص)

نوع مكرر_اسطر:
    دالة بداية(الملف):
        هذا.الملف := الملف

    دالة التالي():
        السطر := هذا.الملف.اقرا_سطر()
        اذا السطر = عدم:
            ارجع لاشيء()
        ارجع بعض(السطر)
