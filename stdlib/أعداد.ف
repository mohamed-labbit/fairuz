# أعداد مركبة فوق العدد الأساسي. Decimal الحقيقي يحتاج حساباً عشرياً أصلياً.

من رياضيات استورد قاسم_مشترك
من انواع استورد هو_تمثيل

نوع كسر:
    دالة بداية(البسط، المقام):
        اذا المقام = 0: عطل("مقام الكسر لا يمكن أن يكون صفراً ، فالقسمة على صفر غير معرفة")
        القاسم := قاسم_مشترك(البسط، المقام)
        بسط_مختزل := البسط / القاسم
        مقام_مختزل := المقام / القاسم
        اذا مقام_مختزل < 0:
            بسط_مختزل := -بسط_مختزل
            مقام_مختزل := -مقام_مختزل
        هذا.البسط := بسط_مختزل
        هذا.المقام := مقام_مختزل

    دالة حقيقي(): ارجع هذا.البسط / هذا.المقام
    دالة اجمع(الاخر): ارجع كسر(هذا.البسط * الاخر.المقام + الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)
    دالة اطرح(الاخر): ارجع كسر(هذا.البسط * الاخر.المقام - الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)
    دالة اضرب(الاخر): ارجع كسر(هذا.البسط * الاخر.البسط، هذا.المقام * الاخر.المقام)
    دالة اقسم(الاخر): ارجع كسر(هذا.البسط * الاخر.المقام، هذا.المقام * الاخر.البسط)

    دالة نص():
        اذا هذا.المقام = 1: ارجع سلسلة(هذا.البسط)
        ارجع سلسلة(هذا.البسط) + "/" + سلسلة(هذا.المقام)

نوع عشري:
    دالة بداية(القيمة، السياق):
        هذا.المقبض := __عشري_جديد__(القيمة، السياق)
        هذا.السياق := السياق

    دالة اجمع(الاخر): ارجع عشري(__عشري_عملية__("add"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)
    دالة اطرح(الاخر): ارجع عشري(__عشري_عملية__("sub"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)
    دالة اضرب(الاخر): ارجع عشري(__عشري_عملية__("mul"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)
    دالة اقسم(الاخر): ارجع عشري(__عشري_عملية__("div"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)
    دالة نص(): ارجع __عشري_نص__(هذا.المقبض)

نوع عقدي:
    دالة بداية(حقيقي، خيالي):
        هذا.حقيقي := حقيقي
        هذا.خيالي := خيالي

    دالة عملية - (اخر):
        اذا هو_تمثيل(
            اخر،
            "عقدي"
        ): ارجع عقدي(هذا.حقيقي - اخر.حقيقي، هذا.خيالي - اخر.خيالي)
        ارجع عقدي(هذا.حقيقي - اخر، هذا.خيالي)

    دالة عملية + (اخر):
        اذا هو_تمثيل(
            اخر،
            "عقدي"
        ): ارجع عقدي(هذا.حقيقي + اخر.حقيقي، هذا.خيالي + اخر.خيالي)
        ارجع عقدي(هذا.حقيقي + اخر، هذا.خيالي)

    دالة عملية * (اخر):
        اذا هو_تمثيل(اخر، "عقدي"):
            ارجع عقدي(
                هذا.حقيقي * اخر.حقيقي - هذا.خيالي * اخر.خيالي،
                هذا.حقيقي * اخر.خيالي + هذا.خيالي * اخر.حقيقي
            )
        ارجع عقدي(هذا.حقيقي * اخر، هذا.خيالي * اخر)

    دالة عملية / (اخر):
        اذا هو_تمثيل(اخر، "عقدي"):
            اذا اخر.حقيقي = ٠ و اخر.خيالي = ٠:
                عطل("مقام الكسر لا يمكن أن يكون صفراً ، فالقسمة على صفر غير معرفة")
            النتيجة := عقدي(هذا.حقيقي، هذا.خيالي)
            ا := هذا.حقيقي
            ب := هذا.خيالي
            ت := اخر.حقيقي
            ث := اخر.خيالي
            المقام := (ت ** ٢) + (ث ** ٢)
            ارجع عقدي((ا * ت + ب * ث) / المقام، (ب * ت - ا * ث) / المقام)
        ارجع عقدي(هذا.حقيقي / اخر، هذا.خيالي / اخر)

    دالة يساوي(اخر):
        اذا هو_تمثيل(اخر، "عقدي"):
            ارجع هذا.حقيقي = اخر.حقيقي و هذا.خيالي = اخر.خيالي
        ارجع خطا

    دالة قيمة_مطلقة(): ارجع ((هذا.حقيقي ** ٢) + (هذا.خيالي ** ٢)) ** ٠.٥
    دالة مرافق(): ارجع عقدي(هذا.حقيقي، -هذا.خيالي)
    دالة مقلوب(): ارجع هذا.مرافق() / (هذا.قيمة_مطلقة() ** ٢)
