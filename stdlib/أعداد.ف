# أعداد مركبة فوق العدد الأساسي. Decimal الحقيقي يحتاج حساباً عشرياً أصلياً.

من رياضيات استورد قاسم_مشترك

نوع كسر:
    دالة بداية(البسط، المقام):
        اذا المقام = 0:
            عطل("مقام الكسر لا يمكن أن يكون صفراً")
        القاسم := قاسم_مشترك(البسط، المقام)
        بسط_مختزل := البسط / القاسم
        مقام_مختزل := المقام / القاسم
        اذا مقام_مختزل < 0:
            بسط_مختزل := -بسط_مختزل
            مقام_مختزل := -مقام_مختزل
        هذا.البسط := بسط_مختزل
        هذا.المقام := مقام_مختزل

    دالة حقيقي():
        ارجع هذا.البسط / هذا.المقام

    دالة اجمع(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام + الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)

    دالة اطرح(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام - الاخر.البسط * هذا.المقام، هذا.المقام * الاخر.المقام)

    دالة اضرب(الاخر):
        ارجع كسر(هذا.البسط * الاخر.البسط، هذا.المقام * الاخر.المقام)

    دالة اقسم(الاخر):
        ارجع كسر(هذا.البسط * الاخر.المقام، هذا.المقام * الاخر.البسط)

    دالة نص():
        اذا هذا.المقام = 1:
            ارجع سلسلة(هذا.البسط)
        ارجع سلسلة(هذا.البسط) + "/" + سلسلة(هذا.المقام)

نوع عشري:
    دالة بداية(القيمة، السياق):
        هذا.المقبض := __عشري_جديد__(القيمة، السياق)
        هذا.السياق := السياق

    دالة اجمع(الاخر):
        ارجع عشري(__عشري_عملية__("add"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اطرح(الاخر):
        ارجع عشري(__عشري_عملية__("sub"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اضرب(الاخر):
        ارجع عشري(__عشري_عملية__("mul"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة اقسم(الاخر):
        ارجع عشري(__عشري_عملية__("div"، هذا.المقبض، الاخر.المقبض، هذا.السياق)، هذا.السياق)

    دالة نص():
        ارجع __عشري_نص__(هذا.المقبض)
