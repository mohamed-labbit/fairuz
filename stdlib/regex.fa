# محرك التعابير النمطية بدائي أصلي؛ إدارة النمط والنتائج واجهة فيروزية.
# __نمط_اجمع، __نمط_بحث، __نمط_طابق، __نمط_كامل، __نمط_الكل
# __نمط_اقسم، __نمط_استبدل. النتيجة الأصلية قاموس ذو start/end/groups.

نوع تطابق:
    دالة بداية(الخام، النص):
        هذا.الخام := الخام
        هذا.النص := النص

    دالة موجود():
        ارجع هذا.الخام != عدم

    دالة البداية():
        ارجع قاموس_خذ(هذا.الخام، "start"، -1)

    دالة النهاية():
        ارجع قاموس_خذ(هذا.الخام، "end"، -1)

    دالة النص():
        اذا ليس هذا.موجود():
            ارجع عدم
        ارجع جزء(هذا.النص، هذا.البداية()، هذا.النهاية())

    دالة مجموعة(الفهرس):
        اذا ليس هذا.موجود():
            ارجع عدم
        المجموعات := قاموس_خذ(هذا.الخام، "groups"، قائمة())
        اذا الفهرس < 0 او الفهرس >= طول(المجموعات):
            ارجع عدم
        ارجع المجموعات[الفهرس]

    دالة مجموعات():
        ارجع قاموس_خذ(هذا.الخام، "groups"، قائمة())

    دالة مسماة():
        ارجع قاموس_خذ(هذا.الخام، "named"، قاموس())

نوع نمط:
    دالة بداية(المصدر، الاعلام):
        هذا.المصدر := المصدر
        هذا.الاعلام := الاعلام
        هذا.المقبض := __نمط_اجمع(المصدر، الاعلام)
        اذا هذا.المقبض = عدم:
            عطل("تعبير نمطي غير صالح: " + المصدر)

    دالة ابحث(النص، البداية):
        ارجع تطابق(__نمط_بحث(هذا.المقبض، النص، البداية)، النص)

    دالة طابق(النص، البداية):
        ارجع تطابق(__نمط_طابق(هذا.المقبض، النص، البداية)، النص)

    دالة كامل(النص):
        ارجع تطابق(__نمط_كامل(هذا.المقبض، النص)، النص)

    دالة الكل(النص):
        النتائج := قائمة()
        لكل خام في __نمط_الكل(هذا.المقبض، النص):
            اضف(النتائج، تطابق(خام، النص))
        ارجع النتائج

    دالة اقسم(النص، الحد):
        ارجع __نمط_اقسم(هذا.المقبض، النص، الحد)

    دالة استبدل(النص، البديل، الحد):
        ارجع __نمط_استبدل(هذا.المقبض، النص، البديل، الحد)

دالة اجمع_نمط(المصدر):
    ارجع نمط(المصدر، 0)
