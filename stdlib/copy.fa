# النسخ السطحي والعميق؛ لا تُنسخ الموارد والدوال والكائنات غير الحاوية.

من collections استورد انسخ_قائمة
من collections استورد ابحث
من dicts استورد قاموس_انسخ
من dicts استورد قاموس_مفاتيح

دالة نسخ_سطحي(القيمة):
    اذا صنف(القيمة) = "قائمة":
        ارجع انسخ_قائمة(القيمة)
    اذا صنف(القيمة) = "قاموس":
        ارجع قاموس_انسخ(القيمة)
    ارجع القيمة

دالة __نسخ_عميق(القيمة، المصادر، النسخ):
    النوع := صنف(القيمة)
    اذا النوع != "قائمة" و النوع != "قاموس":
        ارجع القيمة

    الموجود := ابحث(المصادر، القيمة)
    اذا الموجود != -1:
        ارجع النسخ[الموجود]

    اذا النوع = "قائمة":
        الناتج := قائمة()
        اضف(المصادر، القيمة)
        اضف(النسخ، الناتج)
        لكل عنصر في القيمة:
            اضف(الناتج، __نسخ_عميق(عنصر، المصادر، النسخ))
        ارجع الناتج

    الناتج := قاموس()
    اضف(المصادر، القيمة)
    اضف(النسخ، الناتج)
    لكل مفتاح في قاموس_مفاتيح(القيمة):
        المفتاح_الجديد := __نسخ_عميق(مفتاح، المصادر، النسخ)
        الناتج[المفتاح_الجديد] := __نسخ_عميق(القيمة[مفتاح]، المصادر، النسخ)
    ارجع الناتج

دالة نسخ_عميق(القيمة):
    ارجع __نسخ_عميق(القيمة، قائمة()، قائمة())
