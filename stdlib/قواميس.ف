# بدائيات مطلوبة من الطبقة الأصلية:
# __قاموس_مفاتيح__(قاموس) -> قائمة
# __قاموس_يحتوي__(قاموس، مفتاح) -> منطقي
# __قاموس_احذف__(قاموس، مفتاح) -> القيمة أو عدم

دالة قاموس_مفاتيح(المعجم):
    ارجع __قاموس_مفاتيح__(المعجم)

دالة قاموس_قيم(المعجم):
    الناتج := []
    لكل مفتاح في __قاموس_مفاتيح__(المعجم):
        اضف(الناتج، المعجم[مفتاح])
    ارجع الناتج

دالة قاموس_عناصر(المعجم):
    الناتج := []
    لكل مفتاح في __قاموس_مفاتيح__(المعجم):
        اضف(الناتج، [مفتاح، المعجم[مفتاح]])
    ارجع الناتج

دالة قاموس_يحتوي(المعجم، المفتاح):
    ارجع __قاموس_يحتوي__(المعجم، المفتاح)

دالة قاموس_خذ(المعجم، المفتاح، البديل):
    اذا __قاموس_يحتوي__(المعجم، المفتاح):
        ارجع المعجم[المفتاح]
    ارجع البديل

دالة قاموس_ضع_ان_غاب(المعجم، المفتاح، القيمة):
    اذا __قاموس_يحتوي__(المعجم، المفتاح):
        ارجع المعجم[المفتاح]
    المعجم[المفتاح] := القيمة
    ارجع القيمة

دالة قاموس_انسخ(المعجم):
    الناتج := قاموس()
    لكل مفتاح في __قاموس_مفاتيح__(المعجم):
        الناتج[مفتاح] := المعجم[مفتاح]
    ارجع الناتج

دالة قاموس_ادمج(الاول، الثاني):
    الناتج := قاموس_انسخ(الاول)
    لكل مفتاح في __قاموس_مفاتيح__(الثاني):
        الناتج[مفتاح] := الثاني[مفتاح]
    ارجع الناتج

دالة قاموس_من_عناصر(العناصر):
    الناتج := قاموس()
    لكل عنصر في العناصر:
        اذا طول(عنصر) != 2:
            عطل("كل عنصر قاموس يجب أن يحوي مفتاحاً وقيمة")
        الناتج[عنصر[0]] := عنصر[1]
    ارجع الناتج

دالة قاموس_حول_القيم(المعجم، الدالة):
    الناتج := قاموس()
    لكل مفتاح في __قاموس_مفاتيح__(المعجم):
        الناتج[مفتاح] := الدالة(المعجم[مفتاح])
    ارجع الناتج

دالة قاموس_رشح(المعجم، الشرط):
    الناتج := قاموس()
    لكل مفتاح في __قاموس_مفاتيح__(المعجم):
        اذا الشرط(مفتاح، المعجم[مفتاح]):
            الناتج[مفتاح] := المعجم[مفتاح]
    ارجع الناتج
