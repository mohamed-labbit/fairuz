# CSV باقتباس مزدوج؛ يقبل CRLF وLF وCR ويحفظها داخل الحقول المقتبسة.

من سلاسل استورد استبدل_الكل
# __نص_من_رمز__(34) يعطينا علامة الاقتباس بلا اعتماد على هروب المحلل.

# الفاصل لا يمكن أن يكون محرفاً يستعمله المحلل للاقتباس أو إنهاء السجل.
# تحقق منه حتى للمدخل الفارغ كي يتفق عقد القارئ والكاتب.
دالة __CSV_تحقق_فاصل__(الفاصل):
    اذا صنف(الفاصل) != "سلسلة": عطل("فاصل CSV يجب أن يكون نصاً")
    اذا طول(الفاصل) != 1: عطل("فاصل CSV يجب أن يكون حرفاً واحداً")
    اذا الفاصل = "\n" او الفاصل = "\r" او الفاصل = __نص_من_رمز__(34):
        عطل("فاصل CSV لا يمكن أن يكون اقتباساً أو نهاية سطر")

دالة CSV_حلل(النص، الفاصل):
    __CSV_تحقق_فاصل__(الفاصل)
    اذا صنف(النص) != "سلسلة": عطل("مدخل CSV يجب أن يكون نصاً")
    اقتباس := __نص_من_رمز__(34)
    الصفوف := قائمة()
    الصف := قائمة()
    الحقل := ""
    مقتبس := خطا
    مغلق := خطا
    بدأ_الحقل := خطا
    فهرس := 0
    طالما فهرس < طول(النص):
        الحرف := جزء(النص، فهرس، فهرس + 1)
        اذا مقتبس:
            اذا الحرف = اقتباس:
                اذا فهرس + 1 < طول(النص) و جزء(النص، فهرس + 1، فهرس + 2) = اقتباس:
                    الحقل += اقتباس
                    فهرس += 1
                غيره:
                    مقتبس := خطا
                    مغلق := صحيح
            غيره:
                الحقل += الحرف
        غيره:
            نهاية_سطر := الحرف = "\n" او الحرف = "\r"
            اذا الحرف = "\r" و فهرس + 1 < طول(النص) و جزء(النص، فهرس + 1، فهرس + 2) = "\n":
                # CRLF نهاية واحدة، ولا نصل إلى هذا الفرع داخل اقتباس.
                فهرس += 1
            اذا الحرف = الفاصل او نهاية_سطر:
                اضف(الصف، الحقل)
                الحقل := ""
                بدأ_الحقل := خطا
                مغلق := خطا
                اذا نهاية_سطر:
                    اضف(الصفوف، الصف)
                    الصف := قائمة()
            غيره:
                اذا مغلق:
                    عطل("محارف بعد إغلاق حقل CSV مقتبس")
                اذا الحرف = اقتباس:
                    اذا بدأ_الحقل:
                        عطل("اقتباس داخل حقل CSV غير مقتبس")
                    مقتبس := صحيح
                غيره:
                    الحقل += الحرف
                بدأ_الحقل := صحيح
        فهرس += 1
    اذا مقتبس:
        عطل("حقل CSV مقتبس لم يغلق")
    اذا بدأ_الحقل او طول(الصف) > 0:
        اضف(الصف، الحقل)
        اضف(الصفوف، الصف)
    ارجع الصفوف

دالة __CSV_رمز_حقل__(الحقل، الفاصل):
    النص := سلسلة(الحقل)
    اقتباس := __نص_من_رمز__(34)
    يحتاج := يحتوي(
        النص،
        الفاصل
    ) او يحتوي(النص، "\n") او يحتوي(النص، "\r") او يحتوي(النص، اقتباس)
    اذا ليس يحتاج:
        ارجع النص
    النص := استبدل_الكل(النص، اقتباس، اقتباس + اقتباس)
    ارجع اقتباس + النص + اقتباس

دالة CSV_رمز(الصفوف، الفاصل):
    __CSV_تحقق_فاصل__(الفاصل)
    اذا صنف(الصفوف) != "قائمة": عطل("صفوف CSV يجب أن تكون قائمة")
    الاسطر := قائمة()
    لكل صف في الصفوف:
        اذا صنف(صف) != "قائمة": عطل("صف CSV يجب أن يكون قائمة")
        # لا يوجد تمثيل يميز صفاً بلا حقول عن ملف فارغ أو حقل فارغ.
        اذا طول(صف) = 0: عطل("صف CSV يجب أن يحتوي حقلاً واحداً على الأقل")
        الحقول := قائمة()
        لكل حقل في صف:
            اضف(الحقول، __CSV_رمز_حقل__(حقل، الفاصل))
        اذا طول(الحقول) = 1 و الحقول[0] = "":
            اقتباس := __نص_من_رمز__(34)
            الحقول[0] := اقتباس + اقتباس
        اضف(الاسطر، اجمع(الحقول، الفاصل))
    ارجع اجمع(الاسطر، "\n")
