# CSV بمعيار RFC 4180، والمنطق مكتوب بفيروز.

من سلاسل استورد ينتهي_ب، ازل_لاحقة، استبدل_الكل
# __نص_من_رمز___(34) يعطينا علامة الاقتباس بلا اعتماد على هروب المحلل.

دالة CSV_حلل(النص، الفاصل):
    اذا طول(الفاصل) != 1:
        عطل("فاصل CSV يجب أن يكون حرفاً واحداً")
    اقتباس := __نص_من_رمز__(34)
    الصفوف := قائمة()
    الصف := قائمة()
    الحقل := ""
    مقتبس := خطا
    مغلق := خطا
    بدأ_الحقل := خطا
    فهرس := 0
    طالما فهرس < طول(النص):
        الحرف := جزء(النص، فهرس، فهرس + 1)
        اذا مقتبس:
            اذا الحرف = اقتباس:
                اذا فهرس + 1 < طول(النص) و جزء(النص، فهرس + 1، فهرس + 2) = اقتباس:
                    الحقل += اقتباس
                    فهرس += 1
                غيره:
                    مقتبس := خطا
                    مغلق := صحيح
            غيره:
                الحقل += الحرف
        غيره:
            نهاية_سطر := الحرف = "\n"
            اذا الحرف = "\r" و فهرس + 1 < طول(النص) و جزء(النص، فهرس + 1، فهرس + 2) = "\n":
                نهاية_سطر := صحيح
                فهرس += 1
            اذا الحرف = الفاصل او نهاية_سطر:
                اضف(الصف، الحقل)
                الحقل := ""
                بدأ_الحقل := خطا
                مغلق := خطا
                اذا نهاية_سطر:
                    اضف(الصفوف، الصف)
                    الصف := قائمة()
            غيره:
                اذا مغلق:
                    عطل("محارف بعد إغلاق حقل CSV مقتبس")
                اذا الحرف = اقتباس:
                    اذا بدأ_الحقل:
                        عطل("اقتباس داخل حقل CSV غير مقتبس")
                    مقتبس := صحيح
                غيره:
                    الحقل += الحرف
                بدأ_الحقل := صحيح
        فهرس += 1
    اذا مقتبس:
        عطل("حقل CSV مقتبس لم يغلق")
    اذا بدأ_الحقل او طول(الصف) > 0:
        اضف(الصف، الحقل)
        اضف(الصفوف، الصف)
    ارجع الصفوف

دالة __CSV_رمز_حقل__(الحقل، الفاصل):
    النص := سلسلة(الحقل)
    اقتباس := __نص_من_رمز__(34)
    يحتاج := يحتوي(النص، الفاصل) او يحتوي(النص، "\n") او يحتوي(النص، "\r") او يحتوي(النص، اقتباس)
    اذا ليس يحتاج:
        ارجع النص
    النص := استبدل_الكل(النص، اقتباس، اقتباس + اقتباس)
    ارجع اقتباس + النص + اقتباس

دالة CSV_رمز(الصفوف، الفاصل):
    الاسطر := قائمة()
    لكل صف في الصفوف:
        الحقول := قائمة()
        لكل حقل في صف:
            اضف(الحقول، __CSV_رمز_حقل__(حقل، الفاصل))
        اذا طول(الحقول) = 1 و الحقول[0] = "":
            اقتباس := __نص_من_رمز__(34)
            الحقول[0] := اقتباس + اقتباس
        اضف(الاسطر، اجمع(الحقول، الفاصل))
    ارجع اجمع(الاسطر، "\n")
