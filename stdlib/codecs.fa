# الترميزات والهاشات تتعامل مع البايتات في الطبقة الأصلية؛ API فيروزية.

دالة base64_رمز(البيانات):
    ارجع __base64_رمز(البيانات، خطا)

دالة base64_URL_رمز(البيانات):
    ارجع __base64_رمز(البيانات، صحيح)

دالة base64_فك(النص):
    ارجع __base64_فك(النص، خطا)

دالة base64_URL_فك(النص):
    ارجع __base64_فك(النص، صحيح)

دالة hex_رمز(البيانات):
    ارجع __hex_رمز(البيانات)

دالة hex_فك(النص):
    ارجع __hex_فك(النص)

نوع هاش:
    دالة بداية(الخوارزمية):
        هذا.الخوارزمية := الخوارزمية
        هذا.المقبض := __هاش_جديد(الخوارزمية)
        اذا هذا.المقبض = عدم:
            عطل("خوارزمية هاش غير مدعومة: " + الخوارزمية)

    دالة حدث(البيانات):
        __هاش_حدث(هذا.المقبض، البيانات)
        ارجع هذا

    دالة بايتات():
        ارجع __هاش_ناتج(هذا.المقبض، خطا)

    دالة نص():
        ارجع __هاش_ناتج(هذا.المقبض، صحيح)

دالة SHA256(البيانات):
    ارجع هاش("sha256").حدث(البيانات).نص()

دالة HMAC(الخوارزمية، المفتاح، البيانات):
    ارجع __HMAC(الخوارزمية، المفتاح، البيانات)
