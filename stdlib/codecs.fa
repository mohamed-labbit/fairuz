# الترميزات والهاشات تتعامل مع البايتات في الطبقة الأصلية؛ API فيروزية.

دالة base64_رمز(البيانات):
    ارجع __64_رمز__(البيانات، خطا)

دالة base64_URL_رمز(البيانات):
    ارجع __64_رمز__(البيانات، صحيح)

دالة base64_فك(النص):
    ارجع __64_فك__(النص، خطا)

دالة base64_URL_فك(النص):
    ارجع __64_فك__(النص، صحيح)

دالة hex_رمز(البيانات):
    ارجع __16_رمز__(البيانات)

دالة hex_فك(النص):
    ارجع __16_فك__(النص)

نوع هاش:
    دالة بداية(الخوارزمية):
        هذا.الخوارزمية := الخوارزمية
        هذا.المقبض := __هاش_جديد__(الخوارزمية)
        اذا هذا.المقبض = عدم:
            عطل("خوارزمية هاش غير مدعومة: " + الخوارزمية)

    دالة حدث(البيانات):
        __هاش_حدث__(هذا.المقبض، البيانات)
        ارجع هذا

    دالة بايتات():
        ارجع __هاش_ناتج__(هذا.المقبض، خطا)

    دالة نص():
        ارجع __هاش_ناتج__(هذا.المقبض، صحيح)

دالة SHA256(البيانات):
    ارجع هاش("sha256").حدث(البيانات).نص()

دالة HMAC(الخوارزمية، المفتاح، البيانات):
    ارجع __HMAC__(الخوارزمية، المفتاح، البيانات)
