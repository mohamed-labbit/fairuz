# ساعة() ووقت() بدائيتان، و__نم(ثوان) هي بدائية الانتظار.

دالة نم(الثواني):
    اذا الثواني < 0:
        عطل("مدة الانتظار لا يمكن أن تكون سالبة")
    ارجع __نم(الثواني)

نوع مؤقت:
    دالة بداية():
        هذا.البداية := ساعة()
        هذا.النهاية := عدم

    دالة اعد():
        هذا.البداية := ساعة()
        هذا.النهاية := عدم
        ارجع هذا

    دالة اوقف():
        هذا.النهاية := ساعة()
        ارجع هذا.المدة()

    دالة المدة():
        اذا هذا.النهاية = عدم:
            ارجع ساعة() - هذا.البداية
        ارجع هذا.النهاية - هذا.البداية

دالة قس(الدالة):
    البداية := ساعة()
    القيمة := الدالة()
    ارجع [القيمة، ساعة() - البداية]
