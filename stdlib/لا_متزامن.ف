# الجدولة والخيوط/حلقة الأحداث بدائيات VM. التركيب والإلغاء في فيروز.

من مجموعات استورد خريطة
# __مهمة_ابدأ، __مهمة_تمت، __مهمة_نتيجة، __مهمة_الغ، __مهمة_انتظر_الكل

نوع مستقبل:
    دالة بداية(المقبض):
        هذا.المقبض := المقبض

    دالة تم():
        ارجع __مهمة_تمت__(هذا.المقبض)

    دالة الغي():
        ارجع __مهمة_الغ__(هذا.المقبض)

    دالة نتيجة(المهلة):
        ارجع __مهمة_نتيجة__(هذا.المقبض، المهلة)

نوع منفذ_مهام:
    دالة بداية(العمال):
        اذا العمال <= 0:
            عطل("عدد العمال يجب أن يكون موجباً")
        هذا.المقبض := __منفذ_جديد__(العمال)
        هذا.المهام := []

    دالة قدم(الدالة، الوسائط):
        المستقبل := مستقبل(__مهمة_ابدأ__(هذا.المقبض، الدالة، الوسائط))
        اضف(هذا.المهام، المستقبل)
        ارجع المستقبل

    دالة انتظر_الكل(المهلة):
        المقابض := خريطة(هذا.المهام، __مستقبل_مقبض__)
        ارجع __مهمة_انتظر_الكل__(المقابض، المهلة)

    دالة اغلق(انتظر):
        ارجع __منفذ_اغلق__(هذا.المقبض، انتظر)

دالة __مستقبل_مقبض__(المستقبل):
    ارجع المستقبل.المقبض
