# مساعدات عامة لا تحتاج وصولاً مباشراً إلى الذاكرة أو النظام.

دالة هو_عدم(القيمة):
    ارجع القيمة = عدم

دالة ليس_عدم(القيمة):
    ارجع القيمة != عدم

دالة هو_فارغ(القيمة):
    ارجع طول(القيمة) = 0

دالة هو_منطقي(القيمة):
    ارجع صنف(القيمة) = "منطقي"

دالة هو_عدد(القيمة):
    النوع := صنف(القيمة)
    ارجع النوع = "طبيعي" او النوع = "حقيقي"

دالة هو_نص(القيمة):
    ارجع صنف(القيمة) = "سلسلة"

دالة هو_قائمة(القيمة):
    ارجع صنف(القيمة) = "قائمة"

دالة هو_قاموس(القيمة):
    ارجع صنف(القيمة) = "قاموس"

دالة هو_دالة(القيمة):
    ارجع صنف(القيمة) = "دالة"

دالة قيمة_او(القيمة، البديل):
    اذا القيمة = عدم:
        ارجع البديل
    ارجع القيمة

دالة غير_مدعوم(الميزة):
    عطل("الميزة غير مدعومة: " + الميزة)

دالة نسخة_المكتبة():
    ارجع "0.2.0"

دالة نوع_هو(القيمة، الاسم):
    ارجع صنف(القيمة) = الاسم

دالة هو_سلسلة(القيمة):
    ارجع صنف(القيمة) = "سلسلة"
