من رياضيات استورد قرب

دالة اختبر_عمليات_بدائية():
    ا := عقدي(١، ١)
    تاكد ((ا + ١) = عقدي(٢، ١))
    تاكد ((ا - ١) = عقدي(٠، ١))
    تاكد ((ا * ١) = عقدي(١، ١))
    تاكد ((ا / ١) = عقدي(١، ١))

دالة اختبر_قيمة_مطلقة():
    تاكد (عقدي(٣، ٤).قيمة_مطلقة() = ٥)
    تاكد (قرب(عقدي(١، ١).قيمة_مطلقة()، 1.4142135623730951، 0.000000001))
    تاكد (عقدي(٠، ٠).قيمة_مطلقة() = ٠)
    تاكد (عقدي(-٣، -٤).قيمة_مطلقة() = ٥)

دالة اختبر_البناء_والمساواة():
    عدد := عقدي(٢، -٣)
    تاكد (عدد.حقيقي = ٢)
    تاكد (عدد.خيالي = -٣)
    تاكد (عدد.يساوي(عقدي(٢، -٣)))
    تاكد (ليس عدد.يساوي(عقدي(٢، ٣)))
    تاكد (ليس عدد.يساوي(٢))
    تاكد (عدد = عقدي(٢، -٣))

دالة اختبر_الجمع_والطرح():
    الاول := عقدي(٢، ٣)
    الثاني := عقدي(٤، -٥)
    تاكد ((الاول + الثاني) = عقدي(٦، -٢))
    تاكد ((الاول - الثاني) = عقدي(-٢، ٨))
    تاكد ((الاول + ٧) = عقدي(٩، ٣))
    تاكد ((الاول - ٧) = عقدي(-٥، ٣))
    تاكد (الاول = عقدي(٢، ٣))
    تاكد (الثاني = عقدي(٤، -٥))

دالة اختبر_الضرب():
    الاول := عقدي(٢، ٣)
    الثاني := عقدي(٤، -٥)
    # (٢ + ٣i)(٤ - ٥i) = ٢٣ + ٢i
    تاكد ((الاول * الثاني) = عقدي(٢٣، ٢))
    تاكد ((الاول * ٢) = عقدي(٤، ٦))
    تاكد ((عقدي(٠، ١) * عقدي(٠، ١)) = عقدي(-١، ٠))
    تاكد (الاول = عقدي(٢، ٣))
    تاكد (الثاني = عقدي(٤، -٥))

دالة اختبر_القسمة():
    الاول := عقدي(٢، ٣)
    الثاني := عقدي(١، ١)
    نتيجة := الاول / الثاني
    تاكد (قرب(نتيجة.حقيقي، ٢.٥، 0.000000001))
    تاكد (قرب(نتيجة.خيالي، ٠.٥، 0.000000001))
    تاكد ((عقدي(٤، ٦) / عقدي(٢، ٠)) = عقدي(٢، ٣))
    تاكد ((عقدي(٤، ٦) / عقدي(٠، ٢)) = عقدي(٣، -٢))
    تاكد ((عقدي(٤، ٦) / ٢) = عقدي(٢، ٣))
    تاكد (الاول = عقدي(٢، ٣))
    تاكد (الثاني = عقدي(١، ١))

دالة اختبر_المرافق():
    تاكد (عقدي(٣، ٤).مرافق() = عقدي(٣، -٤))
    تاكد (عقدي(٣، -٤).مرافق() = عقدي(٣، ٤))
    تاكد (عقدي(٠، ٠).مرافق() = عقدي(٠، ٠))
    عدد := عقدي(٢، ٥)
    تاكد (عدد.مرافق().مرافق() = عدد)
    تاكد ((عدد * عدد.مرافق()) = عقدي(٢٩، ٠))
    تاكد (عدد = عقدي(٢، ٥))

دالة اختبر_المقلوب():
    مقلوب := عقدي(١، ١).مقلوب()
    تاكد (قرب(مقلوب.حقيقي، ٠.٥، 0.000000001))
    تاكد (قرب(مقلوب.خيالي، -٠.٥، 0.000000001))
    تاكد (عقدي(٢، ٠).مقلوب() = عقدي(٠.٥، ٠))
    تاكد (عقدي(٠، ٢).مقلوب() = عقدي(٠، -٠.٥))
    عدد := عقدي(٢، -٣)
    حاصل := عدد * عدد.مقلوب()
    تاكد (قرب(حاصل.حقيقي، ١، 0.000000001))
    تاكد (قرب(حاصل.خيالي، ٠، 0.000000001))
    تاكد (عدد = عقدي(٢، -٣))

