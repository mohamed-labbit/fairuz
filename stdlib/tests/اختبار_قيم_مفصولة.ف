من قيم_مفصولة استورد CSV_حلل، CSV_رمز

دالة اختبر_تحليل_حالات_RFC4180():
    صفوف := CSV_حلل("name,age\nAlice,30\nBob,31\n"، ",")
    تاكد طول(صفوف) = 3
    تاكد صفوف[0][0] = "name"
    تاكد صفوف[1][1] = "30"
    تاكد صفوف[2][0] = "Bob"

    مقتبس := CSV_حلل("a,\"b,c\",\"line1\nline2\"\n"، ",")
    تاكد مقتبس[0][1] = "b,c"
    تاكد مقتبس[0][2] = "line1\nline2"

    مهرب := CSV_حلل("\"a\"\"b\",c\r\n"، ",")
    تاكد مهرب[0][0] = "a\"b"

دالة اختبر_ترميز_الاقتباس_والفواصل_والحقول_الفارغة():
    صفوف := [["a"، "b,c"، "say \"hi\""، ""]، ["last"، "row"]]
    نص := CSV_رمز(صفوف، ",")
    تاكد نص = "a,\"b,c\",\"say \"\"hi\"\"\",\nlast,row"
    تاكد CSV_حلل(نص، ",")[0][1] = "b,c"
    تاكد CSV_حلل(نص، ",")[0][2] = "say \"hi\""

اختبر_تحليل_حالات_RFC4180()
اختبر_ترميز_الاقتباس_والفواصل_والحقول_الفارغة()

# السطر الفارغ سجل ذو حقل فارغ؛ النص الفارغ لا يحتوي أي سجل.
دالة اختبر_حدود_السجلات():
    تاكد CSV_حلل(""، ",") = []
    تاكد CSV_حلل("\n"، ",") = [[""]]
    تاكد CSV_حلل("\r\n\r\n"، ",") = [[""]، [""]]
    تاكد CSV_حلل("a\rb\r"، ",") = [["a"]، ["b"]]
    تاكد CSV_حلل("a,\r\nb,\nc,"، ",") = [["a"، ""]، ["b"، ""]، ["c"، ""]]
    تاكد CSV_حلل("\"a\r\nb\rc\nd\""، ",") = [["a\r\nb\rc\nd"]]
    تاكد CSV_حلل("  a  , b "، ",") = [["  a  "، " b "]]
    تاكد CSV_رمز([]، ",") = ""
    تاكد CSV_رمز([[""]]، ",") = "\"\""
    تاكد CSV_رمز([[1، صحيح]]، ",") = "1," + سلسلة(صحيح)

# حاصل الضرب يفحص الاقتباس والفواصل ويضمن عدم تعديل قوائم الإدخال.
دالة اختبر_دورة_حقول_متنوعة():
    الحقول := [
        ""،
        "plain"،
        "مرحبا🙂"،
        "a,b"،
        "a،b"،
        "a;b"،
        "a\tb"،
        "\""،
        "x\"y"،
        "\r"،
        "\n"،
        "\r\n"،
        " spaced "
    ]
    لكل فاصل في [","، "،"، ";"، "\t"، "🙂"]:
        لكل اول في الحقول:
            لكل ثان في الحقول:
                صفوف := [[اول، ثان]، [""]، [ثان]]
                تاكد (CSV_حلل(CSV_رمز(صفوف، فاصل)، فاصل) = صفوف)
                تاكد (صفوف = [[اول، ثان]، [""]، [ثان]])

اختبر_حدود_السجلات()
اختبر_دورة_حقول_متنوعة()
