من إعدادات استورد اعدادات_INI

دالة اختبر_تحليل_الاقسام_والتعليقات_والفواصل():
    نص := "# comment\n" + "name = Fairuz\n" + "enabled: yes\n" + "\n" + "[server]\n" + "; ignored\n" + "host = localhost\n" + "port: 8080\n"
    اعدادات := اعدادات_INI().حلل(نص)
    تاكد (اعدادات.خذ("default"، "name"، عدم) = "Fairuz")
    تاكد (اعدادات.خذ("default"، "enabled"، عدم) = "yes")
    تاكد (اعدادات.خذ("server"، "host"، عدم) = "localhost")
    تاكد (اعدادات.خذ("server"، "port"، عدم) = "8080")

دالة اختبر_الافتراضي_والبديل_والتعديل():
    اعدادات := اعدادات_INI()
    اعدادات.ضع("default"، "timeout"، 30)
    اعدادات.ضع("dev"، "debug"، صحيح)
    تاكد (اعدادات.خذ("dev"، "timeout"، عدم) = "30")
    تاكد (اعدادات.خذ("dev"، "missing"، "fallback") = "fallback")
    تاكد (اعدادات.خذ("dev"، "debug"، خطا) != عدم)
    تاكد (اعدادات.نص() != "")

اختبر_تحليل_الاقسام_والتعليقات_والفواصل()
اختبر_الافتراضي_والبديل_والتعديل()

دالة اختبر_اول_فاصل_والقيم_الحرفية():
    اعدادات := اعدادات_INI().حلل("url: https://host/path?a=b\nempty=\n[ server ]\nname=first\n[server]\nname: second=last\nvalue = #literal;value\n")
    تاكد (اعدادات.خذ("default"، "url"، عدم) = "https://host/path?a=b")
    تاكد (اعدادات.خذ("default"، "empty"، عدم) = "")
    تاكد (اعدادات.خذ("server"، "name"، عدم) = "second=last")
    تاكد (اعدادات.خذ("server"، "value"، عدم) = "#literal;value")
    تاكد (اعدادات.خذ("missing"، "url"، "fallback") = "fallback")
    # التحليل المتكرر يدمج القيم ويبدأ من القسم الافتراضي في كل استدعاء.
    اعدادات.حلل("fresh=yes\n")
    تاكد (اعدادات.خذ("default"، "fresh"، عدم) = "yes")
    تاكد (اعدادات.خذ("server"، "name"، عدم) = "second=last")

دالة اختبر_ترميز_ثابت_وحفظ_الافتراضي():
    اعدادات := اعدادات_INI()
    اعدادات.ضع("z"، "b"، "2").ضع("default"، "z"، "default-z")
    اعدادات.ضع("a"، "x"، "value=with:delimiters")
    اعدادات.ضع("default"، "a"، "default-a").ضع("z"، "a"، "1")
    النص := "a = default-a\nz = default-z\n\n[a]\nx = value=with:delimiters\n\n[z]\na = 1\nb = 2\n"
    تاكد (اعدادات.نص() = النص)
    مستعاد := اعدادات_INI().حلل(النص)
    تاكد (مستعاد.نص() = النص)
    تاكد (مستعاد.خذ("default"، "z"، عدم) = "default-z")
    تاكد (مستعاد.خذ("a"، "z"، عدم) = "default-z")
    تاكد (مستعاد.خذ("z"، "a"، عدم) = "1")
    تاكد (مستعاد.الاقسام = اعدادات.الاقسام)
    عكسي := اعدادات_INI().ضع("z"، "a"، "1").ضع("default"، "a"، "default-a")
    عكسي.ضع(
        "a"،
        "x"،
        "value=with:delimiters"
    ).ضع("default"، "z"، "default-z").ضع("z"، "b"، "2")
    تاكد (عكسي.نص() = النص)
    تاكد (اعدادات_INI().نص() = "")
    تاكد (اعدادات_INI().حلل("[empty]\r\n").نص() = "[empty]\n")
    تاكد (اعدادات_INI().حلل("name=value\r\n[server]\r\nx=yes\r\n").خذ("server"، "name"، عدم) = "value")
    فارغ := اعدادات_INI().حلل("[empty]\n[default]\nblank=\n")
    تاكد (اعدادات_INI().حلل(فارغ.نص()).خذ("empty"، "blank"، عدم) = "")
    تاكد (اعدادات_INI().حلل("[عربي]\nمفتاح=مرحبا🙂\n").خذ("عربي"، "مفتاح"، عدم) = "مرحبا🙂")

اختبر_اول_فاصل_والقيم_الحرفية()
اختبر_ترميز_ثابت_وحفظ_الافتراضي()
