من functional استورد هوية
من functional استورد طبق
من functional استورد طبق2
من functional استورد كرر_فعل
من functional استورد لكل_عنصر
من functional استورد حتى
من functional استورد جزئي
من functional استورد ركب_دوال
من functional استورد احفظ

قيم_الاختبار := []
حالة_الاختبار := قاموس("value"، 0)
نداءات_الحفظ := قاموس("count"، 0)

دالة زائد_واحد(القيمة):
    ارجع القيمة + 1

دالة جمع(الاول، الثاني):
    ارجع الاول + الثاني

دالة اضف_فهرس(فهرس):
    اضف(قيم_الاختبار، فهرس)

دالة اضف_عشرة(قيمة):
    اضف(قيم_الاختبار، قيمة * 10)

دالة احصل_القيمة():
    ارجع حالة_الاختبار["value"] = 3

دالة زد_القيمة():
    حالة_الاختبار["value"] += 1

دالة بطيئة_محفوظة(القيمة):
    نداءات_الحفظ["count"] += 1
    ارجع القيمة * القيمة

دالة اختبر_التطبيق_والتكرار():
    تاكد(هوية("x") = "x")
    تاكد(طبق(زائد_واحد، 2) = 3)
    تاكد(طبق2(جمع، 2، 3) = 5)
    كرر_فعل(3، اضف_فهرس)
    تاكد(قيم_الاختبار = [0، 1، 2])
    لكل_عنصر([1، 2]، اضف_عشرة)
    تاكد(قيم_الاختبار = [0، 1، 2، 10، 20])

دالة اختبر_حتى():
    حتى(احصل_القيمة، زد_القيمة)
    تاكد(حالة_الاختبار["value"] = 3)

دالة اختبر_التطبيق_الجزئي_والتركيب():
    جزئي_جمع := جزئي(جمع، [10])
    تاكد(جزئي_جمع.نداء([5]) = 15)
    مركب := ركب_دوال([زائد_واحد، زائد_واحد])
    تاكد(مركب.نداء(3) = 5)

دالة اختبر_حفظ_النتائج():
    محفوظة := احفظ(بطيئة_محفوظة، 2)
    تاكد(محفوظة.نداء([4]) = 16)
    تاكد(محفوظة.نداء([4]) = 16)
    تاكد(نداءات_الحفظ["count"] = 1)

اختبر_التطبيق_والتكرار()
اختبر_حتى()
اختبر_التطبيق_الجزئي_والتركيب()
اختبر_حفظ_النتائج()
