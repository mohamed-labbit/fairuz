دالة زد_قيمة(قيمة):
    ارجع قيمة + 1

دالة احتفظ_بالموجب(مفتاح، قيمة):
    ارجع مفتاح > 0

دالة اختبر_التصادم_بين_مفاتيح_متجاورة():
    ا := 9007199254740992
    ب := 9007199254740993
    معجم := قاموس_من_عناصر([[ا، "even"]، [ب، "odd"]، [-ا، "negative even"]، [-ب، "negative odd"]])
    تاكد(طول(معجم) = 4)
    تاكد(قاموس_خذ(معجم، ا، عدم) = "even")
    تاكد(قاموس_خذ(معجم، ب، عدم) = "odd")
    تاكد(قاموس_خذ(معجم، -ب، عدم) = "negative odd")
    تاكد(قاموس_خذ(معجم، 9007199254740992.0، عدم) = "even")
    تاكد(قاموس_ضع_ان_غاب(معجم، ب، "changed") = "odd")
    تاكد(قاموس_ضع_ان_غاب(معجم، ب + 1، "new") = "new")
    تاكد(طول(معجم) = 5)
    تاكد(قاموس_مفاتيح(معجم) = [ا، ب، -ا، -ب، ب + 1])

دالة اختبر_تساوي_مفاتيح_مصنوعة_بمسارات_مختلفة():
    كبير := 18446744073709551616
    معجم := قاموس_من_عناصر([[كبير، 1]، [1 << 64، 2]، [4294967296 * 4294967296، 3]])
    تاكد(طول(معجم) = 1)
    تاكد(معجم[كبير] = 3)
