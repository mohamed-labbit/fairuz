    تاكد(معجم[كبير] = 4)

دالة اختبر_نسخ_ودمج_القيم_الكبيرة():
    كبير := 340282366920938463463374607431768211456
    اصل := قاموس_من_عناصر([[كبير، كبير + 1]، [كبير + 1، كبير - 1]])
    نسخة := قاموس_انسخ(اصل)
    نسخة[كبير] := -كبير
    تاكد(اصل[كبير] = كبير + 1)
    مدموج := قاموس_ادمج(اصل، نسخة)
    تاكد(مدموج[كبير] = -كبير)
    تاكد(مدموج[كبير + 1] = كبير - 1)
    تاكد(طول(مدموج) = 2)
    محول := قاموس_حول_القيم(اصل، زد_قيمة)
    تاكد(محول[كبير] = كبير + 2)
    تاكد(محول[كبير + 1] = كبير)
    تاكد(اصل[كبير + 1] = كبير - 1)

دالة اختبر_الترشيح_والصفر_بعد_الالغاء():
    كبير := 340282366920938463463374607431768211456
    معجم := قاموس_من_عناصر([[-كبير، 1]، [0، 2]، [كبير، 3]])
    مرشح := قاموس_رشح(معجم، احتفظ_بالموجب)
    تاكد(طول(مرشح) = 1)
    تاكد(مرشح[كبير] = 3)
    تاكد(طول(معجم) = 3)
    معجم[كبير - كبير] := 7
    تاكد(طول(معجم) = 3)
    تاكد(معجم[0] = 7)
    تاكد(معجم[-0.0] = 7)
    تاكد(قاموس_خذ(معجم، كبير + 1، "missing") = "missing")

دالة اختبر_الاعادة_الى_القاموس_بعد_كثرة_الترقيات():
    كبير := 340282366920938463463374607431768211456
    معجم := قاموس()
    فهرس := 0
    طالما فهرس < 512:
        معجم[كبير + فهرس] := فهرس
        فهرس += 1
    تاكد(طول(معجم) = 512)
    فهرس := 511
    طالما فهرس >= 0:
        تاكد(معجم[كبير + فهرس] = فهرس)
        فهرس -= 1
    نسخة := قاموس_انسخ(معجم)
    تاكد(نسخة = معجم)
    نسخة[كبير + 511] := -1
    تاكد(معجم[كبير + 511] = 511)

