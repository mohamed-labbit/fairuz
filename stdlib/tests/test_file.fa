من file استورد ملف
من file استورد اقرا_نص_ملف
من file استورد اكتب_نص_ملف
من file استورد اضف_نص_ملف
من file استورد انسخ_ملف
من file استورد اقرا_اسطر_ملف
من file استورد مع_ملف

المسار_الاصلي := "/tmp/fairuz-stdlib-file-test.txt"
المسار_النسخة := "/tmp/fairuz-stdlib-file-test-copy.txt"

دالة اختبر_دورة_حياة_الملف_وقراءة_المؤشر():
    ملف_كتابة := ملف(المسار_الاصلي، "كتابة")
    تاكد(ملف_كتابة.يعمل() = خطا)
    تاكد(ملف_كتابة.فتح())
    تاكد(ملف_كتابة.يعمل())
    تاكد(ملف_كتابة.اكتب_نص("first\nsecond"))
    تاكد(ملف_كتابة.اغلق())
    تاكد(ليس ملف_كتابة.يعمل())

    ملف_قراءة := ملف(المسار_الاصلي، "قراءة")
    تاكد(ملف_قراءة.فتح())
    تاكد(ملف_قراءة.اقرا_سطر() = "first")
    تاكد(ملف_قراءة.اقرا_سطر() = "second")
    تاكد(ملف_قراءة.اقرا_سطر() = عدم)
    تاكد(ملف_قراءة.اغلق())

دالة اختبر_اختصارات_القراءة_والكتابة_والاضافة_والنسخ():
    تاكد(اقرا_نص_ملف(المسار_الاصلي) = "first\nsecond")
    تاكد(اضف_نص_ملف(المسار_الاصلي، "\nthird"))
    تاكد(اقرا_نص_ملف(المسار_الاصلي) = "first\nsecond\nthird")
    تاكد(انسخ_ملف(المسار_الاصلي، المسار_النسخة))
    تاكد(اقرا_نص_ملف(المسار_النسخة) = اقرا_نص_ملف(المسار_الاصلي))
    تاكد(اقرا_اسطر_ملف(المسار_الاصلي) = ["first"، "second"، "third"])

دالة اختبر_غلاف_الاستدعاء_الراجع():
    نتيجة := مع_ملف(المسار_الاصلي، "قراءة"، قراءة_المحتوى)
    تاكد(نتيجة.له_قيمة())
    تاكد(نتيجة.افتح() = "first\nsecond\nthird")

دالة قراءة_المحتوى(المورد):
    ارجع المورد.اقرا_الكل()

اختبر_دورة_حياة_الملف_وقراءة_المؤشر()
اختبر_اختصارات_القراءة_والكتابة_والاضافة_والنسخ()
اختبر_غلاف_الاستدعاء_الراجع()
