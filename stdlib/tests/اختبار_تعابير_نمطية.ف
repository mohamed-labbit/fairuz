من تعابير_نمطية استورد اجمع_نمط
من تعابير_نمطية استورد نمط

دالة اختبر_البحث_والالتقاط():
    البريد := اجمع_نمط("([A-Za-z]+)@([A-Za-z.]+)")
    النص := "راسل layla@example.test الآن"
    التطابق := البريد.ابحث(النص، 0)
    تاكد(التطابق.موجود())
    تاكد(التطابق.النص() = "layla@example.test")
    تاكد(التطابق.مجموعة(1) = "layla")
    تاكد(طول(البريد.الكل("a@b.test و c@d.test")) = 2)

دالة اختبر_المطابقة_والتقسيم_والاستبدال():
    الارقام := نمط("[0-9]+"، 0)
    تاكد(الارقام.كامل("2026").موجود())
    تاكد(الارقام.طابق("2026-fa"، 0).موجود())
    تاكد(طول(الارقام.اقسم("a1b22c"، 10)) = 3)
    تاكد(الارقام.استبدل("a1b22c"، "#"، 1) = "a#b22c")

اختبر_البحث_والالتقاط()
اختبر_المطابقة_والتقسيم_والاستبدال()
