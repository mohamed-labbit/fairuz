من حزمة استورد معلومات_المكتبة
من وقت_التشغيل استورد نسخة_المكتبة

دالة اختبر_هوية_المكتبة_ونسخة_البيانات():
    المعلومات := معلومات_المكتبة()
    تاكد(المعلومات["name"] = "fairuz-stdlib")
    تاكد(المعلومات["version"] = نسخة_المكتبة())
    تاكد(طول(المعلومات["modules"]) >= 30)

    # يجب أن تعيد الدالة نسخة مستقلة لا القاموس العام نفسه.
    المعلومات["name"] := "changed"
    تاكد(معلومات_المكتبة()["name"] = "fairuz-stdlib")

اختبر_هوية_المكتبة_ونسخة_البيانات()
