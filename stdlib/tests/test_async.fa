من async استورد مستقبل
من async استورد منفذ_مهام
من functional استورد هوية

دالة زائد_واحد(القيمة):
    ارجع القيمة + 1

دالة اختبر_دورة_حياة_المستقبل():
    منفذ := منفذ_مهام(1)
    مستقبل := منفذ.قدم(زائد_واحد، [41])
    تاكد(مستقبل.تم())
    تاكد(مستقبل.نتيجة(1000) = 42)
    تاكد(منفذ.انتظر_الكل(1000) != عدم)
    تاكد(منفذ.اغلق(صحيح))

دالة اختبر_المهام_المتعددة_وربط_المقابض():
    منفذ := منفذ_مهام(2)
    الاول := منفذ.قدم(هوية، ["a"])
    الثاني := منفذ.قدم(هوية، ["b"])
    تاكد(منفذ.انتظر_الكل(1000) != عدم)
    تاكد(الاول.نتيجة(1000) = "a")
    تاكد(الثاني.نتيجة(1000) = "b")
    تاكد(منفذ.اغلق(صحيح))

اختبر_دورة_حياة_المستقبل()
اختبر_المهام_المتعددة_وربط_المقابض()
