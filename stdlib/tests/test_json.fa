من json استورد JSON_رمز
من json استورد JSON_حلل

دالة اختبر_ترميز_القيم_الاولية_والحاويات():
    تاكد(JSON_رمز(عدم) = "null")
    تاكد(JSON_رمز(صحيح) = "true")
    تاكد(JSON_رمز(خطا) = "false")
    تاكد(JSON_رمز(42) = "42")
    تاكد(JSON_رمز("hello") = "\"hello\"")
    تاكد(JSON_رمز([1، "x"، خطا]) = "[1,\"x\",false]")
    مشفر := JSON_رمز(قاموس("a"، 1، "b"، صحيح))
    مفكوك := JSON_حلل(مشفر)
    تاكد(مفكوك["a"] = 1)
    تاكد(مفكوك["b"])

دالة اختبر_الهروب_والدورة_الكاملة():
    نص := "quote: \" slash: \\ newline:\n unicode: مرحبا"
    مشفر := JSON_رمز(نص)
    تاكد(JSON_حلل(مشفر) = نص)
    تاكد(JSON_حلل("[ true, false, null, -2.5e1 ]")[3] = -25)

دالة اختبر_المسافات_والقيم_المتداخلة_وموضع_المحلل():
    قيمة := JSON_حلل("  { \"users\" : [ { \"id\" : 1 }, { \"id\" : 2 } ] } \n")
    تاكد(قيمة["users"][0]["id"] = 1)
    تاكد(قيمة["users"][1]["id"] = 2)

اختبر_ترميز_القيم_الاولية_والحاويات()
اختبر_الهروب_والدورة_الكاملة()
اختبر_المسافات_والقيم_المتداخلة_وموضع_المحلل()
