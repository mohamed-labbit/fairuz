من compression استورد اضغط
من compression استورد فك_ضغط
من compression استورد gzip
من compression استورد gunzip

دالة اختبر_دورة_gzip_عند_المستويات_الحدية():
    النص := "Fairuz compression test — " + "abcabcabcabc"
    لكل المستوى في [0، 1، 6، 9]:
        مضغوط := gzip(النص، المستوى)
        تاكد(طول(مضغوط) > 0)
        تاكد(gunzip(مضغوط، 10000) = النص)

دالة اختبر_تطابق_الواجهة_العامة_مع_gzip():
    النص := "generic"
    تاكد(فك_ضغط("gzip"، اضغط("gzip"، النص، 6)، 1000) = النص)

اختبر_دورة_gzip_عند_المستويات_الحدية()
اختبر_تطابق_الواجهة_العامة_مع_gzip()
