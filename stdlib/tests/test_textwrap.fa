من textwrap استورد لف_نص
من textwrap استورد املأ_نص
من textwrap استورد ازح_نص
من textwrap استورد ازل_ازاحة_مشتركة

دالة اختبر_اللف_والازاحة():
    النص := "فيروز لغة عربية واضحة"
    الملفوف := لف_نص(النص، 12)
    تاكد(طول(الملفوف) > 1)
    تاكد(املأ_نص(النص، 12) = اجمع(الملفوف، "\n"))

    مزاح := ازح_نص("سطر أول\nسطر ثان"، "    ")
    تاكد(ازل_ازاحة_مشتركة(مزاح) = "سطر أول\nسطر ثان")

اختبر_اللف_والازاحة()
