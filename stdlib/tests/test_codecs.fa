من codecs استورد base64_رمز
من codecs استورد base64_URL_رمز
من codecs استورد base64_فك
من codecs استورد base64_URL_فك
من codecs استورد hex_رمز
من codecs استورد hex_فك
من codecs استورد هاش
من codecs استورد SHA256
من codecs استورد HMAC

دالة اختبر_دورة_base64_والرابط():
    مشفر := base64_رمز("hello")
    تاكد(مشفر = "aGVsbG8=")
    تاكد(base64_فك(مشفر) = "hello")
    رابط := base64_URL_رمز("hello")
    تاكد(base64_URL_فك(رابط) = "hello")

دالة اختبر_دورة_الترميز_السداسي():
    مشفر := hex_رمز("Hello")
    تاكد(مشفر = "48656c6c6f")
    تاكد(hex_فك(مشفر) = "Hello")

دالة اختبر_التجزئة_التراكمية_والمباشرة():
    كامل := هاش("sha256").حدث("hello ").حدث("world").نص()
    تاكد(كامل = SHA256("hello world"))
    تاكد(كامل = "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9")

دالة اختبر_HMAC_بمتجه_معروف():
    ناتج := HMAC("sha256"، "key"، "The quick brown fox jumps over the lazy dog")
    تاكد(ناتج = "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")

اختبر_دورة_base64_والرابط()
اختبر_دورة_الترميز_السداسي()
اختبر_التجزئة_التراكمية_والمباشرة()
اختبر_HMAC_بمتجه_معروف()
