دالة مربع(القيمة):
    ارجع القيمة * القيمة

دالة زوجي(القيمة):
    ارجع القيمة % 2 = 0

دالة اختبر_المكررات_الاساسية_والنطاقية():
    تاكد(الى_قائمة(كرر([1، 2، 3])) = [1، 2، 3])
    تاكد(الى_قائمة(مدى_كسول(0، 5، 2)) = [0، 2، 4])
    تاكد(الى_قائمة(مكرر_مدى(3، 0، -1)) = [3، 2، 1])

دالة اختبر_التحويل_والترشيح_والاخذ():
    تاكد(الى_قائمة(خريطة_كسولة(كرر([1، 2، 3])، مربع)) = [1، 4، 9])
    تاكد(الى_قائمة(رشح_كسول(كرر([1، 2، 3، 4])، زوجي)) = [2، 4])
    تاكد(الى_قائمة(خذ_كسول(كرر([7، 8، 9])، 2)) = [7، 8])

دالة اختبر_الترقيم_والدمج_والتسلسل():
    تاكد(الى_قائمة(عدد_كسول(كرر(["a"، "b"]), 5)) = [[5، "a"]، [6، "b"]])
    تاكد(الى_قائمة(اربط_كسول(كرر([1، 2])، كرر(["a"]))) = [[1، "a"]])
    تاكد(الى_قائمة(مكرر_سلسلة([كرر([1، 2])، كرر([3])])) = [1، 2، 3])

دالة اختبر_الاختزال_الكسول():
    تاكد(اطو_كسول(كرر([1، 2، 3])، جمع_العدد، 0) = 6)

دالة جمع_العدد(الاول، الثاني):
    ارجع الاول + الثاني

اختبر_المكررات_الاساسية_والنطاقية()
