من datetime استورد مدة
من datetime استورد تاريخ_وقت
من datetime استورد تاريخ_من_حقول
من datetime استورد حلل_تاريخ

دالة اختبر_تحويلات_المدة_وحسابها():
    يوم := مدة(86400)
    تاكد(يوم.ايام() = 1)
    تاكد(يوم.ساعات() = 24)
    تاكد(يوم.دقائق() = 1440)
    تاكد(يوم.اجمع(مدة(3600)).ثوان = 90000)
    تاكد(يوم.اطرح(مدة(3600)).ثوان = 82800)
    تاكد(يوم.اضرب(2).ثوان = 172800)

دالة اختبر_حقول_العصر_وتحويل_المنطقة():
    وقت := تاريخ_وقت(0، "UTC")
    حقول := وقت.حقول()
    تاكد(حقول[0] = 1970)
    تاكد(حقول[1] = 1)
    تاكد(حقول[2] = 1)
    تاكد(وقت.الى_منطقة("UTC").حقول()[0] = 1970)
    تاكد(وقت.اطرح(تاريخ_وقت(-3600، "UTC")).ثوان = 3600)

دالة اختبر_البناء_والتحليل_وتنسيق_ISO():
    وقت := تاريخ_من_حقول(2020، 5، 6، 7، 8، 9، "UTC")
    تاكد(وقت.حقول()[0] = 2020)
    تاكد(وقت.حقول()[1] = 5)
    تاكد(حلل_تاريخ("2020-05-06T07:08:09Z"، "ISO8601"، "UTC").له_قيمة())
    تاكد(وقت.ISO() != "")

اختبر_تحويلات_المدة_وحسابها()
اختبر_حقول_العصر_وتحويل_المنطقة()
اختبر_البناء_والتحليل_وتنسيق_ISO()
