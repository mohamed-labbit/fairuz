من copy استورد نسخ_سطحي
من copy استورد نسخ_عميق

دالة اختبر_النسخ_السطحي_للقيم_دون_هوية_الحاوية():
    اصلي := [1، [2، 3]]
    نسخة := نسخ_سطحي(اصلي)
    تاكد(نسخة[0] = 1)
    تاكد(نسخة[1][1] = 3)
    نسخة[0] := 9
    تاكد(اصلي[0] = 1)

دالة اختبر_النسخ_العميق_وفصل_المراجع_المتداخلة():
    اصلي := قاموس("items"، [1، 2]، "meta"، قاموس("ok"، صحيح))
    نسخة := نسخ_عميق(اصلي)
    تاكد(نسخة["items"][1] = 2)
    تاكد(نسخة["meta"]["ok"])
    نسخة["items"][0] := 99
    نسخة["meta"]["ok"] := خطا
    تاكد(اصلي["items"][0] = 1)
    تاكد(اصلي["meta"]["ok"])

دالة اختبر_اعادة_القيم_الاولية_دون_تغيير():
    تاكد(نسخ_سطحي(42) = 42)
    تاكد(نسخ_عميق("text") = "text")
    تاكد(نسخ_سطحي(عدم) = عدم)

اختبر_النسخ_السطحي_للقيم_دون_هوية_الحاوية()
اختبر_النسخ_العميق_وفصل_المراجع_المتداخلة()
اختبر_اعادة_القيم_الاولية_دون_تغيير()
