من argparse استورد محلل_وسائط

دالة اختبر_القيم_الافتراضية_والوجهات():
    محلل := محلل_وسائط("app"، "demo")
    محلل.اضف_خيار("--verbose"، قاموس("action"، "store_true"، "default"، خطا))
    محلل.اضف_خيار("--count"، قاموس("action"، "count"))
    محلل.اضف_خيار("--name"، قاموس("default"، "guest"))
    محلل.اضف_موضع("input"، قاموس("required"، صحيح))

    الناتج := محلل.حلل(["file.fa"])
    تاكد(الناتج["verbose"] = خطا)
    تاكد(الناتج["count"] = عدم)
    تاكد(الناتج["name"] = "guest")
    تاكد(الناتج["input"] = "file.fa")

دالة اختبر_الخيارات_والبدائل_والقيم_والمواضع():
    محلل := محلل_وسائط("app"، "demo")
    محلل.اضف_خيار("--verbose"، قاموس("aliases"، ["-v"]، "action"، "store_true"))
    محلل.اضف_خيار("--name"، قاموس("dest"، "username"))
    محلل.اضف_خيار("--count"، قاموس("action"، "count"))
    محلل.اضف_موضع("first"، قاموس("required"، صحيح))
    محلل.اضف_موضع("second"، قاموس("default"، "fallback"))

    الناتج := محلل.حلل(["-v"، "--name=alice"، "--count"، "--count"، "one"])
    تاكد(الناتج["verbose"])
    تاكد(الناتج["username"] = "alice")
    تاكد(الناتج["count"] = 2)
    تاكد(الناتج["first"] = "one")
    تاكد(الناتج["second"] = "fallback")

دالة اختبر_تنسيق_المساعدة_والبيانات_الوصفية():
    محلل := محلل_وسائط("tool"، "A useful tool")
    محلل.اضف_خيار("--output"، قاموس("help"، "output path"))
    نص := محلل.مساعدة()
    تاكد(يحتوي(نص، "tool"))
    تاكد(يحتوي(نص، "A useful tool"))
    تاكد(يحتوي(نص، "--output"))
    تاكد(يحتوي(نص، "output path"))

اختبر_القيم_الافتراضية_والوجهات()
اختبر_الخيارات_والبدائل_والقيم_والمواضع()
اختبر_تنسيق_المساعدة_والبيانات_الوصفية()
