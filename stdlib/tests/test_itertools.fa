من itertools استورد مكرر_تكرار
من itertools استورد مكرر_دورة
من itertools استورد كرر_قيمة
من itertools استورد دورة
من itertools استورد حاصل_ديكارتي
من itertools استورد توليفات
من itertools استورد تبديلات

دالة اختبر_التكرار_والدورة():
    مكرر := مكرر_تكرار("x"، 3)
    تاكد(مكرر.التالي().افتح() = "x")
    تاكد(مكرر.التالي().افتح() = "x")
    تاكد(مكرر.التالي().افتح() = "x")
    تاكد(ليس مكرر.التالي().له_قيمة())
    تاكد(كرر_قيمة(7، 0).التالي().له_قيمة() = خطا)

    دورة_م := مكرر_دورة(["a"، "b"])
    تاكد(دورة_م.التالي().افتح() = "a")
    تاكد(دورة_م.التالي().افتح() = "b")
    تاكد(دورة_م.التالي().افتح() = "a")
    تاكد(ليس دورة([]).التالي().له_قيمة())

دالة اختبر_الضرب_الديكارتي_والتوليفات_والتبديلات():
    تاكد(حاصل_ديكارتي([1، 2]، ["a"]) = [[1، "a"]، [2، "a"]])
    تاكد(توليفات([1، 2، 3]، 0) = [[]])
    تاكد(توليفات([1، 2، 3]، 2) = [[1، 2]، [1، 3]، [2، 3]])
    تاكد(توليفات([1، 2]، 3) = [])
    تاكد(تبديلات([]) = [[]])
    تاكد(طول(تبديلات([1، 2، 3])) = 6)

اختبر_التكرار_والدورة()
اختبر_الضرب_الديكارتي_والتوليفات_والتبديلات()
