من data_structures استورد مكدس
من data_structures استورد طابور
من data_structures استورد مجموعة
من data_structures استورد عداد
من data_structures استورد قاموس_افتراضي
من data_structures استورد طابور_اولوية
من data_structures استورد ذاكرة_LRU

دالة صفر():
    ارجع 0

دالة مصنع_قائمة():
    ارجع قائمة()

دالة اختبر_المكدس_والطابور():
    مكدس := مكدس()
    تاكد(مكدس.فارغ())
    تاكد(مكدس.ادفع(1).ادفع(2).الحجم() = 2)
    تاكد(مكدس.قمة() = 2)
    تاكد(مكدس.اسحب() = 2)
    تاكد(مكدس.اسحب() = 1)
    تاكد(مكدس.اسحب() = عدم)

    طابور := طابور()
    تاكد(طابور.اضف_اخر("a").اضف_اخر("b").الحجم() = 2)
    تاكد(طابور.اول() = "a")
    تاكد(طابور.اخرج_اول() = "a")
    تاكد(طابور.اخرج_اول() = "b")
    تاكد(طابور.فارغ())

دالة اختبر_المجموعة_والعداد():
    مجموعة := مجموعة()
    مجموعة.اضف_عنصر("x").اضف_عنصر("x").اضف_عنصر("y")
    تاكد(مجموعة.الحجم() = 2)
    تاكد(مجموعة.يحتوي_عنصر("x"))
    تاكد(مجموعة.احذف_عنصر("x") = صحيح)
    تاكد(ليس مجموعة.يحتوي_عنصر("x"))

    عداد := عداد(["a"، "b"، "a"])
    تاكد(عداد.عدد("a") = 2)
    تاكد(عداد.زد("a"، 3) = 5)
    تاكد(عداد.الاكثر(1)[0][0] = "a")

دالة اختبر_القاموس_الافتراضي():
    افتراضي := قاموس_افتراضي(مصنع_قائمة)
    تاكد(ليس افتراضي.يحتوي("missing"))
    قيمة := افتراضي.خذ("missing")
    اضف(قيمة، 1)
    تاكد(افتراضي.يحتوي("missing"))
    تاكد(افتراضي.خذ("missing")[0] = 1)
    تاكد(افتراضي.ضع("x"، 9) = 9)
    تاكد(افتراضي.خذ("x") = 9)

دالة اختبر_طابور_الاولوية():
    طابور := طابور_اولوية()
    طابور.ادفع(5، "slow").ادفع(1، "fast").ادفع(3، "middle")
    تاكد(طابور.الحجم() = 3)
    تاكد(طابور.قمة()[1] = "fast")
    تاكد(طابور.اسحب()[1] = "fast")
    تاكد(طابور.اسحب()[1] = "middle")
    تاكد(طابور.اسحب()[1] = "slow")
    تاكد(طابور.اسحب() = عدم)

دالة اختبر_ازاحة_LRU_وتحديثها():
    ذاكرة := ذاكرة_LRU(2)
    ذاكرة.ضع("a"، 1)
    ذاكرة.ضع("b"، 2)
    تاكد(ذاكرة.خذ("a").افتح() = 1)
    ذاكرة.ضع("c"، 3)
    تاكد(ذاكرة.خذ("b").له_قيمة() = خطا)
    تاكد(ذاكرة.خذ("a").افتح() = 1)
    تاكد(ذاكرة.احذف("a") = 1)
    ذاكرة.امسح()
    تاكد(ذاكرة.خذ("c").له_قيمة() = خطا)

اختبر_المكدس_والطابور()
اختبر_المجموعة_والعداد()
اختبر_القاموس_الافتراضي()
اختبر_طابور_الاولوية()
اختبر_ازاحة_LRU_وتحديثها()
