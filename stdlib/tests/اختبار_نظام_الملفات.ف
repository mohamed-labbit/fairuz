من نظام_الملفات استورد glob
من نظام_الملفات استورد glob_متكرر
من نظام_الملفات استورد انسخ_مسار
من نظام_الملفات استورد احذف_شجرة
من نظام_الملفات استورد ملف_مؤقت
من نظام_الملفات استورد مجلد_مؤقت
من مسارات استورد مسار

دالة اختبر_دورة_حياة_الملف_المؤقت():
    مؤقت := ملف_مؤقت("fairuz-test-"، ".tmp"، عدم)
    تاكد(مؤقت.المسار.نص() != "")
    تاكد(مؤقت.الملف.يعمل())
    مؤقت.الملف.اكتب_نص("temporary")
    محفوظ := مؤقت.احتفظ()
    تاكد(محفوظ.نص() != "")
    مؤقت.اغلق()
    تاكد(محفوظ.نص() != "")
    احذف_شجرة(محفوظ)

دالة اختبر_دورة_حياة_المجلد_المؤقت():
    مجلد := مجلد_مؤقت("fairuz-dir-"، عدم)
    تاكد(مجلد.المسار.نص() != "")
    محفوظ := مجلد.احتفظ()
    مجلد.اغلق()
    احذف_شجرة(محفوظ)

دالة اختبر_اعادة_المسارات_من_مطابقة_النمط():
    نتائج := glob("/tmp/fairuz-stdlib-file-test-*")
    تاكد(طول(نتائج) >= 0)
    لكل قيمة في نتائج:
        تاكد(قيمة.نص() != "")
    تاكد(طول(glob_متكرر("/tmp/fairuz-stdlib-file-test-*")) >= 0)

اختبر_دورة_حياة_الملف_المؤقت()
اختبر_دورة_حياة_المجلد_المؤقت()
اختبر_اعادة_المسارات_من_مطابقة_النمط()
