من نظام_الملفات استورد glob، glob_متكرر، انسخ_مسار، احذف_شجرة، ملف_مؤقت، مجلد_مؤقت
من مسارات استورد مسار

دالة اختبر_دورة_حياة_الملف_المؤقت():
    مؤقت := ملف_مؤقت("fairuz-test-"، ".tmp"، عدم)
    تاكد مؤقت.المسار.نص() != ""
    تاكد مؤقت.الملف.يعمل()
    مؤقت.الملف.اكتب_نص("temporary")
    محفوظ := مؤقت.احتفظ()
    تاكد محفوظ.نص() != ""
    مؤقت.اغلق()
    تاكد محفوظ.نص() != ""
    احذف_شجرة(محفوظ)

دالة اختبر_دورة_حياة_المجلد_المؤقت():
    مجلد := مجلد_مؤقت("fairuz-dir-"، عدم)
    تاكد مجلد.المسار.نص() != ""
    محفوظ := مجلد.احتفظ()
    مجلد.اغلق()
    احذف_شجرة(محفوظ)

دالة اختبر_اعادة_المسارات_من_مطابقة_النمط():
    مجلد := مجلد_مؤقت("fairuz-glob-test-"، عدم)
    مؤقت := ملف_مؤقت("match-"، ".txt"، مجلد.المسار.نص())
    ملف := مؤقت.احتفظ()
    مؤقت.اغلق()
    فرعي := مجلد_مؤقت("nested-"، مجلد.المسار.نص())
    مؤقت_فرعي := ملف_مؤقت("match-"، ".txt"، فرعي.المسار.نص())
    ملف_فرعي := مؤقت_فرعي.احتفظ()
    مؤقت_فرعي.اغلق()

    نمط := مجلد.المسار.نص() + "/*.txt"
    نتائج := glob(نمط)
    متكررة := glob_متكرر(نمط)
    فرعي.اغلق()
    مجلد.اغلق()

    تاكد طول(نتائج) = 1
    تاكد صنف(نتائج[0]) = "مسار"
    تاكد نتائج[0].نص() = ملف.نص()

    تاكد طول(متكررة) = 2
    تاكد متكررة[0].نص() != متكررة[1].نص()
    لكل قيمة في متكررة:
        تاكد صنف(قيمة) = "مسار"
        تاكد قيمة.نص() = ملف.نص() او قيمة.نص() = ملف_فرعي.نص()

اختبر_دورة_حياة_الملف_المؤقت()
اختبر_دورة_حياة_المجلد_المؤقت()
اختبر_اعادة_المسارات_من_مطابقة_النمط()
