من عناوين_شبكية استورد URL_رمز_استعلام
من عناوين_شبكية استورد URL_حلل_استعلام
من عناوين_شبكية استورد رابط

دالة اختبر_الاستعلام_والرابط():
    الاستعلام := URL_رمز_استعلام(قاموس("بحث"، "لغة فيروز"، "صفحة"، 2))
    المفكوك := URL_حلل_استعلام(الاستعلام)
    تاكد(المفكوك["بحث"] = "لغة فيروز")
    تاكد(المفكوك["صفحة"] = "2")

    الرابط := رابط("https://example.test:443/api?" + الاستعلام)
    تاكد(الرابط.مخطط() = "https")
    تاكد(الرابط.مضيف() = "example.test")
    تاكد(الرابط.منفذ() = 443)
    تاكد(الرابط.مسار() = "/api")
    تاكد(الرابط.نص() = "https://example.test:443/api?" + الاستعلام)

اختبر_الاستعلام_والرابط()
