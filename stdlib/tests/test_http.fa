من http استورد استجابة_HTTP
من http استورد عميل_HTTP
من http استورد HTTP_عميل

دالة اختبر_خصائص_الاستجابة_والحالة():
    خام := قاموس(
        "status"، 201،
        "headers"، قاموس("content-type"، "application/json"، "x-id"، "7")،
        "body"، "{\"ok\":true}",
        "url"، "https://example.test"
    )
    استجابة := استجابة_HTTP(خام)
    تاكد(استجابة.نجحت())
    تاكد(استجابة.نص() = "{\"ok\":true}")
    تاكد(استجابة.راس("x-id"، عدم) = "7")
    تاكد(استجابة.راس("missing"، "fallback") = "fallback")
    تاكد(استجابة.JSON()["ok"])

دالة اختبر_افتراضيات_العميل_وتجاوز_الترويسات():
    عميل := HTTP_عميل()
    تاكد(عميل.الخيارات["timeout"] = 30)
    تاكد(عميل.الخيارات["redirects"] = 5)
    تاكد(عميل.الخيارات["verify_tls"])
    تاكد(عميل.ضع_راس("x-test"، 42) = عميل)
    تاكد(عميل.الرؤوس["x-test"] = "42")

اختبر_خصائص_الاستجابة_والحالة()
اختبر_افتراضيات_العميل_وتجاوز_الترويسات()
