من dicts استورد قاموس_مفاتيح
من dicts استورد قاموس_قيم
من dicts استورد قاموس_عناصر
من dicts استورد قاموس_يحتوي
من dicts استورد قاموس_خذ
من dicts استورد قاموس_ضع_ان_غاب
من dicts استورد قاموس_انسخ
من dicts استورد قاموس_ادمج
من dicts استورد قاموس_من_عناصر
من dicts استورد قاموس_حول_القيم
من dicts استورد قاموس_رشح

دالة مضاعف(القيمة):
    ارجع القيمة * 2

دالة زوجي(المفتاح، القيمة):
    ارجع القيمة % 2 = 0

دالة اختبر_العروض_والبحث():
    معجم := قاموس("a"، 1، "b"، 2)
    تاكد(قاموس_يحتوي(معجم، "a"))
    تاكد(ليس قاموس_يحتوي(معجم، "z"))
    تاكد(قاموس_خذ(معجم، "z"، 9) = 9)
    تاكد(طول(قاموس_مفاتيح(معجم)) = 2)
    تاكد(طول(قاموس_قيم(معجم)) = 2)
    تاكد(قاموس_عناصر(معجم)[0][1] = 1)

دالة اختبر_النسخ_والافتراضي_والدمج_والازواج():
    اصلي := قاموس("a"، 1)
    نسخة := قاموس_انسخ(اصلي)
    نسخة["a"] := 2
    تاكد(اصلي["a"] = 1)
    تاكد(قاموس_ضع_ان_غاب(اصلي، "b"، 3) = 3)
    تاكد(قاموس_ضع_ان_غاب(اصلي، "b"، 4) = 3)
    مدموج := قاموس_ادمج(اصلي، قاموس("a"، 8، "c"، 5))
    تاكد(مدموج["a"] = 8)
    تاكد(مدموج["b"] = 3)
    تاكد(قاموس_من_عناصر([["x"، 1]، ["y"، 2]])["y"] = 2)

دالة اختبر_التحويل_والترشيح():
    معجم := قاموس("a"، 1، "b"، 2، "c"، 3)
    محول := قاموس_حول_القيم(معجم، مضاعف)
    تاكد(محول["a"] = 2)
    تاكد(محول["c"] = 6)
    مرشح := قاموس_رشح(معجم، زوجي)
    تاكد(طول(قاموس_مفاتيح(مرشح)) = 1)
    تاكد(مرشح["b"] = 2)

اختبر_العروض_والبحث()
اختبر_النسخ_والافتراضي_والدمج_والازواج()
اختبر_التحويل_والترشيح()
