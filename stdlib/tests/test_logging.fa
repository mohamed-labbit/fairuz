من logging استورد اسم_مستوى
من logging استورد سجل_حدث
من logging استورد معالج_طرفية
من logging استورد معالج_ملف
من logging استورد مسجل
من logging استورد مسجل_طرفية

المسار := "/tmp/fairuz-stdlib-logging-test.log"

دالة اختبر_اسماء_المستويات_عند_الحدود():
    تاكد(اسم_مستوى(10) = "تتبع")
    تاكد(اسم_مستوى(20) = "تصحيح")
    تاكد(اسم_مستوى(30) = "معلومة")
    تاكد(اسم_مستوى(40) = "تحذير")
    تاكد(اسم_مستوى(50) = "خطأ")
    تاكد(اسم_مستوى(60) = "حرج")
    تاكد(اسم_مستوى(100) = "حرج")

دالة اختبر_تمثيل_الحدث():
    حدث := سجل_حدث("app"، 30، 123، قاموس("request"، "r1"))
    قاموس_الحدث := حدث.قاموس()
    تاكد(قاموس_الحدث["logger"] = "app")
    تاكد(قاموس_الحدث["level"] = "معلومة")
    تاكد(قاموس_الحدث["message"] = "123")
    تاكد(قاموس_الحدث["context"]["request"] = "r1")
    تاكد(يحتوي(حدث.نص()، "app"))
    تاكد(يحتوي(حدث.نص()، "123"))

دالة اختبر_عتبة_المسجل_والسياق_والمعالجات():
    مسجل := مسجل("app"، 30)
    تاكد(ليس مسجل.تتبع("hidden"، قاموس()))
    تاكد(مسجل.مع_سياق(قاموس("request"، "r2")) = مسجل)
    تاكد(مسجل.معلومة("visible"، قاموس()))
    ملفي := معالج_ملف(المسار، خطا)
    تاكد(مسجل.اضف_معالج(ملفي) = مسجل)
    تاكد(مسجل.تحذير("warning"، قاموس()))
    تاكد(ملفي.المسار = المسار)
    تاكد(مسجل_طرفية("console"، 20) != عدم)

اختبر_اسماء_المستويات_عند_الحدود()
اختبر_تمثيل_الحدث()
اختبر_عتبة_المسجل_والسياق_والمعالجات()
