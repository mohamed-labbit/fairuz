# خوارزميات الضغط الأصلية تتعامل مع البايتات؛ API موحد في فيروز.

دالة اضغط(الخوارزمية، البيانات، المستوى):
    ارجع __ضغط(الخوارزمية، البيانات، المستوى)

دالة فك_ضغط(الخوارزمية، البيانات، الحد_الاقصى):
    اذا الحد_الاقصى <= 0:
        عطل("حد فك الضغط يجب أن يكون موجباً")
    ارجع __فك_ضغط(الخوارزمية، البيانات، الحد_الاقصى)

دالة gzip(البيانات، المستوى):
    ارجع اضغط("gzip"، البيانات، المستوى)

دالة gunzip(البيانات، الحد_الاقصى):
    ارجع فك_ضغط("gzip"، البيانات، الحد_الاقصى)
