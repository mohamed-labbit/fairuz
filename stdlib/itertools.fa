# مكافئات itertools ككائنات تكرار كسولة.

من result استورد بعض
من result استورد لاشيء
من collections استورد اسقط
من collections استورد ادمج_قوائم
من collections استورد انسخ_قائمة
من collections استورد احذف_عند

نوع مكرر_تكرار:
    دالة بداية(القيمة، العدد):
        هذا.القيمة := القيمة
        هذا.الباقي := العدد

    دالة التالي():
        اذا هذا.الباقي = 0:
            ارجع لاشيء()
        اذا هذا.الباقي > 0:
            هذا.الباقي -= 1
        ارجع بعض(هذا.القيمة)

نوع مكرر_دورة:
    دالة بداية(القيم):
        هذا.القيم := القيم
        هذا.الفهرس := 0

    دالة التالي():
        اذا طول(هذا.القيم) = 0:
            ارجع لاشيء()
        القيمة := هذا.القيم[هذا.الفهرس]
        هذا.الفهرس := (هذا.الفهرس + 1) % طول(هذا.القيم)
        ارجع بعض(القيمة)

دالة كرر_قيمة(القيمة، العدد):
    ارجع مكرر_تكرار(القيمة، العدد)

دالة دورة(القيم):
    ارجع مكرر_دورة(القيم)

دالة حاصل_ديكارتي(الاول، الثاني):
    الناتج := قائمة()
    لكل ا في الاول:
        لكل ب في الثاني:
            اضف(الناتج، [ا، ب])
    ارجع الناتج

دالة توليفات(القيم، العدد):
    اذا العدد < 0:
        عطل("حجم التوليفة لا يمكن أن يكون سالباً")
    اذا العدد = 0:
        ارجع [[]]
    اذا العدد > طول(القيم):
        ارجع قائمة()
    الناتج := قائمة()
    فهرس := 0
    طالما فهرس <= طول(القيم) - العدد:
        الباقي := اسقط(القيم، فهرس + 1)
        لكل ذيل في توليفات(الباقي، العدد - 1):
            اضف(الناتج، ادمج_قوائم([القيم[فهرس]]، ذيل))
        فهرس += 1
    ارجع الناتج

دالة تبديلات(القيم):
    اذا طول(القيم) = 0:
        ارجع [[]]
    الناتج := قائمة()
    فهرس := 0
    طالما فهرس < طول(القيم):
        الباقي := انسخ_قائمة(القيم)
        الرأس := احذف_عند(الباقي، فهرس)
        لكل ذيل في تبديلات(الباقي):
            اضف(الناتج، ادمج_قوائم([الرأس]، ذيل))
        فهرس += 1
    ارجع الناتج
