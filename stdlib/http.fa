# DNS والمقابس وTLS وHTTP/2 بدائية أصلية واحدة __HTTP_ارسل.

من json استورد JSON_حلل
من json استورد JSON_رمز
من dicts استورد قاموس_خذ
من dicts استورد قاموس_ادمج
من dicts استورد قاموس_انسخ
من result استورد نجاح
من result استورد فشل
# سياسات الطلب، الرؤوس، JSON، إعادة التوجيه، والمهل في فيروز.

نوع استجابة_HTTP:
    دالة بداية(الخام):
        هذا.الحالة := الخام["status"]
        هذا.الرؤوس := الخام["headers"]
        هذا.الجسم := الخام["body"]
        هذا.الرابط := الخام["url"]

    دالة نجحت():
        ارجع هذا.الحالة >= 200 و هذا.الحالة < 400

    دالة نص():
        ارجع هذا.الجسم

    دالة JSON():
        ارجع JSON_حلل(هذا.الجسم)

    دالة راس(الاسم، البديل):
        ارجع قاموس_خذ(هذا.الرؤوس، الاسم، البديل)

نوع عميل_HTTP:
    دالة بداية(الخيارات):
        هذا.الخيارات := الخيارات
        هذا.الرؤوس := قاموس()

    دالة ضع_راس(الاسم، القيمة):
        هذا.الرؤوس[الاسم] := سلسلة(القيمة)
        ارجع هذا

    دالة اطلب(الطريقة، الرابط، الجسم، الرؤوس):
        الكل := قاموس_ادمج(هذا.الرؤوس، الرؤوس)
        الطلب := قاموس(
            "method"، الطريقة،
            "url"، الرابط،
            "body"، الجسم،
            "headers"، الكل،
            "options"، هذا.الخيارات
        )
        الخام := __HTTP_ارسل(الطلب)
        اذا الخام = عدم:
            ارجع فشل("فشل طلب HTTP إلى " + الرابط)
        ارجع نجاح(استجابة_HTTP(الخام))

    دالة خذ(الرابط، الرؤوس):
        ارجع هذا.اطلب("GET"، الرابط، عدم، الرؤوس)

    دالة ارسل(الرابط، الجسم، الرؤوس):
        ارجع هذا.اطلب("POST"، الرابط، الجسم، الرؤوس)

    دالة ارسل_JSON(الرابط، القيمة، الرؤوس):
        الرؤوس := قاموس_انسخ(الرؤوس)
        الرؤوس["content-type"] := "application/json; charset=utf-8"
        ارجع هذا.ارسل(الرابط، JSON_رمز(القيمة)، الرؤوس)

دالة HTTP_عميل():
    ارجع عميل_HTTP(قاموس("timeout"، 30، "redirects"، 5، "verify_tls"، صحيح))
