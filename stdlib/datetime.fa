# التحويل بين التقويم والمنطقة الزمنية وبين epoch بدائيات نظامية.

من result استورد نجاح
من result استورد فشل
# __وقت_الان، __وقت_من_حقول، __وقت_الى_حقول، __وقت_حلل، __وقت_نسق

نوع مدة:
    دالة بداية(ثوان):
        هذا.ثوان := ثوان

    دالة ايام():
        ارجع هذا.ثوان / 86400

    دالة ساعات():
        ارجع هذا.ثوان / 3600

    دالة دقائق():
        ارجع هذا.ثوان / 60

    دالة اجمع(الاخرى):
        ارجع مدة(هذا.ثوان + الاخرى.ثوان)

    دالة اطرح(الاخرى):
        ارجع مدة(هذا.ثوان - الاخرى.ثوان)

    دالة اضرب(المعامل):
        ارجع مدة(هذا.ثوان * المعامل)

نوع تاريخ_وقت:
    دالة بداية(الحقبة، المنطقة):
        هذا.الحقبة := الحقبة
        هذا.المنطقة := المنطقة

    دالة حقول():
        ارجع __وقت_الى_حقول(هذا.الحقبة، هذا.المنطقة)

    دالة نسق(القالب):
        ارجع __وقت_نسق(هذا.الحقبة، هذا.المنطقة، القالب)

    دالة اضف(المدة):
        ارجع تاريخ_وقت(هذا.الحقبة + المدة.ثوان، هذا.المنطقة)

    دالة اطرح(الاخر):
        ارجع مدة(هذا.الحقبة - الاخر.الحقبة)

    دالة الى_منطقة(المنطقة):
        ارجع تاريخ_وقت(هذا.الحقبة، المنطقة)

    دالة ISO():
        ارجع __وقت_نسق(هذا.الحقبة، هذا.المنطقة، "ISO8601")

دالة الان():
    ارجع تاريخ_وقت(__وقت_الان()، "محلي")

دالة الان_UTC():
    ارجع تاريخ_وقت(__وقت_الان()، "UTC")

دالة تاريخ_من_حقول(السنة، الشهر، اليوم، الساعة، الدقيقة، الثانية، المنطقة):
    الحقبة := __وقت_من_حقول(السنة، الشهر، اليوم، الساعة، الدقيقة، الثانية، المنطقة)
    ارجع تاريخ_وقت(الحقبة، المنطقة)

دالة حلل_تاريخ(النص، القالب، المنطقة):
    الحقبة := __وقت_حلل(النص، القالب، المنطقة)
    اذا الحقبة = عدم:
        ارجع فشل("تعذر تحليل التاريخ: " + النص)
    ارجع نجاح(تاريخ_وقت(الحقبة، المنطقة))
