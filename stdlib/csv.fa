# CSV بمعيار RFC 4180، والمنطق مكتوب بفيروز.

من strings استورد ينتهي_ب
من strings استورد ازل_لاحقة
من strings استورد استبدل_الكل
# __نص_من_رمز(34) يعطينا علامة الاقتباس بلا اعتماد على هروب المحلل.

دالة CSV_حلل(النص، الفاصل):
    اذا طول(الفاصل) != 1:
        عطل("فاصل CSV يجب أن يكون حرفاً واحداً")
    اقتباس := __نص_من_رمز(34)
    الصفوف := قائمة()
    الصف := قائمة()
    الحقل := ""
    مقتبس := خطا
    فهرس := 0
    طالما فهرس < طول(النص):
        الحرف := جزء(النص، فهرس، فهرس + 1)
        اذا الحرف = اقتباس:
            اذا مقتبس و فهرس + 1 < طول(النص) و جزء(النص، فهرس + 1، فهرس + 2) = اقتباس:
                الحقل += اقتباس
                فهرس += 2
            غيره:
                مقتبس := ليس مقتبس
                فهرس += 1
        غيره:
            اذا ليس مقتبس و الحرف = الفاصل:
                اضف(الصف، الحقل)
                الحقل := ""
                فهرس += 1
            غيره:
                اذا ليس مقتبس و الحرف = "\n":
                    اذا ينتهي_ب(الحقل، "\r"):
                        الحقل := ازل_لاحقة(الحقل، "\r")
                    اضف(الصف، الحقل)
                    اضف(الصفوف، الصف)
                    الصف := قائمة()
                    الحقل := ""
                    فهرس += 1
                غيره:
                    الحقل += الحرف
                    فهرس += 1
    اذا مقتبس:
        عطل("حقل CSV مقتبس لم يغلق")
    اذا طول(الحقل) > 0 او طول(الصف) > 0:
        اضف(الصف، الحقل)
        اضف(الصفوف، الصف)
    ارجع الصفوف

دالة __CSV_رمز_حقل(الحقل، الفاصل):
    النص := سلسلة(الحقل)
    اقتباس := __نص_من_رمز(34)
    يحتاج := يحتوي(النص، الفاصل) او يحتوي(النص، "\n") او يحتوي(النص، اقتباس)
    اذا ليس يحتاج:
        ارجع النص
    النص := استبدل_الكل(النص، اقتباس، اقتباس + اقتباس)
    ارجع اقتباس + النص + اقتباس

دالة CSV_رمز(الصفوف، الفاصل):
    الاسطر := قائمة()
    لكل صف في الصفوف:
        الحقول := قائمة()
        لكل حقل في صف:
            اضف(الحقول، __CSV_رمز_حقل(حقل، الفاصل))
        اضف(الاسطر، اجمع(الحقول، الفاصل))
    ارجع اجمع(الاسطر، "\n")
