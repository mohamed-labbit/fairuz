# بروتوكول تكرار كسول مستقل عن دعم المولدات في الـVM.

من result استورد بعض
من result استورد لاشيء
# التالي() يعيد خياراً: بعض(قيمة) أو لاشيء().

نوع مكرر_قائمة:
    دالة بداية(القيم):
        هذا.القيم := القيم
        هذا.الفهرس := 0

    دالة التالي():
        اذا هذا.الفهرس >= طول(هذا.القيم):
            ارجع لاشيء()
        القيمة := هذا.القيم[هذا.الفهرس]
        هذا.الفهرس += 1
        ارجع بعض(القيمة)

نوع مكرر_مدى:
    دالة بداية(البداية، النهاية، الخطوة):
        اذا الخطوة = 0:
            عطل("خطوة المدى لا يمكن أن تكون صفراً")
        هذا.الحالي := البداية
        هذا.النهاية := النهاية
        هذا.الخطوة := الخطوة

    دالة التالي():
        انتهى := هذا.الخطوة > 0 و هذا.الحالي >= هذا.النهاية
        اذا هذا.الخطوة < 0 و هذا.الحالي <= هذا.النهاية:
            انتهى := صحيح
        اذا انتهى:
            ارجع لاشيء()
        القيمة := هذا.الحالي
        هذا.الحالي += هذا.الخطوة
        ارجع بعض(القيمة)

نوع مكرر_خريطة:
    دالة بداية(المصدر، الدالة):
        هذا.المصدر := المصدر
        هذا.الدالة := الدالة

    دالة التالي():
        القيمة := هذا.المصدر.التالي()
        اذا ليس القيمة.له_قيمة():
            ارجع القيمة
        ارجع بعض(هذا.الدالة(القيمة.افتح()))

نوع مكرر_ترشيح:
    دالة بداية(المصدر، الشرط):
        هذا.المصدر := المصدر
        هذا.الشرط := الشرط

    دالة التالي():
        طالما صحيح:
            القيمة := هذا.المصدر.التالي()
            اذا ليس القيمة.له_قيمة():
                ارجع القيمة
            اذا هذا.الشرط(القيمة.افتح()):
                ارجع القيمة

نوع مكرر_تعداد:
    دالة بداية(المصدر، البداية):
        هذا.المصدر := المصدر
        هذا.الفهرس := البداية

    دالة التالي():
        القيمة := هذا.المصدر.التالي()
        اذا ليس القيمة.له_قيمة():
            ارجع القيمة
        الزوج := [هذا.الفهرس، القيمة.افتح()]
        هذا.الفهرس += 1
        ارجع بعض(الزوج)

نوع مكرر_ربط:
    دالة بداية(الاول، الثاني):
        هذا.الاول := الاول
        هذا.الثاني := الثاني

    دالة التالي():
        ا := هذا.الاول.التالي()
        ب := هذا.الثاني.التالي()
        اذا ليس ا.له_قيمة() او ليس ب.له_قيمة():
            ارجع لاشيء()
        ارجع بعض([ا.افتح()، ب.افتح()])

نوع مكرر_اخذ:
    دالة بداية(المصدر، العدد):
        هذا.المصدر := المصدر
        هذا.الباقي := اكبر(0، العدد)

    دالة التالي():
        اذا هذا.الباقي = 0:
            ارجع لاشيء()
        القيمة := هذا.المصدر.التالي()
        اذا القيمة.له_قيمة():
            هذا.الباقي -= 1
        ارجع القيمة

نوع مكرر_سلسلة:
    دالة بداية(المصادر):
        هذا.المصادر := المصادر
        هذا.الفهرس := 0

    دالة التالي():
        طالما هذا.الفهرس < طول(هذا.المصادر):
            القيمة := هذا.المصادر[هذا.الفهرس].التالي()
            اذا القيمة.له_قيمة():
                ارجع القيمة
            هذا.الفهرس += 1
        ارجع لاشيء()

دالة كرر(القيم):
    ارجع مكرر_قائمة(القيم)

دالة مدى_كسول(البداية، النهاية، الخطوة):
    ارجع مكرر_مدى(البداية، النهاية، الخطوة)

دالة خريطة_كسولة(المصدر، الدالة):
    ارجع مكرر_خريطة(المصدر، الدالة)

دالة رشح_كسول(المصدر، الشرط):
    ارجع مكرر_ترشيح(المصدر، الشرط)

دالة عدد_كسول(المصدر، البداية):
    ارجع مكرر_تعداد(المصدر، البداية)

دالة اربط_كسول(الاول، الثاني):
    ارجع مكرر_ربط(الاول، الثاني)

دالة خذ_كسول(المصدر، العدد):
    ارجع مكرر_اخذ(المصدر، العدد)

دالة الى_قائمة(المصدر):
    الناتج := قائمة()
    طالما صحيح:
        القيمة := المصدر.التالي()
        اذا ليس القيمة.له_قيمة():
            ارجع الناتج
        اضف(الناتج، القيمة.افتح())

دالة اطو_كسول(المصدر، الدالة، البداية):
    الناتج := البداية
    طالما صحيح:
        القيمة := المصدر.التالي()
        اذا ليس القيمة.له_قيمة():
            ارجع الناتج
        الناتج := الدالة(الناتج، القيمة.افتح())
