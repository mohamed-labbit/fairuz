# تنسيق رسائل الطرفية فوق اكتب؛ إخراج البايتات نفسه يبقى أصلياً.

دالة معلومة(الرسالة):
    اكتب("[معلومة] " + سلسلة(الرسالة))

دالة تحذير(الرسالة):
    اكتب("[تحذير] " + سلسلة(الرسالة))

دالة خطا_سجل(الرسالة):
    اكتب("[خطأ] " + سلسلة(الرسالة))

دالة اطبع_قائمة(القيم):
    لكل قيمة في القيم:
        اكتب(قيمة)
