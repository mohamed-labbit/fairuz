# إحصاء وصفي مكتوب بالكامل بفيروز فوق خوارزميات القوائم.

من collections استورد مجموع
من collections استورد رتب
من collections استورد فريد
من collections استورد عدد

دالة متوسط(القيم):
    اذا طول(القيم) = 0:
        عطل("لا يوجد متوسط لقائمة فارغة")
    ارجع مجموع(القيم) / طول(القيم)

دالة وسيط(القيم):
    اذا طول(القيم) = 0:
        عطل("لا يوجد وسيط لقائمة فارغة")
    المرتبة := رتب(القيم)
    الوسط := ادنى(طول(المرتبة) / 2)
    اذا طول(المرتبة) % 2 = 1:
        ارجع المرتبة[الوسط]
    ارجع (المرتبة[الوسط - 1] + المرتبة[الوسط]) / 2

دالة تباين(القيم):
    اذا طول(القيم) = 0:
        عطل("لا يوجد تباين لقائمة فارغة")
    المركز := متوسط(القيم)
    المجموع := 0
    لكل قيمة في القيم:
        الفرق := قيمة - المركز
        المجموع += الفرق * الفرق
    ارجع المجموع / طول(القيم)

دالة انحراف_معياري(القيم):
    ارجع جذر(تباين(القيم))

دالة منوال(القيم):
    اذا طول(القيم) = 0:
        ارجع عدم
    الافضل := القيم[0]
    افضل_عدد := 0
    لكل قيمة في فريد(القيم):
        التكرار := عدد(القيم، قيمة)
        اذا التكرار > افضل_عدد:
            الافضل := قيمة
            افضل_عدد := التكرار
    ارجع الافضل

دالة مجموع_تراكمي(القيم):
    الناتج := قائمة()
    الحالي := 0
    لكل قيمة في القيم:
        الحالي += قيمة
        اضف(الناتج، الحالي)
    ارجع الناتج

دالة كمية(القيم، النسبة):
    اذا طول(القيم) = 0:
        عطل("لا توجد كمية لقائمة فارغة")
    اذا النسبة < 0 او النسبة > 1:
        عطل("نسبة الكمية يجب أن تكون بين صفر وواحد")
    المرتبة := رتب(القيم)
    الموضع := النسبة * (طول(المرتبة) - 1)
    الادنى := ادنى(الموضع)
    الاعلى := اعلى(الموضع)
    اذا الادنى = الاعلى:
        ارجع المرتبة[الادنى]
    الوزن := الموضع - الادنى
    ارجع المرتبة[الادنى] * (1 - الوزن) + المرتبة[الاعلى] * الوزن

دالة رباعيات(القيم):
    ارجع [كمية(القيم، 0.25)، كمية(القيم، 0.5)، كمية(القيم، 0.75)]

دالة تغاير(الاول، الثاني):
    اذا طول(الاول) = 0 او طول(الاول) != طول(الثاني):
        عطل("التغاير يحتاج قائمتين غير فارغتين ومتساويتين")
    وسط_الاول := متوسط(الاول)
    وسط_الثاني := متوسط(الثاني)
    الناتج := 0
    فهرس := 0
    طالما فهرس < طول(الاول):
        الناتج += (الاول[فهرس] - وسط_الاول) * (الثاني[فهرس] - وسط_الثاني)
        فهرس += 1
    ارجع الناتج / طول(الاول)

دالة ارتباط(الاول، الثاني):
    المقام := انحراف_معياري(الاول) * انحراف_معياري(الثاني)
    اذا المقام = 0:
        عطل("الارتباط غير معرّف عند انحراف معياري صفري")
    ارجع تغاير(الاول، الثاني) / المقام

دالة انحدار_خطي(السيني، الصادي):
    اذا طول(السيني) = 0 او طول(السيني) != طول(الصادي):
        عطل("الانحدار يحتاج قائمتين غير فارغتين ومتساويتين")
    تباين_س := تباين(السيني)
    اذا تباين_س = 0:
        عطل("لا يمكن الانحدار على قيم سينية ثابتة")
    الميل := تغاير(السيني، الصادي) / تباين_س
    التقاطع := متوسط(الصادي) - الميل * متوسط(السيني)
    ارجع قاموس("slope"، الميل، "intercept"، التقاطع، "r"، ارتباط(السيني، الصادي))
