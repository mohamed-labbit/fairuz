# محلل معاملات declarative قريب من argparse، والمنطق كله بفيروز.

من قواميس استورد قاموس_انسخ، قاموس_خذ
من سلاسل استورد استبدل_الكل، ازل_سابقة، يبدا_ب، افصل_مرة، حشو_يمين
من مجموعات استورد ابحث
من دوالية استورد هوية

نوع محلل_وسائط:
    دالة بداية(الاسم، الوصف):
        هذا.الاسم := الاسم
        هذا.الوصف := الوصف
        هذا.الخيارات := قائمة()
        هذا.المواضع := قائمة()

    دالة اضف_خيار(الاسم، الاعدادات):
        التعريف := قاموس_انسخ(الاعدادات)
        التعريف["name"] := الاسم
        التعريف["dest"] := قاموس_خذ(التعريف، "dest"، استبدل_الكل(ازل_سابقة(الاسم، "--")، "-"، "_"))
        اضف(هذا.الخيارات، التعريف)
        ارجع هذا

    دالة اضف_موضع(الاسم، الاعدادات):
        التعريف := قاموس_انسخ(الاعدادات)
        التعريف["name"] := الاسم
        اضف(هذا.المواضع، التعريف)
        ارجع هذا

    دالة __جد_خيار__(الاسم):
        لكل تعريف في هذا.الخيارات:
            اذا تعريف["name"] = الاسم:
                ارجع تعريف
            البدائل := قاموس_خذ(تعريف، "aliases"، قائمة())
            اذا ابحث(البدائل، الاسم) != -1:
                ارجع تعريف
        ارجع عدم

    دالة حلل(الوسائط):
        الناتج := قاموس()
        لكل تعريف في هذا.الخيارات:
            الوجهة := تعريف["dest"]
            الناتج[الوجهة] := قاموس_خذ(تعريف، "default"، عدم)

        موضع := 0
        فهرس := 0
        طالما فهرس < طول(الوسائط):
            الوسيط := الوسائط[فهرس]
            اذا يبدا_ب(الوسيط، "-"):
                زوج := افصل_مرة(الوسيط، "=")
                تعريف := هذا.__جد_خيار__(زوج[0])
                اذا تعريف = عدم:
                    عطل("خيار غير معروف: " + زوج[0])
                الوجهة := تعريف["dest"]
                الفعل := قاموس_خذ(تعريف، "action"، "store")
                اذا الفعل = "store_true":
                    الناتج[الوجهة] := صحيح
                غيره:
                    اذا الفعل = "count":
                        العدد := قاموس_خذ(الناتج، الوجهة، 0)
                        اذا العدد = عدم:
                            العدد := 0
                        الناتج[الوجهة] := العدد + 1
                    غيره:
                        القيمة := زوج[2]
                        اذا زوج[1] = "":
                            فهرس += 1
                            اذا فهرس >= طول(الوسائط):
                                عطل("الخيار يحتاج قيمة: " + زوج[0])
                            القيمة := الوسائط[فهرس]
                        المحول := قاموس_خذ(تعريف، "type"، هوية)
                        الناتج[الوجهة] := المحول(القيمة)
            غيره:
                اذا موضع >= طول(هذا.المواضع):
                    عطل("وسيط موضعي زائد: " + الوسيط)
                تعريف := هذا.المواضع[موضع]
                المحول := قاموس_خذ(تعريف، "type"، هوية)
                الناتج[تعريف["name"]] := المحول(الوسيط)
                موضع += 1
            فهرس += 1

        طالما موضع < طول(هذا.المواضع):
            تعريف := هذا.المواضع[موضع]
            اذا قاموس_خذ(تعريف، "required"، صحيح):
                عطل("وسيط مطلوب مفقود: " + تعريف["name"])
            الناتج[تعريف["name"]] := قاموس_خذ(تعريف، "default"، عدم)
            موضع += 1
        ارجع الناتج

    دالة مساعدة():
        الاسطر := [هذا.الاسم + " — " + هذا.الوصف، ""]
        لكل تعريف في هذا.الخيارات:
            الاسم := تعريف["name"]
            الوصف := قاموس_خذ(تعريف، "help"، "")
            اضف(الاسطر، "  " + حشو_يمين(الاسم، 24، " ") + الوصف)
        ارجع اجمع(الاسطر، "\n")
