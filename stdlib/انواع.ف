دالة نوع_هذا(شيء):
    ارجع __نوع__(شيء)

دالة هو_تمثيل(شيء، ن):
    ارجع __تمثيل__(شيء، ن)

دالة قابل_للنداء(شيء):
    ارجع __قابل_للنداء__(شيء)

دالة هو_فارغ(شيء):
    اذا __تمثيل__(شيء، قائمة) او __تمثيل__(شيء، قاموس) او __تمثيل__(شيء، سلسلة):
        ارجع طول(شيء) = ٠
    ارجع عطل("الشيء المطلوب طوله غير قابل للقياس، و نوععه هو " + صنف(شيء))

    