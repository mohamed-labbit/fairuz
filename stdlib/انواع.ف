دالة نوع_هذا(شيء):
    ارجع __نوع__(شيء)

دالة هو_تمثيل(شيء، ن):
    اذا ليس صنف(ن) = "سلسلة":
        عطل("المعطى الثاني يجب أن يكون سلسلة")
    ارجع صنف(شيء) = ن

دالة قابل_للنداء(شيء):
    ارجع __قابل_للنداء__(شيء)

دالة هو_فارغ(شيء):
    اذا هو_تمثيل(شيء، قائمة) او هو_تمثيل(شيء، قاموس) او هو_تمثيل(شيء، سلسلة):
        ارجع طول(شيء) = ٠
    ارجع عطل("الشيء المطلوب طوله غير قابل للقياس، و نوععه هو " + صنف(شيء))
