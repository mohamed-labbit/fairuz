# قارئ/كاتب INI عالي المستوى، يحافظ على الأقسام والقيم النصية.

من سلاسل استورد اسطر، يبدا_ب، ينتهي_ب، موضع_نص
من قواميس استورد قاموس_ضع_ان_غاب، قاموس_مفاتيح، قاموس_خذ
من ملفات استورد اقرا_نص_ملف
من نتيجة استورد نجاح، فشل
من مجموعات استورد رتب

# الأسماء المكتوبة برمجياً يجب أن تقرأ كما هي دون قص أو تغيير بنية الملف.
دالة __INI_تحقق_قسم__(القسم):
    اذا صنف(القسم) != "سلسلة": عطل("اسم قسم INI يجب أن يكون نصاً")
    اذا (
        القسم = "" او قص(القسم) != القسم
        او يحتوي(القسم، "[") او يحتوي(القسم، "]")
        او يحتوي(القسم، "\n") او يحتوي(القسم، "\r")):
        عطل("اسم قسم INI غير صالح")

دالة __INI_تحقق_مفتاح__(المفتاح):
    اذا صنف(المفتاح) != "سلسلة": عطل("مفتاح INI يجب أن يكون نصاً")
    اذا (
        المفتاح = "" او قص(المفتاح) != المفتاح
        او يحتوي(المفتاح، "=") او يحتوي(المفتاح، ":")
        او يحتوي(المفتاح، "\n") او يحتوي(المفتاح، "\r")
        او يبدا_ب(المفتاح، "[") او يبدا_ب(المفتاح، "#")
        او يبدا_ب(المفتاح، ";")):
        عطل("مفتاح INI غير صالح")

دالة __INI_اسطر_قسم__(القيم):
    الاسطر := []
    لكل مفتاح في رتب(قاموس_مفاتيح(القيم)):
        __INI_تحقق_مفتاح__(مفتاح)
        القيمة := القيم[مفتاح]
        # لا يدعم هذا التنسيق اقتباساً أو استمراراً متعدد الأسطر؛ ارفض الفقد الصامت.
        اذا صنف(القيمة) != "سلسلة": عطل("قيمة INI يجب أن تكون نصاً")
        اذا قص(القيمة) != القيمة او يحتوي(القيمة، "\n") او يحتوي(القيمة، "\r"):
            عطل("قيمة INI لا يمكن تمثيلها دون فقد")
        اضف(الاسطر، مفتاح + " = " + القيمة)
    ارجع الاسطر

نوع اعدادات_INI:
    دالة بداية(): هذا.الاقسام := قاموس("default"، قاموس())

    دالة حلل(النص):
        القسم := "default"
        لكل سطر في اسطر(النص):
            سطر := قص(سطر)
            اذا طول(سطر) > 0 و ليس يبدا_ب(سطر، "#") و ليس يبدا_ب(سطر، ";"):
                اذا يبدا_ب(سطر، "["):
                    اذا ليس ينتهي_ب(سطر، "]"): عطل("عنوان قسم INI غير صالح")
                    القسم := قص(جزء(سطر، 1، طول(سطر) - 1))
                    __INI_تحقق_قسم__(القسم)
                    قاموس_ضع_ان_غاب(هذا.الاقسام، القسم، قاموس())
                غيره:
                    # اختر أول فاصل؛ علامة = داخل قيمة بدأت بـ : جزء من القيمة.
                    الموضع := موضع_نص(سطر، "="، 0)
                    نقطتان := موضع_نص(سطر، ":"، 0)
                    اذا نقطتان >= 0 و (الموضع < 0 او نقطتان < الموضع): الموضع := نقطتان
                    اذا الموضع < 0: عطل("سطر إعداد غير صالح: " + سطر)
                    المفتاح := قص(جزء(سطر، 0، الموضع))
                    __INI_تحقق_مفتاح__(المفتاح)
                    هذا.الاقسام[القسم][المفتاح] := قص(جزء(سطر، الموضع + 1، طول(سطر)))
        ارجع هذا

    دالة اقسام(): ارجع قاموس_مفاتيح(هذا.الاقسام)

    دالة خذ(القسم، المفتاح، البديل):
        اذا ليس __قاموس_يحتوي__(هذا.الاقسام، القسم): ارجع البديل
        اذا __قاموس_يحتوي__(
            هذا.الاقسام[القسم]،
            المفتاح
        ): ارجع هذا.الاقسام[القسم][المفتاح]
        ارجع قاموس_خذ(هذا.الاقسام["default"]، المفتاح، البديل)

    دالة ضع(القسم، المفتاح، القيمة):
        __INI_تحقق_قسم__(القسم)
        __INI_تحقق_مفتاح__(المفتاح)
        قاموس_ضع_ان_غاب(هذا.الاقسام، القسم، قاموس())
        هذا.الاقسام[القسم][المفتاح] := سلسلة(القيمة)
        ارجع هذا

    دالة نص():
        # الافتراضي أولاً: أي زوج بعد عنوان قسم ينتمي لذلك القسم عند إعادة القراءة.
        الاسطر := __INI_اسطر_قسم__(هذا.الاقسام["default"])
        اذا طول(الاسطر) > 0: اضف(الاسطر، "")
        لكل قسم في رتب(قاموس_مفاتيح(هذا.الاقسام)):
            اذا قسم != "default":
                __INI_تحقق_قسم__(قسم)
                اضف(الاسطر، "[" + قسم + "]")
                لكل سطر في __INI_اسطر_قسم__(هذا.الاقسام[قسم]): اضف(الاسطر، سطر)
                اضف(الاسطر، "")
        ارجع اجمع(الاسطر، "\n")

دالة اقرا_INI(المسار):
    النص := اقرا_نص_ملف(المسار)
    اذا النص = عدم:
        ارجع فشل("تعذر قراءة ملف الإعدادات")
    ارجع نجاح(اعدادات_INI().حلل(النص))
