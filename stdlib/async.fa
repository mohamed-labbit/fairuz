# الجدولة والخيوط/حلقة الأحداث بدائيات VM. التركيب والإلغاء في فيروز.

من collections استورد خريطة
# __مهمة_ابدأ، __مهمة_تمت، __مهمة_نتيجة، __مهمة_الغ، __مهمة_انتظر_الكل

نوع مستقبل:
    دالة بداية(المقبض):
        هذا.المقبض := المقبض

    دالة تم():
        ارجع __مهمة_تمت(هذا.المقبض)

    دالة الغي():
        ارجع __مهمة_الغ(هذا.المقبض)

    دالة نتيجة(المهلة):
        ارجع __مهمة_نتيجة(هذا.المقبض، المهلة)

نوع منفذ_مهام:
    دالة بداية(العمال):
        اذا العمال <= 0:
            عطل("عدد العمال يجب أن يكون موجباً")
        هذا.المقبض := __منفذ_جديد(العمال)
        هذا.المهام := قائمة()

    دالة قدم(الدالة، الوسائط):
        المستقبل := مستقبل(__مهمة_ابدأ(هذا.المقبض، الدالة، الوسائط))
        اضف(هذا.المهام، المستقبل)
        ارجع المستقبل

    دالة انتظر_الكل(المهلة):
        المقابض := خريطة(هذا.المهام، __مستقبل_مقبض)
        ارجع __مهمة_انتظر_الكل(المقابض، المهلة)

    دالة اغلق(انتظر):
        ارجع __منفذ_اغلق(هذا.المقبض، انتظر)

دالة __مستقبل_مقبض(المستقبل):
    ارجع المستقبل.المقبض
