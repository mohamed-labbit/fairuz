# البدائيات الأصلية الوحيدة هنا هي مصدر العشوائية والبذرة.

من collections استورد انسخ_قائمة
من collections استورد خذ
# __عشوائي_وحدة() -> عدد حقيقي في [0، 1)
# __عشوائي_بذرة(عدد) -> عدم

دالة ضع_بذرة(البذرة):
    __عشوائي_بذرة(البذرة)

دالة عشوائي():
    ارجع __عشوائي_وحدة()

دالة عشوائي_بين(الادنى، الاعلى):
    اذا الادنى > الاعلى:
        عطل("الحد الأدنى العشوائي أكبر من الحد الأعلى")
    ارجع الادنى + ادنى(__عشوائي_وحدة() * (الاعلى - الادنى + 1))

دالة اختيار(القيم):
    اذا طول(القيم) = 0:
        عطل("لا يمكن الاختيار من قائمة فارغة")
    ارجع القيم[عشوائي_بين(0، طول(القيم) - 1)]

دالة اخلط(القيم):
    الناتج := انسخ_قائمة(القيم)
    فهرس := طول(الناتج) - 1
    طالما فهرس > 0:
        اخر := عشوائي_بين(0، فهرس)
        مؤقت := الناتج[فهرس]
        الناتج[فهرس] := الناتج[اخر]
        الناتج[اخر] := مؤقت
        فهرس -= 1
    ارجع الناتج

دالة عينة(القيم، العدد):
    اذا العدد < 0 او العدد > طول(القيم):
        عطل("حجم العينة خارج النطاق")
    ارجع خذ(اخلط(القيم)، العدد)
