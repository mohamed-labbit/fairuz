# طبقة اختبار صغيرة؛ عطل() هي بدائية رفع الخطأ.

من collections استورد ابحث

دالة تاكد_يساوي(الفعلي، المتوقع):
    اذا الفعلي != المتوقع:
        عطل("فشل التأكد: " + سلسلة(الفعلي) + " != " + سلسلة(المتوقع))
    ارجع صحيح

دالة تاكد_لا_يساوي(الفعلي، المتوقع):
    اذا الفعلي = المتوقع:
        عطل("فشل التأكد: القيمتان متساويتان")
    ارجع صحيح

دالة تاكد_صحيح(الشرط):
    اذا ليس الشرط:
        عطل("فشل التأكد: الشرط غير صحيح")
    ارجع صحيح

دالة تاكد_خطا(الشرط):
    اذا الشرط:
        عطل("فشل التأكد: الشرط صحيح")
    ارجع صحيح

دالة تاكد_عدم(القيمة):
    اذا القيمة != عدم:
        عطل("فشل التأكد: القيمة ليست عدم")
    ارجع صحيح

دالة تاكد_نوع(القيمة، النوع):
    اذا صنف(القيمة) != النوع:
        عطل("فشل التأكد: النوع " + صنف(القيمة) + " وليس " + النوع)
    ارجع صحيح

دالة تاكد_يحتوي(المجموعة، القيمة):
    اذا صنف(المجموعة) = "سلسلة":
        اذا ليس يحتوي(المجموعة، القيمة):
            عطل("فشل التأكد: النص لا يحتوي القيمة")
        ارجع صحيح
    اذا ابحث(المجموعة، القيمة) = -1:
        عطل("فشل التأكد: المجموعة لا تحتوي القيمة")
    ارجع صحيح

دالة تاكد_قريب(الفعلي، المتوقع، السماح):
    اذا مطلق(الفعلي - المتوقع) > السماح:
        عطل("فشل التأكد: الفرق أكبر من السماح")
    ارجع صحيح

دالة تاكد_يرفع(الدالة):
    # البدائية تشغّل الدالة داخل حاجز خطأ VM وتعيد وصف الخطأ أو عدم.
    الخطا := __اختبار_التقط(الدالة)
    اذا الخطا = عدم:
        عطل("فشل التأكد: لم يرفع الاستدعاء خطأ")
    ارجع الخطا

نوع مجموعة_اختبار:
    دالة بداية(الاسم):
        هذا.الاسم := الاسم
        هذا.الحالات := قائمة()

    دالة اضف_حالة(الاسم، الدالة):
        اضف(هذا.الحالات، [الاسم، الدالة])
        ارجع هذا

    دالة شغل():
        النتائج := قائمة()
        لكل حالة في هذا.الحالات:
            الخام := __اختبار_نفذ(حالة[1])
            الخام["suite"] := هذا.الاسم
            الخام["test"] := حالة[0]
            اضف(النتائج، الخام)
        ارجع النتائج

دالة تقرير_اختبارات(النتائج):
    نجح := 0
    فشل_عدد := 0
    لكل نتيجة_اختبار في النتائج:
        اذا نتيجة_اختبار["ok"]:
            نجح += 1
        غيره:
            فشل_عدد += 1
            اكتب("فشل " + نتيجة_اختبار["suite"] + "." + نتيجة_اختبار["test"])
            اكتب("  " + نتيجة_اختبار["error"])
    اكتب(سلسلة(نجح) + " نجح، " + سلسلة(فشل_عدد) + " فشل")
    ارجع فشل_عدد = 0
