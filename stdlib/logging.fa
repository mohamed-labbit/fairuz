# تسجيل منظم متعدد المعالجات، مكتوب بفيروز.

من datetime استورد الان_UTC
من json استورد JSON_رمز
من dicts استورد قاموس_ادمج
من file استورد اضف_نص_ملف

مستوى_تتبع := 10
مستوى_تصحيح := 20
مستوى_معلومة := 30
مستوى_تحذير := 40
مستوى_خطا := 50
مستوى_حرج := 60

دالة اسم_مستوى(المستوى):
    اذا المستوى >= مستوى_حرج:
        ارجع "حرج"
    اذا المستوى >= مستوى_خطا:
        ارجع "خطأ"
    اذا المستوى >= مستوى_تحذير:
        ارجع "تحذير"
    اذا المستوى >= مستوى_معلومة:
        ارجع "معلومة"
    اذا المستوى >= مستوى_تصحيح:
        ارجع "تصحيح"
    ارجع "تتبع"

نوع سجل_حدث:
    دالة بداية(المسجل، المستوى، الرسالة، السياق):
        هذا.الوقت := الان_UTC().ISO()
        هذا.المسجل := المسجل
        هذا.المستوى := المستوى
        هذا.اسم_المستوى := اسم_مستوى(المستوى)
        هذا.الرسالة := سلسلة(الرسالة)
        هذا.السياق := السياق

    دالة قاموس():
        ارجع قاموس(
            "time"، هذا.الوقت،
            "logger"، هذا.المسجل،
            "level"، هذا.اسم_المستوى،
            "message"، هذا.الرسالة،
            "context"، هذا.السياق
        )

    دالة نص():
        ارجع هذا.الوقت + " [" + هذا.اسم_المستوى + "] " + هذا.المسجل + ": " + هذا.الرسالة

نوع معالج_طرفية:
    دالة بداية(منظم_JSON):
        هذا.منظم_JSON := منظم_JSON

    دالة اكتب(السجل):
        اذا هذا.منظم_JSON:
            اكتب(JSON_رمز(السجل.قاموس()))
        غيره:
            اكتب(السجل.نص())

نوع معالج_ملف:
    دالة بداية(المسار، منظم_JSON):
        هذا.المسار := المسار
        هذا.منظم_JSON := منظم_JSON

    دالة اكتب(السجل):
        النص := السجل.نص()
        اذا هذا.منظم_JSON:
            النص := JSON_رمز(السجل.قاموس())
        ارجع اضف_نص_ملف(هذا.المسار، النص + "\n")

نوع مسجل:
    دالة بداية(الاسم، المستوى):
        هذا.الاسم := الاسم
        هذا.المستوى := المستوى
        هذا.المعالجات := قائمة()
        هذا.السياق := قاموس()

    دالة اضف_معالج(المعالج):
        اضف(هذا.المعالجات، المعالج)
        ارجع هذا

    دالة مع_سياق(السياق):
        هذا.السياق := قاموس_ادمج(هذا.السياق، السياق)
        ارجع هذا

    دالة سجل(المستوى، الرسالة، السياق):
        اذا المستوى < هذا.المستوى:
            ارجع خطا
        الحدث := سجل_حدث(هذا.الاسم، المستوى، الرسالة، قاموس_ادمج(هذا.السياق، السياق))
        لكل معالج في هذا.المعالجات:
            معالج.اكتب(الحدث)
        ارجع صحيح

    دالة تتبع(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_تتبع، الرسالة، السياق)

    دالة تصحيح(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_تصحيح، الرسالة، السياق)

    دالة معلومة(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_معلومة، الرسالة، السياق)

    دالة تحذير(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_تحذير، الرسالة، السياق)

    دالة سجل_خطا(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_خطا، الرسالة، السياق)

    دالة حرج(الرسالة، السياق):
        ارجع هذا.سجل(مستوى_حرج، الرسالة، السياق)

دالة مسجل_طرفية(الاسم، المستوى):
    ارجع مسجل(الاسم، المستوى).اضف_معالج(معالج_طرفية(خطا))
