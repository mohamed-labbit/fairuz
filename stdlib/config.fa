# قارئ/كاتب INI عالي المستوى، يحافظ على الأقسام والقيم النصية.

من strings استورد اسطر
من strings استورد يبدا_ب
من strings استورد ينتهي_ب
من strings استورد افصل_مرة
من dicts استورد قاموس_ضع_ان_غاب
من dicts استورد قاموس_مفاتيح
من dicts استورد قاموس_خذ
من file استورد اقرا_نص_ملف
من result استورد نجاح
من result استورد فشل

نوع اعدادات_INI:
    دالة بداية():
        هذا.الاقسام := قاموس("default"، قاموس())

    دالة حلل(النص):
        القسم := "default"
        لكل سطر في اسطر(النص):
            سطر := قص(سطر)
            اذا طول(سطر) > 0 و ليس يبدا_ب(سطر، "#") و ليس يبدا_ب(سطر، ";"):
                اذا يبدا_ب(سطر، "[") و ينتهي_ب(سطر، "]"):
                    القسم := قص(جزء(سطر، 1، طول(سطر) - 1))
                    قاموس_ضع_ان_غاب(هذا.الاقسام، القسم، قاموس())
                غيره:
                    زوج := افصل_مرة(سطر، "=")
                    اذا زوج[1] = "":
                        زوج := افصل_مرة(سطر، ":")
                    اذا زوج[1] = "":
                        عطل("سطر إعداد غير صالح: " + سطر)
                    هذا.الاقسام[القسم][قص(زوج[0])] := قص(زوج[2])
        ارجع هذا

    دالة اقسام():
        ارجع قاموس_مفاتيح(هذا.الاقسام)

    دالة خذ(القسم، المفتاح، البديل):
        اذا ليس __قاموس_يحتوي(هذا.الاقسام، القسم):
            ارجع البديل
        اذا __قاموس_يحتوي(هذا.الاقسام[القسم]، المفتاح):
            ارجع هذا.الاقسام[القسم][المفتاح]
        ارجع قاموس_خذ(هذا.الاقسام["default"]، المفتاح، البديل)

    دالة ضع(القسم، المفتاح، القيمة):
        قاموس_ضع_ان_غاب(هذا.الاقسام، القسم، قاموس())
        هذا.الاقسام[القسم][المفتاح] := سلسلة(القيمة)
        ارجع هذا

    دالة نص():
        الاسطر := قائمة()
        لكل قسم في قاموس_مفاتيح(هذا.الاقسام):
            اذا قسم != "default":
                اضف(الاسطر، "[" + قسم + "]")
            لكل مفتاح في قاموس_مفاتيح(هذا.الاقسام[قسم]):
                اضف(الاسطر، مفتاح + " = " + هذا.الاقسام[قسم][مفتاح])
            اضف(الاسطر، "")
        ارجع اجمع(الاسطر، "\n")

دالة اقرا_INI(المسار):
    النص := اقرا_نص_ملف(المسار)
    اذا النص = عدم:
        ارجع فشل("تعذر قراءة ملف الإعدادات")
    ارجع نجاح(اعدادات_INI().حلل(النص))
