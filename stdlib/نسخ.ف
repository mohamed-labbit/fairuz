# النسخ السطحي والعميق؛ لا تُنسخ الموارد والدوال والكائنات غير الحاوية.

من مجموعات استورد انسخ_قائمة، ابحث
من قواميس استورد قاموس_انسخ، قاموس_مفاتيح

دالة نسخ_سطحي(القيمة):
    اذا صنف(القيمة) = "قائمة":
        ارجع انسخ_قائمة(القيمة)
    اذا صنف(القيمة) = "قاموس":
        ارجع قاموس_انسخ(القيمة)
    ارجع القيمة

دالة __نسخ_عميق__(القيمة، المصادر، النسخ):
    النوع := صنف(القيمة)
    اذا النوع != "قائمة" و النوع != "قاموس":
        ارجع القيمة

    الموجود := 0
    طالما الموجود < طول(المصادر):
        اذا __نفس_الكائن__(المصادر[الموجود]، القيمة):
            ارجع النسخ[الموجود]
        الموجود += 1

    اذا النوع = "قائمة":
        الناتج := قائمة()
        اضف(المصادر، القيمة)
        اضف(النسخ، الناتج)
        لكل عنصر في القيمة:
            اضف(الناتج، __نسخ_عميق__(عنصر، المصادر، النسخ))
        ارجع الناتج

    الناتج := قاموس()
    اضف(المصادر، القيمة)
    اضف(النسخ، الناتج)
    لكل مفتاح في قاموس_مفاتيح(القيمة):
        المفتاح_الجديد := __نسخ_عميق__(مفتاح، المصادر، النسخ)
        الناتج[المفتاح_الجديد] := __نسخ_عميق__(القيمة[مفتاح]، المصادر، النسخ)
    ارجع الناتج

دالة نسخ_عميق(القيمة):
    ارجع __نسخ_عميق__(القيمة، قائمة()، قائمة())
