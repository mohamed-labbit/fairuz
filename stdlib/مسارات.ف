# بدائيات نظام مطلوبة:

من سلاسل استورد ينتهي_ب، ازل_سابقة
من ملفات استورد اقرا_نص_ملف، اكتب_نص_ملف، اضف_نص_ملف
# __مسار_فاصل()، __مسار_مطلق(مسار)، __مسار_طبع(مسار)
# __مسار_موجود(مسار)، __مسار_ملف(مسار)، __مسار_مجلد(مسار)
# __مسار_انشئ_مجلد(مسار)، __مسار_قائمة(مسار)، __مسار_احذف(مسار)
# __مسار_اسم، __مسار_اصل، __مسار_لاحقة، __مسار_لاحقات
# __مسار_اقرا_رابط، __مسار_رمزي، __مسار_معلومات، __مسار_اعادة_تسمية

دالة نص_مسار(القيمة):
    اذا صنف(القيمة) = "مسار":
        ارجع القيمة.نص()
    ارجع سلسلة(القيمة)

دالة انضم_مسار(الاجزاء):
    اذا طول(الاجزاء) = 0:
        ارجع ""
    الفاصل := __مسار_فاصل__()
    الناتج := سلسلة(الاجزاء[0])
    فهرس := 1
    طالما فهرس < طول(الاجزاء):
        الجزء := سلسلة(الاجزاء[فهرس])
        اذا ليس ينتهي_ب(الناتج، الفاصل):
            الناتج += الفاصل
        الناتج += ازل_سابقة(الجزء، الفاصل)
        فهرس += 1
    ارجع الناتج

نوع مسار:
    دالة بداية(القيمة):
        هذا.القيمة := سلسلة(القيمة)

    دالة نص():
        ارجع هذا.القيمة

    دالة مطلق():
        ارجع مسار(__مسار_مطلق__(هذا.القيمة))

    دالة طبيعي():
        ارجع مسار(__مسار_طبع__(هذا.القيمة))

    دالة موجود():
        ارجع __مسار_موجود__(هذا.القيمة)

    دالة ملف():
        ارجع __مسار_ملف__(هذا.القيمة)

    دالة مجلد():
        ارجع __مسار_مجلد__(هذا.القيمة)

    دالة ابن(الاسم):
        ارجع مسار(انضم_مسار([هذا.القيمة، الاسم]))

    دالة الاسم():
        ارجع __مسار_اسم__(هذا.القيمة)

    دالة الاصل():
        ارجع مسار(__مسار_اصل__(هذا.القيمة))

    دالة اللاحقة():
        ارجع __مسار_لاحقة__(هذا.القيمة)

    دالة اللواحق():
        ارجع __مسار_لاحقات__(هذا.القيمة)

    دالة انشئ_مجلد():
        ارجع __مسار_انشئ_مجلد__(هذا.القيمة)

    دالة قائمة():
        الناتج := قائمة()
        لكل اسم في __مسار_قائمة__(هذا.القيمة):
            اضف(الناتج، هذا.ابن(اسم))
        ارجع الناتج

    دالة رمزي():
        ارجع __مسار_رمزي__(هذا.القيمة)

    دالة اقرا_رابط():
        ارجع مسار(__مسار_اقرا_رابط__(هذا.القيمة))

    دالة معلومات():
        ارجع __مسار_معلومات__(هذا.القيمة)

    دالة اعد_تسمية(الوجهة):
        الوجهة := نص_مسار(الوجهة)
        نجح := __مسار_اعادة_تسمية__(هذا.القيمة، الوجهة)
        اذا نجح:
            هذا.القيمة := الوجهة
        ارجع نجح

    دالة احذف():
        ارجع __مسار_احذف__(هذا.القيمة)

    دالة اقرا_نص():
        ارجع اقرا_نص_ملف(هذا.القيمة)

    دالة اكتب_نص(النص):
        ارجع اكتب_نص_ملف(هذا.القيمة، النص)

    دالة اضف_نص(النص):
        ارجع اضف_نص_ملف(هذا.القيمة، النص)

دالة مجلد_حالي():
    ارجع مسار(__مسار_مجلد_حالي__())

دالة مجلد_مؤقت():
    ارجع مسار(__مسار_مجلد_مؤقت__())

دالة مجلد_منزل():
    ارجع مسار(__مسار_مجلد_منزل__())
