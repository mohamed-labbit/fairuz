# سياسات رياضية بسيطة مكتوبة بفيروز؛ الدوال التي تستدعي libm تبقى أصلية.

دالة اشارة(القيمة):
    اذا القيمة > 0:
        ارجع 1
    اذا القيمة < 0:
        ارجع -1
    ارجع 0

دالة احصر(القيمة، الادنى، الاعلى):
    اذا الادنى > الاعلى:
        عطل("الحد الأدنى أكبر من الحد الأعلى")
    اذا القيمة < الادنى:
        ارجع الادنى
    اذا القيمة > الاعلى:
        ارجع الاعلى
    ارجع القيمة

دالة بين(القيمة، الادنى، الاعلى):
    ارجع القيمة >= الادنى و القيمة <= الاعلى

دالة قاسم_مشترك(الاول، الثاني):
    ا := مطلق(الاول)
    ب := مطلق(الثاني)
    طالما ب != 0:
        باقي := ا % ب
        ا := ب
        ب := باقي
    ارجع ا

دالة مضاعف_مشترك(الاول، الثاني):
    اذا الاول = 0 او الثاني = 0:
        ارجع 0
    ارجع مطلق((الاول / قاسم_مشترك(الاول، الثاني)) * الثاني)

دالة عاملي(العدد):
    اذا العدد < 0:
        عطل("العاملي غير معرّف للأعداد السالبة")
    الناتج := 1
    الحالي := 2
    طالما الحالي <= العدد:
        الناتج *= الحالي
        الحالي += 1
    ارجع الناتج

دالة فيبوناتشي(العدد):
    اذا العدد < 0:
        عطل("فيبوناتشي غير معرّف للأعداد السالبة")
    السابق := 0
    الحالي := 1
    فهرس := 0
    طالما فهرس < العدد:
        التالي := السابق + الحالي
        السابق := الحالي
        الحالي := التالي
        فهرس += 1
    ارجع السابق

دالة قوة_صحيحة(الاساس، الاس):
    اذا الاس < 0:
        ارجع قوة(الاساس، الاس)
    الناتج := 1
    القاعدة := الاساس
    الباقي := الاس
    طالما الباقي > 0:
        اذا الباقي % 2 = 1:
            الناتج *= القاعدة
        القاعدة *= القاعدة
        الباقي := ادنى(الباقي / 2)
    ارجع الناتج

دالة اولي(العدد):
    اذا العدد < 2:
        ارجع خطا
    اذا العدد = 2:
        ارجع صحيح
    اذا العدد % 2 = 0:
        ارجع خطا
    القاسم := 3
    طالما القاسم * القاسم <= العدد:
        اذا العدد % القاسم = 0:
            ارجع خطا
        القاسم += 2
    ارجع صحيح

دالة قرب(الاول، الثاني، السماح):
    ارجع مطلق(الاول - الثاني) <= السماح

دالة درجات_الى_راديان(الدرجات):
    ارجع الدرجات * 3.141592653589793 / 180

دالة راديان_الى_درجات(الراديان):
    ارجع الراديان * 180 / 3.141592653589793

دالة جيب(القيمة):
    ارجع __رياضيات("sin"، القيمة)

دالة جيب_تمام(القيمة):
    ارجع __رياضيات("cos"، القيمة)

دالة ظل(القيمة):
    ارجع __رياضيات("tan"، القيمة)

دالة لوغاريتم(القيمة، الاساس):
    اذا القيمة <= 0 او الاساس <= 0 او الاساس = 1:
        عطل("مجال اللوغاريتم غير صالح")
    ارجع __رياضيات("log"، القيمة) / __رياضيات("log"، الاساس)

دالة اسي(القيمة):
    ارجع __رياضيات("exp"، القيمة)

دالة وتر(الاول، الثاني):
    ارجع __رياضيات2("hypot"، الاول، الثاني)

دالة زاوية(الصادي، السيني):
    ارجع __رياضيات2("atan2"، الصادي، السيني)

دالة ليس_رقما(القيمة):
    ارجع __عدد_ليس_رقما(القيمة)

دالة منته(القيمة):
    ارجع __عدد_منته(القيمة)
