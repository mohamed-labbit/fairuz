# ترميز JSON عالي المستوى. البدائيات الثلاث تتعامل مع تفاصيل Unicode/الأعداد:

من collections استورد ابحث
من dicts استورد قاموس_مفاتيح
من strings استورد هل_مسافة
# __JSON_اهرب(نص)، __JSON_اقرا_سلسلة(نص، موضع)، __عدد_من_نص(نص)
# __عدد_منته(عدد) يرفض NaN وInfinity لأنهما خارج معيار JSON.

دالة __JSON_رمز_اقتباس():
    ارجع __نص_من_رمز(34)

دالة __JSON_رمز(القيمة، النشط):
    النوع := صنف(القيمة)
    اذا النوع = "عدم":
        ارجع "null"
    اذا النوع = "منطقي":
        اذا القيمة:
            ارجع "true"
        ارجع "false"
    اذا النوع = "طبيعي" او النوع = "حقيقي":
        اذا ليس __عدد_منته(القيمة):
            عطل("JSON لا يقبل NaN أو Infinity")
        ارجع سلسلة(القيمة)
    اذا النوع = "سلسلة":
        اقتباس := __JSON_رمز_اقتباس()
        ارجع اقتباس + __JSON_اهرب(القيمة) + اقتباس
    اذا النوع = "قائمة":
        اذا ابحث(النشط، القيمة) != -1:
            عطل("لا يمكن ترميز بنية دورية إلى JSON")
        اضف(النشط، القيمة)
        الاجزاء := قائمة()
        لكل عنصر في القيمة:
            اضف(الاجزاء، __JSON_رمز(عنصر، النشط))
        احذف(النشط)
        ارجع "[" + اجمع(الاجزاء، ",") + "]"
    اذا النوع = "قاموس":
        اذا ابحث(النشط، القيمة) != -1:
            عطل("لا يمكن ترميز بنية دورية إلى JSON")
        اضف(النشط، القيمة)
        الاجزاء := قائمة()
        اقتباس := __JSON_رمز_اقتباس()
        لكل مفتاح في قاموس_مفاتيح(القيمة):
            اذا صنف(مفتاح) != "سلسلة":
                عطل("مفاتيح JSON يجب أن تكون سلاسل")
            النص := اقتباس + __JSON_اهرب(مفتاح) + اقتباس
            اضف(الاجزاء، النص + ":" + __JSON_رمز(القيمة[مفتاح]، النشط))
        احذف(النشط)
        ارجع "{" + اجمع(الاجزاء، ",") + "}"
    عطل("نوع غير قابل للترميز إلى JSON: " + النوع)

دالة JSON_رمز(القيمة):
    ارجع __JSON_رمز(القيمة، قائمة())

نوع محلل_JSON:
    دالة بداية(النص):
        هذا.النص := النص
        هذا.الموضع := 0

    دالة تخط_مسافات():
        طالما هذا.الموضع < طول(هذا.النص) و هل_مسافة(جزء(هذا.النص، هذا.الموضع، هذا.الموضع + 1)):
            هذا.الموضع += 1

    دالة الحالي():
        اذا هذا.الموضع >= طول(هذا.النص):
            ارجع ""
        ارجع جزء(هذا.النص، هذا.الموضع، هذا.الموضع + 1)

    دالة توقع(الحرف):
        اذا هذا.الحالي() != الحرف:
            عطل("JSON غير صالح عند الموضع " + سلسلة(هذا.الموضع))
        هذا.الموضع += 1

    دالة اقرا_سلسلة():
        النتيجة := __JSON_اقرا_سلسلة(هذا.النص، هذا.الموضع)
        اذا النتيجة = عدم:
            عطل("سلسلة JSON غير صالحة")
        هذا.الموضع := النتيجة[1]
        ارجع النتيجة[0]

    دالة اقرا_عدد():
        البداية := هذا.الموضع
        المحارف := "-+0123456789.eE"
        طالما هذا.الموضع < طول(هذا.النص) و يحتوي(المحارف، هذا.الحالي()):
            هذا.الموضع += 1
        النص := جزء(هذا.النص، البداية، هذا.الموضع)
        القيمة := __عدد_من_نص(النص)
        اذا القيمة = عدم:
            عطل("عدد JSON غير صالح: " + النص)
        ارجع القيمة

    دالة اقرا_قائمة():
        هذا.توقع("[")
        هذا.تخط_مسافات()
        الناتج := قائمة()
        اذا هذا.الحالي() = "]":
            هذا.الموضع += 1
            ارجع الناتج
        طالما صحيح:
            اضف(الناتج، هذا.اقرا_قيمة())
            هذا.تخط_مسافات()
            اذا هذا.الحالي() = "]":
                هذا.الموضع += 1
                ارجع الناتج
            هذا.توقع(",")
            هذا.تخط_مسافات()

    دالة اقرا_قاموس():
        هذا.توقع("{")
        هذا.تخط_مسافات()
        الناتج := قاموس()
        اذا هذا.الحالي() = "}":
            هذا.الموضع += 1
            ارجع الناتج
        طالما صحيح:
            اذا هذا.الحالي() != __JSON_رمز_اقتباس():
                عطل("مفتاح JSON يجب أن يكون سلسلة")
            المفتاح := هذا.اقرا_سلسلة()
            هذا.تخط_مسافات()
            هذا.توقع(":")
            هذا.تخط_مسافات()
            الناتج[المفتاح] := هذا.اقرا_قيمة()
            هذا.تخط_مسافات()
            اذا هذا.الحالي() = "}":
                هذا.الموضع += 1
                ارجع الناتج
            هذا.توقع(",")
            هذا.تخط_مسافات()

    دالة اقرا_قيمة():
        هذا.تخط_مسافات()
        الحرف := هذا.الحالي()
        اذا الحرف = __JSON_رمز_اقتباس():
            ارجع هذا.اقرا_سلسلة()
        اذا الحرف = "[":
            ارجع هذا.اقرا_قائمة()
        اذا الحرف = "{":
            ارجع هذا.اقرا_قاموس()
        اذا جزء(هذا.النص، هذا.الموضع، هذا.الموضع + 4) = "true":
            هذا.الموضع += 4
            ارجع صحيح
        اذا جزء(هذا.النص، هذا.الموضع، هذا.الموضع + 5) = "false":
            هذا.الموضع += 5
            ارجع خطا
        اذا جزء(هذا.النص، هذا.الموضع، هذا.الموضع + 4) = "null":
            هذا.الموضع += 4
            ارجع عدم
        ارجع هذا.اقرا_عدد()

    دالة حلل():
        القيمة := هذا.اقرا_قيمة()
        هذا.تخط_مسافات()
        اذا هذا.الموضع != طول(هذا.النص):
            عطل("بيانات زائدة بعد قيمة JSON")
        ارجع القيمة

دالة JSON_حلل(النص):
    ارجع محلل_JSON(النص).حلل()
