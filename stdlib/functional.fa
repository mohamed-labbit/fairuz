# أدوات دوال لا تتطلب إغلاقات أو دعماً أصلياً إضافياً.

من collections استورد ادمج_قوائم
من data_structures استورد ذاكرة_LRU
من json استورد JSON_رمز

دالة هوية(القيمة):
    ارجع القيمة

دالة طبق(الدالة، القيمة):
    ارجع الدالة(القيمة)

دالة طبق2(الدالة، الاول، الثاني):
    ارجع الدالة(الاول، الثاني)

دالة كرر_فعل(العدد، الدالة):
    فهرس := 0
    طالما فهرس < العدد:
        الدالة(فهرس)
        فهرس += 1

دالة لكل_عنصر(القيم، الدالة):
    لكل قيمة في القيم:
        الدالة(قيمة)

دالة حتى(الشرط، الفعل):
    طالما ليس الشرط():
        الفعل()

نوع دالة_جزئية:
    دالة بداية(الدالة، الثوابت):
        هذا.الدالة := الدالة
        هذا.الثوابت := الثوابت

    دالة نداء(الوسائط):
        ارجع __استدعاء(هذا.الدالة، ادمج_قوائم(هذا.الثوابت، الوسائط))

دالة جزئي(الدالة، الثوابت):
    ارجع دالة_جزئية(الدالة، الثوابت)

نوع دالة_مركبة:
    دالة بداية(الدوال):
        هذا.الدوال := الدوال

    دالة نداء(القيمة):
        الناتج := القيمة
        فهرس := طول(هذا.الدوال) - 1
        طالما فهرس >= 0:
            الناتج := هذا.الدوال[فهرس](الناتج)
            فهرس -= 1
        ارجع الناتج

دالة ركب_دوال(الدوال):
    ارجع دالة_مركبة(الدوال)

نوع دالة_محفوظة:
    دالة بداية(الدالة، السعة):
        هذا.الدالة := الدالة
        هذا.الذاكرة := ذاكرة_LRU(السعة)

    دالة نداء(الوسائط):
        المفتاح := JSON_رمز(الوسائط)
        الموجود := هذا.الذاكرة.خذ(المفتاح)
        اذا الموجود.له_قيمة():
            ارجع الموجود.افتح()
        القيمة := __استدعاء(هذا.الدالة، الوسائط)
        هذا.الذاكرة.ضع(المفتاح، القيمة)
        ارجع القيمة

دالة احفظ(الدالة، السعة):
    ارجع دالة_محفوظة(الدالة، السعة)
